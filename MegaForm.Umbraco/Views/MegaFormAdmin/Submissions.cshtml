@{
    Layout = null;
    int formId = ViewBag.FormId ?? 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MegaForm Submissions — Umbraco</title>
    <link rel="stylesheet" href="/App_Plugins/MegaForm/css/megaform-admin-shell.css?v=@MegaForm.Umbraco.Services.MegaFormAssetVersion.Value" />
    <link rel="stylesheet" href="/App_Plugins/MegaForm/css/megaform-submissions-ts.css?v=@MegaForm.Umbraco.Services.MegaFormAssetVersion.Value" />
    <link rel="stylesheet" href="/App_Plugins/MegaForm/css/megaform-umbraco-admin.css?v=@MegaForm.Umbraco.Services.MegaFormAssetVersion.Value" />
    <style>
        html, body { margin: 0; padding: 0; height: 100%; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f8fafc; }
    </style>
</head>
<body style="margin:0;padding:0;">
    <div id="mf-submissions-root"
         data-platform="umbraco"
         data-api-base="/umbraco/MegaForm/MegaFormApi/"
         data-assets-base="/App_Plugins/MegaForm/"
         data-form-id="@formId"
         data-shell-mode="admin"
         data-mf-locale="en-US">
        <div style="display:flex;align-items:center;justify-content:center;height:100vh;color:#64748b;font-family:system-ui,sans-serif;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:10px;animation:spin 1s linear infinite;">
                <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
            </svg>
            Loading MegaForm Submissions…
        </div>
    </div>

    <style>
        @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    </style>

    <script>
        window.__MF_TOKEN = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MegaFormAccessToken as string ?? ""));
    </script>
    <script src="/App_Plugins/MegaForm/js/megaform-umbraco-host.js?v=@MegaForm.Umbraco.Services.MegaFormAssetVersion.Value"></script>
    <script src="/App_Plugins/MegaForm/js/megaform-submissions.js?v=@MegaForm.Umbraco.Services.MegaFormAssetVersion.Value"></script>
</body>
</html>
