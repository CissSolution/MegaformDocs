@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MegaForm Dashboard — Umbraco</title>
    <link rel="stylesheet" href="/App_Plugins/MegaForm/css/megaform-admin-shell.css" />
    <style>
        html, body { margin: 0; padding: 0; height: 100%; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f8fafc; }
    </style>
</head>
<body style="margin:0;padding:0;">
    <div id="mf-dashboard-root"
         data-enhance-nav="false"
         data-platform="umbraco"
         data-site-id="-1"
         data-module-id="0"
         data-api-base="/umbraco/MegaForm/MegaFormApi/"
         data-assets-base="/App_Plugins/MegaForm/"
         data-dashboard-url="/umbraco/MegaForm/Admin"
         data-builder-url="/umbraco/MegaForm/Builder"
         data-submissions-url="/umbraco/MegaForm/Submissions"
         data-languages-url="/umbraco/MegaForm/Languages"
         data-myinbox-url="/umbraco/MegaForm/Submissions"
         data-logout-url="/umbraco"
         data-return-url="/umbraco"
         data-mf-locale="en-US">
        <div style="display:flex;align-items:center;justify-content:center;height:100vh;color:#64748b;font-family:system-ui,sans-serif;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:10px;animation:spin 1s linear infinite;">
                <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
            </svg>
            Loading MegaForm Dashboard…
        </div>
    </div>

    <style>
        @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    </style>

    <script src="/App_Plugins/MegaForm/js/megaform-umbraco-host.js"></script>
    <script>
        (function () {
            var root = document.getElementById('mf-dashboard-root');
            if (!root) return;

            function mount() {
                if (root.dataset.booted === '1') return true;
                if (window.MegaForm && typeof window.MegaForm.initDashboard === 'function') {
                    try {
                        window.MegaForm.initDashboard(root);
                        root.dataset.booted = '1';
                    } catch (e) { console.error('[MegaForm] initDashboard failed', e); }
                    return true;
                }
                return false;
            }

            if (mount()) return;

            if (!document.querySelector('script[src*="megaform-dashboard.js"]')) {
                var s = document.createElement('script');
                s.src = '/App_Plugins/MegaForm/js/megaform-dashboard.js';
                s.onload = function () {
                    var attempts = 0;
                    var t = setInterval(function () {
                        if (mount() || ++attempts > 60) clearInterval(t);
                    }, 150);
                };
                document.head.appendChild(s);
            }

            var attempts = 0;
            var t = setInterval(function () {
                if (mount() || ++attempts > 60) clearInterval(t);
            }, 150);
        })();
    </script>
</body>
</html>
