@model MegaForm.Umbraco.ViewModels.MegaFormPublicFormViewModel
@{
    Layout = null;
    var isEmbed = Model.EmbedMode;
    var isPreview = Model.PreviewMode;
}
<!DOCTYPE html>
<html lang="@Model.Locale" data-mf-locale="@Model.Locale">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="@(isEmbed || isPreview ? "noindex" : "index,follow")"/>
    <title>@Model.Title</title>
    <meta name="description" content="@(string.IsNullOrWhiteSpace(Model.Description) ? "Fill out this form" : Model.Description)"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <link rel="stylesheet" href="/App_Plugins/MegaForm/css/megaform.css"/>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; font-family: 'DM Sans', sans-serif; background: @(isEmbed ? "transparent" : "#f1f5f9"); min-height: 100vh; }
        .mf-public-page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: @(isEmbed ? "0" : "40px 16px 80px"); }
        .mf-public-content { width: 100%; max-width: 960px; }
        .mf-preview-banner { position: fixed; top: 0; left: 0; right: 0; height: 40px; background: #f97316; color: #fff; font-size: 13px; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 8px; z-index: 9999; }
        .mf-preview-banner + .mf-public-page { padding-top: 60px; }
    </style>
</head>
<body data-mf-locale="@Model.Locale">
@if (isPreview)
{
    <div class="mf-preview-banner">
        <i class="fas fa-eye"></i>
        Preview Mode — this form is not yet published
    </div>
}
<div class="mf-public-page">
    <div class="mf-public-content">
        <div id="mf-form-mount" data-member-prefill='@Model.MemberPrefillJson.Replace("'", "&#39;")'></div>
    </div>
</div>

<script src="/App_Plugins/MegaForm/js/megaform-config.js"></script>
<script src="/App_Plugins/MegaForm/js/megaform-renderer.js"></script>
<script src="/App_Plugins/MegaForm/js/megaform-widgets.js"></script>
<script>
(function () {
    var mount = document.getElementById('mf-form-mount');
    var apiBase = '@Model.ApiBase';
    fetch(apiBase + 'schema?formId=@Model.FormId')
        .then(function (r) { return r.ok ? r.json() : Promise.reject(r.statusText); })
        .then(function (payload) {
            if (!payload || !payload.schema) {
                mount.innerHTML = '<p style="padding:1rem;color:#dc2626;">Unable to load form schema.</p>';
                return;
            }
            var schema = typeof payload.schema === 'string' ? JSON.parse(payload.schema) : payload.schema;
            window.MegaFormRenderer.init({
                container: mount,
                formId: @Model.FormId,
                apiBaseUrl: apiBase,
                schema: schema,
                title: payload.title || '',
                description: payload.description || '',
                submitButtonText: payload.submitButtonText || 'Submit',
                locale: '@Model.Locale'
            });
            applyMemberPrefill(mount);
        })
        .catch(function (e) {
            console.error('[MegaForm.Umbraco] Failed to load form schema', e);
            mount.innerHTML = '<p style="padding:1rem;color:#dc2626;">Error loading form. Please try again later.</p>';
        });

    function applyMemberPrefill(container) {
        var raw = container.getAttribute('data-member-prefill');
        if (!raw || raw === '{}') return;
        var values = {};
        try { values = JSON.parse(raw); } catch (e) { return; }

        // Give the renderer a tick to render the fields.
        setTimeout(function () {
            for (var key in values) {
                if (!values.hasOwnProperty(key)) continue;
                var value = values[key];
                var selector = 'input[name="' + key + '"], select[name="' + key + '"], textarea[name="' + key + '"]';
                var el = container.querySelector(selector);
                if (!el) {
                    el = container.querySelector('[data-field-key="' + key + '"] input, [data-field-key="' + key + '"] select, [data-field-key="' + key + '"] textarea');
                }
                if (!el) continue;
                if (el.type === 'checkbox' || el.type === 'radio') {
                    el.checked = String(value).toLowerCase() === 'true' || String(value) === el.value;
                } else if (el.tagName === 'SELECT') {
                    el.value = String(value);
                } else {
                    el.value = value;
                }
            }
        }, 100);
    }
})();
</script>
</body>
</html>
