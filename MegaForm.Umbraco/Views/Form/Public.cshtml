@model MegaForm.Umbraco.ViewModels.MegaFormPublicFormViewModel
@using Newtonsoft.Json
@{
    Layout = null;
    var containerId = $"mf-public-{Model.FormId}";
}
<!DOCTYPE html>
<html lang="@Model.Locale">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title</title>
    @if (Model.PreviewMode)
    {
        <style>
            .mf-preview-banner { background:#f59e0b;color:#fff;text-align:center;padding:.5rem;font-family:system-ui,sans-serif;font-size:.875rem; }
            body { margin:0; }
        </style>
    }
    @if (Model.EmbedMode)
    {
        <style>body { margin:0; }</style>
    }
</head>
<body>
    @if (Model.PreviewMode)
    {
        <div class="mf-preview-banner">Preview mode &mdash; this form is not published yet.</div>
    }

    @if (!Model.EmbedMode)
    {
        <div style="max-width:800px;margin:2rem auto;font-family:system-ui,sans-serif;">
            <h1>@Model.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p style="color:#64748b;">@Model.Description</p>
            }
        </div>
    }

    <div id="@containerId"
         class="megaform-root"
         data-platform="umbraco"
         data-instance-id="0"
         data-form-id="@Model.FormId"
         data-api-base="@Model.ApiBase"
         data-is-admin="false"
         data-view-type="submit"
         data-locale="@Model.Locale">
    </div>

    <link rel="stylesheet" href="/App_Plugins/MegaForm/css/megaform.css?v=@MegaForm.Umbraco.Services.MegaFormAssetVersion.Value" />
    <link rel="stylesheet" href="/App_Plugins/MegaForm/css/megaform-themes.css?v=@MegaForm.Umbraco.Services.MegaFormAssetVersion.Value" />
    <link rel="stylesheet" href="/App_Plugins/MegaForm/css/megaform-widgets.css?v=@MegaForm.Umbraco.Services.MegaFormAssetVersion.Value" />
    <script src="/App_Plugins/MegaForm/js/megaform-config.js?v=@MegaForm.Umbraco.Services.MegaFormAssetVersion.Value"></script>
    <script src="/App_Plugins/MegaForm/js/megaform-renderer.js?v=@MegaForm.Umbraco.Services.MegaFormAssetVersion.Value"></script>
    <script src="/App_Plugins/MegaForm/js/megaform-widgets.js?v=@MegaForm.Umbraco.Services.MegaFormAssetVersion.Value"></script>

    <script>
    (function () {
        var root = document.getElementById('@containerId');
        var formId = root.getAttribute('data-form-id');
        var apiBase = root.getAttribute('data-api-base') || '/umbraco/MegaForm/MegaFormApi/';
        if (!formId || formId === '0') {
            root.innerHTML = '<p style="padding:1rem;color:#dc2626;">Form is not configured.</p>';
            return;
        }
        if (!window.MegaFormRenderer || !window.MegaFormRenderer.init) {
            root.innerHTML = '<p style="padding:1rem;color:#dc2626;">MegaForm renderer not loaded.</p>';
            return;
        }
        fetch(apiBase + 'schema?formId=' + encodeURIComponent(formId))
            .then(function (r) { return r.ok ? r.json() : Promise.reject(r.statusText); })
            .then(function (payload) {
                if (!payload || !payload.schema) {
                    root.innerHTML = '<p style="padding:1rem;color:#dc2626;">Unable to load form schema.</p>';
                    return;
                }
                var schema = typeof payload.schema === 'string' ? JSON.parse(payload.schema) : payload.schema;
                window.MegaFormRenderer.init({
                    container: root,
                    formId: parseInt(formId, 10),
                    apiBaseUrl: apiBase,
                    schema: schema,
                    title: payload.title || '',
                    description: payload.description || '',
                    submitButtonText: payload.submitButtonText || 'Submit',
                    locale: document.documentElement.lang || 'en-US'
                });
            })
            .catch(function (e) {
                console.error('[MegaForm.Umbraco] Failed to load form schema', e);
                root.innerHTML = '<p style="padding:1rem;color:#dc2626;">Error loading form. Please try again later.</p>';
            });
    })();
    </script>
</body>
</html>
