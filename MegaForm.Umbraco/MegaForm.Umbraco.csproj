<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MegaForm.Umbraco</RootNamespace>
    <AssemblyName>MegaForm.Umbraco</AssemblyName>
    <Version>2.0.37</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>App_Plugins/MegaForm</StaticWebAssetBasePath>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>MegaForm.Umbraco</PackageId>
    <Authors>MegaForm Team</Authors>
    <Company>MegaForm</Company>
    <Product>MegaForm for Umbraco</Product>
    <Description>Purchase package for building forms and applications in Umbraco 17 LTS with multi-view rendering, submission management, workflows, and AI-assisted design.</Description>
    <Copyright>© 2026 MegaForm. All rights reserved.</Copyright>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/CissSolution/MegaformDocs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CissSolution/MegaformDocs.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>umbraco;umbraco-marketplace;form-builder;forms;workflow;submissions;bellissima;umbraco17</PackageTags>
    <PackageReleaseNotes>MegaForm 2.0.37 for Umbraco 17 LTS. Adds backoffice license.lic activation, bundles MegaForm Core, SDK, and cloud-storage runtime assemblies for one-package installation, restores runtime flags and core artwork, moves template-specific artwork to on-demand Gallery archives, removes duplicate catalogs and source maps, and adds clean-site installation QA.</PackageReleaseNotes>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Platform packages are the customer-facing installation unit. Keep the project
         references for development, but do not emit separate MegaForm NuGet dependencies. -->
    <ProjectReference Include="..\MegaForm.Core\MegaForm.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\MegaForm.Sdk\MegaForm.Sdk.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\MegaForm.Integrations.CloudStorage\MegaForm.Integrations.CloudStorage.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Umbraco 17 LTS (Bellissima) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <!-- Pin the tested Umbraco 17 LTS range. The upper bound excludes Umbraco 18. -->
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.6.1,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Core" Version="[17.6.1,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="[17.6.1,18.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Dependencies used by the bundled Core/SDK/CloudStorage assemblies. These are
         restored automatically when the single MegaForm.Umbraco package is installed. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packaged metadata files (at package root only, not as consumer content) -->
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="umbraco-marketplace.json" Pack="true" PackagePath="\" />
    <None Update="LICENSE.txt" Pack="true" PackagePath="\" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="umbraco-marketplace.json" />

    <!-- Runtime assets stay in the NuGet package. Template-specific artwork is installed
         on demand from the signed MegaForm Gallery asset archives. -->
    <Content Remove="wwwroot/App_Plugins/MegaForm/img/**/*" />
    <Content Include="wwwroot/App_Plugins/MegaForm/img/flags/**/*"
             Link="wwwroot/img/flags/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="wwwroot/App_Plugins/MegaForm/img/megaform-ai-bear.png"
             Link="wwwroot/img/megaform-ai-bear.png" />

    <!-- Production packages do not need source maps or duplicate locale catalogs. -->
    <Content Remove="wwwroot/**/*.map" />
    <Content Remove="wwwroot/js/bundles/i18n/**" />
    <Content Remove="wwwroot/js/builder/i18n/**" />
    <Content Remove="wwwroot/js/plugins/i18n/**" />

    <!-- Core, SDK, and cloud storage are implementation assemblies of the Umbraco
         product. Ship them beside MegaForm.Umbraco.dll so customers install one
         MegaForm package and never need unpublished internal packages. -->
    <None Include="$(OutputPath)MegaForm.Core.dll"
          Pack="true"
          PackagePath="lib/$(TargetFramework)/"
          Visible="false" />
    <None Include="$(OutputPath)MegaForm.Sdk.dll"
          Pack="true"
          PackagePath="lib/$(TargetFramework)/"
          Visible="false" />
    <None Include="$(OutputPath)MegaForm.Integrations.CloudStorage.dll"
          Pack="true"
          PackagePath="lib/$(TargetFramework)/"
          Visible="false" />
  </ItemGroup>

</Project>
