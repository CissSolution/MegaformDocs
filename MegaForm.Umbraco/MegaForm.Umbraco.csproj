<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- One customer package carries one assembly per supported .NET generation:
         Umbraco 13-14 use .NET 8, 15-16 use .NET 9, and 17-18 use .NET 10. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>MegaForm.Umbraco</RootNamespace>
    <AssemblyName>MegaForm.Umbraco</AssemblyName>
    <Version>2.0.62</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>App_Plugins/MegaForm</StaticWebAssetBasePath>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>MegaForm.Umbraco</PackageId>
    <Authors>MegaForm Team</Authors>
    <Company>MegaForm</Company>
    <Product>MegaForm for Umbraco</Product>
    <Description>Visual form and application builder for Umbraco 13-18 with 31 bundled templates, an Online Gallery with template previews, Google Gemini and Gemini Flash AI-assisted design, multilingual forms, payments, submissions, and multi-step workflows.</Description>
    <Copyright>© 2026 MegaForm. All rights reserved.</Copyright>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://cisssolution.github.io/MegaformDocs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CissSolution/MegaformDocs.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>umbraco;umbraco-marketplace;form-builder;forms;workflow;submissions;bellissima;umbraco13;umbraco14;umbraco15;umbraco16;umbraco17;umbraco18;templates;online-gallery;multilingual;wizard;ai;google-gemini;gemini-flash;payments</PackageTags>
    <PackageReleaseNotes>MegaForm 2.0.62 adds Google Gemini support, including Gemini Flash models that work well on the free Gemini API tier for most everyday form creation and editing tasks. It fixes Online Gallery template previews and Bellissima workspace routing, so Umbraco 14+ opens forms through the native form route instead of rendering a standalone builder inside the dashboard frame. This removes duplicate header bands and reserved padding on Umbraco 18 while preserving canvas anchoring, Umbraco 13 host context, and Workflow Summary fixes.</PackageReleaseNotes>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeMegaFormInternalAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <MegaFormUmbracoVersion Condition="'$(MegaFormUmbracoVersionOverride)' == ''">13.16.2</MegaFormUmbracoVersion>
    <MegaFormEfVersion>8.0.21</MegaFormEfVersion>
    <DefineConstants>$(DefineConstants);UMBRACO_13_14</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <MegaFormUmbracoVersion Condition="'$(MegaFormUmbracoVersionOverride)' == ''">15.4.4</MegaFormUmbracoVersion>
    <MegaFormEfVersion>9.0.10</MegaFormEfVersion>
    <DefineConstants>$(DefineConstants);UMBRACO_15_16</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <MegaFormUmbracoVersion Condition="'$(MegaFormUmbracoVersionOverride)' == ''">17.6.2</MegaFormUmbracoVersion>
    <MegaFormEfVersion>10.0.8</MegaFormEfVersion>
    <DefineConstants>$(DefineConstants);UMBRACO_17_18</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MegaFormUmbracoVersionOverride)' != ''">
    <MegaFormUmbracoVersion>$(MegaFormUmbracoVersionOverride)</MegaFormUmbracoVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Platform packages are the customer-facing installation unit. Keep the project
         references for development, but do not emit separate MegaForm NuGet dependencies. -->
    <ProjectReference Include="..\MegaForm.Core\MegaForm.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\MegaForm.Sdk\MegaForm.Sdk.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\MegaForm.Integrations.CloudStorage\MegaForm.Integrations.CloudStorage.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(MegaFormEfVersion)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="$(MegaFormUmbracoVersion)" />
    <PackageReference Include="Umbraco.Cms.Core" Version="$(MegaFormUmbracoVersion)" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="$(MegaFormUmbracoVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(MegaFormEfVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MegaFormEfVersion)" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Dependencies used by the bundled Core/SDK/CloudStorage assemblies. These are
         restored automatically when the single MegaForm.Umbraco package is installed. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <!-- Umbraco 15.4.4 resolves older vulnerable transitive versions. Keep the
         Umbraco API surface while raising only the affected dependency floors. -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packaged metadata files (at package root only, not as consumer content) -->
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="umbraco-marketplace.json" Pack="true" PackagePath="\" />
    <None Remove="LICENSE.txt" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="umbraco-marketplace.json" />
    <EmbeddedResource Include="Configuration\megaform-settings.json" />
    <!-- The same 31 free QuickStart templates shipped by DNN/Oqtane. Embedding them
         keeps first-run seeding reliable for NuGet/RCL installs, whose static web
         assets live in the global package cache rather than the site's wwwroot. -->
    <EmbeddedResource Include="..\Samples\FormTemplates\QuickStart\*.json"
                      Link="Resources\Templates\%(Filename)%(Extension)"
                      LogicalName="MegaForm.Umbraco.Resources.Templates.%(Filename)%(Extension)" />

    <!-- Runtime assets stay in the NuGet package. Template-specific artwork is installed
         on demand from the signed MegaForm Gallery asset archives. -->
    <Content Remove="wwwroot/App_Plugins/MegaForm/img/**/*" />
    <Content Include="wwwroot/App_Plugins/MegaForm/img/flags/**/*"
             Link="wwwroot/img/flags/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="wwwroot/App_Plugins/MegaForm/img/megaform-ai-bear.png"
             Link="wwwroot/img/megaform-ai-bear.png" />

    <!-- Production packages do not need source maps or duplicate locale catalogs. -->
    <Content Remove="wwwroot/**/*.map" />
    <Content Remove="wwwroot/js/bundles/i18n/**" />
    <Content Remove="wwwroot/js/builder/i18n/**" />
    <Content Remove="wwwroot/js/plugins/i18n/**" />

  </ItemGroup>

  <!-- Pack invokes this target once per TFM. BuildOutputInPackage automatically
       places each implementation assembly beside MegaForm.Umbraco.dll in the
       matching lib/netX.Y folder, keeping the customer install to one package. -->
  <Target Name="IncludeMegaFormInternalAssemblies">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)MegaForm.Core.dll" />
      <BuildOutputInPackage Include="$(OutputPath)MegaForm.Sdk.dll" />
      <BuildOutputInPackage Include="$(OutputPath)MegaForm.Integrations.CloudStorage.dll" />
    </ItemGroup>
  </Target>

</Project>
