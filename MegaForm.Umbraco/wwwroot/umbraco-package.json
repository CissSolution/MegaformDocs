{
  "$schema": "../../umbraco-package-schema.json",
  "id": "MegaForm.Umbraco",
  "name": "MegaForm",
  "version": "1.5.0",
  "allowTelemetry": true,
  "allowPublicAccess": true,
  "extensions": [
    {
      "type": "section",
      "alias": "MegaForm.Section",
      "name": "MegaForm",
      "meta": {
        "label": "MegaForm",
        "pathname": "megaform"
      }
    },
    {
      "type": "sectionSidebarApp",
      "kind": "menuWithEntityActions",
      "alias": "MegaForm.SectionSidebarApp",
      "name": "MegaForm Sidebar",
      "meta": {
        "label": "MegaForm",
        "menu": "MegaForm.Menu"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "MegaForm.Section"
        }
      ]
    },
    {
      "type": "menu",
      "alias": "MegaForm.Menu",
      "name": "MegaForm Menu"
    },
    {
      "type": "menuItem",
      "alias": "MegaForm.MenuItem.Sidebar",
      "name": "MegaForm Sidebar Menu Items",
      "element": "/App_Plugins/MegaForm/backoffice/section-sidebar/megaform-sidebar-menu.js",
      "elementName": "megaform-sidebar-menu",
      "meta": {
        "label": "MegaForm",
        "menus": ["MegaForm.Menu"]
      }
    },
    {
      "type": "dashboard",
      "alias": "MegaForm.Dashboard.Main",
      "name": "MegaForm Dashboard",
      "element": "/App_Plugins/MegaForm/backoffice/megaform-dashboard-view.js",
      "elementName": "megaform-dashboard-view",
      "weight": 10,
      "meta": {
        "label": "MegaForm Dashboard",
        "pathname": "megaform-dashboard"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "MegaForm.Section"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "MegaForm.SectionView.Dashboard",
      "name": "MegaForm Dashboard",
      "element": "/App_Plugins/MegaForm/backoffice/megaform-dashboard-view.js",
      "elementName": "megaform-dashboard-view",
      "meta": {
        "label": "Dashboard",
        "icon": "icon-home",
        "pathname": "dashboard"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "MegaForm.Section"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "MegaForm.SectionView.Builder",
      "name": "MegaForm Builder",
      "element": "/App_Plugins/MegaForm/backoffice/megaform-builder-view.js",
      "elementName": "megaform-builder-view",
      "meta": {
        "label": "Builder",
        "icon": "icon-edit",
        "pathname": "builder"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "MegaForm.Section"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "MegaForm.SectionView.Submissions",
      "name": "MegaForm Submissions",
      "element": "/App_Plugins/MegaForm/backoffice/megaform-submissions-view.js",
      "elementName": "megaform-submissions-view",
      "meta": {
        "label": "Submissions",
        "icon": "icon-inbox",
        "pathname": "submissions"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "MegaForm.Section"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "MegaForm.SectionView.Languages",
      "name": "MegaForm Languages",
      "element": "/App_Plugins/MegaForm/backoffice/megaform-languages-view.js",
      "elementName": "megaform-languages-view",
      "meta": {
        "label": "Languages",
        "icon": "icon-globe",
        "pathname": "languages"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "MegaForm.Section"
        }
      ]
    },
    {
      "type": "contentApp",
      "alias": "MegaForm.ContentApp.Submissions",
      "name": "MegaForm Submissions",
      "element": "/App_Plugins/MegaForm/backoffice/content-apps/megaform-submissions-app.js",
      "elementName": "megaform-submissions-app",
      "meta": {
        "label": "MegaForm",
        "icon": "icon-inbox",
        "weight": 20
      },
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.Document"
        }
      ]
    },
    {
      "type": "propertyEditorUi",
      "alias": "MegaForm.PropertyEditorUi.FormPicker",
      "name": "MegaForm Form Picker UI",
      "element": "/App_Plugins/MegaForm/backoffice/property-editors/megaform-form-picker.js",
      "elementName": "megaform-form-picker",
      "meta": {
        "label": "MegaForm Form Picker",
        "icon": "icon-umb-contour",
        "group": "pickers",
        "propertyEditorSchemaAlias": "MegaForm.FormPicker"
      }
    },
    {
      "type": "condition",
      "alias": "MegaForm.Condition.Permission",
      "name": "MegaForm Permission Condition",
      "api": "/App_Plugins/MegaForm/backoffice/conditions/megaform-permission-condition.js"
    },
    {
      "type": "modal",
      "alias": "MegaForm.Modal.FormPermissions",
      "name": "MegaForm Form Permissions Modal",
      "element": "/App_Plugins/MegaForm/backoffice/modals/megaform-form-permissions-modal.js",
      "elementName": "megaform-form-permissions-modal"
    },
    {
      "type": "entityAction",
      "kind": "default",
      "alias": "MegaForm.EntityAction.Form.Edit",
      "name": "MegaForm Edit Form",
      "api": "/App_Plugins/MegaForm/backoffice/entity-actions/megaform-form-edit-action.js",
      "forEntityTypes": ["megaForm.entity.form"],
      "meta": { "icon": "icon-edit", "label": "Edit" }
    },
    {
      "type": "entityAction",
      "kind": "default",
      "alias": "MegaForm.EntityAction.Form.Submissions",
      "name": "MegaForm Form Submissions",
      "api": "/App_Plugins/MegaForm/backoffice/entity-actions/megaform-form-submissions-action.js",
      "forEntityTypes": ["megaForm.entity.form"],
      "meta": { "icon": "icon-inbox", "label": "Submissions" }
    },
    {
      "type": "entityAction",
      "kind": "default",
      "alias": "MegaForm.EntityAction.Form.Workflow",
      "name": "MegaForm Form Workflow",
      "api": "/App_Plugins/MegaForm/backoffice/entity-actions/megaform-form-workflow-action.js",
      "forEntityTypes": ["megaForm.entity.form"],
      "meta": { "icon": "icon-wand", "label": "Workflow" }
    },
    {
      "type": "entityAction",
      "kind": "default",
      "alias": "MegaForm.EntityAction.Form.Delete",
      "name": "MegaForm Delete Form",
      "api": "/App_Plugins/MegaForm/backoffice/entity-actions/megaform-form-delete-action.js",
      "forEntityTypes": ["megaForm.entity.form"],
      "meta": { "icon": "icon-delete", "label": "Delete" }
    }
  ]
}
