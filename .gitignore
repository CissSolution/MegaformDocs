*.sql

# Claude workflow scratch
.claude-workflows/

# Local DB copies / dumps
*.db
*.db-copy

# Root-level scratch: temp files, one-off automation, QA snapshots
/_tmp_*
/tmp-*
/temp_*
/*.yml

# MegaForm.UI/tools = accumulated one-off i18n/key-extraction dumps (scratch, not build source).
# The real build scripts live in MegaForm.UI/scripts (build-entry.cjs / build-renderer.cjs).
MegaForm.UI/tools/

# Source maps (build artifacts)
*.map

# Synced/built asset copies in other host projects (built from Assets/ by BuildTS — duplicates)
MegaForm.Umbraco/wwwroot/js/
MegaForm.Umbraco/wwwroot/css/
MegaForm.Umbraco/wwwroot/lib/
MegaForm.Premium.AspNetCore/wwwroot/megaform/

# Marketplace publishing SOP — contains plaintext GitHub/oqtane credentials; never commit
CLAUDE_HANDOFF_20260708_OQTANE_MARKETPLACE_PUBLISH_SOP.md

# [SecretHygiene 2026-07-24] Loose credential/scratch files that accumulated at the repo root
# while driving live sites + AI endpoints. Verified never committed — keep it that way: this
# branch carries a large uncommitted delta, so one stray `git add -A` would leak them.
# Prefer an env var (GH_TOKEN) over a token file.
/token.txt
/cookies.txt
/login_headers.txt
/openai-req-body.json
/openai-req2.json
/openai-req3.json

# Browser-QA driver scratch output (chrome profile + screenshots)
tools/browser-qa/oq/

# [BrowserQA 2026-08-01] Headless Chrome writes its user-data-dir as <outDir>/.p (see
# tools/browser-qa/*.mjs). A single QA run leaves ~100MB of profile behind; none of it
# belongs in the repo.
tools/browser-qa/**/.p/
