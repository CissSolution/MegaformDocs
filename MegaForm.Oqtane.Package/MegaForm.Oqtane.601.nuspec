<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>MegaForm.Oqtane</id>
    <version>1.7.26</version>
    <authors>MegaForm Team</authors>
    <owners>MegaForm</owners>
    <title>MegaForm - Dynamic Form Builder</title>
    <description>Dynamic Form Builder for Oqtane (net9 / Oqtane 6.x build).</description>
    <copyright>MegaForm Team</copyright>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/nicknguyen-oqtane/MegaForm</projectUrl>
    <icon>icon.png</icon>
    <tags>oqtane module form builder survey payment</tags>
    <releaseNotes>net9 multi-target build for Oqtane 6.x — Step-4 install test.</releaseNotes>
    <summary>Dynamic form builder module for Oqtane CMS (.NET 9 / Oqtane 6.x).</summary>

    <packageTypes>
      <packageType name="Dependency" />
      <!-- Min compatible Oqtane framework — LOWERED to 6.0.0 so the 6.0.1 host accepts it. -->
      <packageType name="Oqtane.Framework" version="6.0.0" />
    </packageTypes>

    <dependencies>
      <group targetFramework="net9.0" />
    </dependencies>
  </metadata>
  <files>
    <!-- net9.0 module assemblies (names contain "Oqtane" → loaded by IsOqtaneAssembly) -->
    <file src="..\MegaForm.Oqtane.Client\bin\Release\net9.0\MegaForm.Oqtane.Client.Oqtane.dll" target="lib\net9.0" />
    <file src="..\MegaForm.Oqtane.Server\bin\Release\net9.0\MegaForm.Oqtane.Server.Oqtane.dll" target="lib\net9.0" />
    <file src="..\MegaForm.Oqtane.Shared\bin\Release\net9.0\MegaForm.Oqtane.Shared.Oqtane.dll" target="lib\net9.0" />

    <!-- Dependencies referenced by the module assemblies (names WITHOUT "Oqtane" → not auto-loaded,
         but resolved by the runtime). MegaForm.Sdk was MISSING from the legacy nuspec → added. -->
    <file src="..\MegaForm.Oqtane.Server\bin\Release\net9.0\MegaForm.Core.dll" target="lib\net9.0" />
    <file src="..\MegaForm.Oqtane.Server\bin\Release\net9.0\MegaForm.Sdk.dll" target="lib\net9.0" />
    <file src="..\MegaForm.Oqtane.Server\bin\Release\net9.0\Newtonsoft.Json.dll" target="lib\net9.0" />
    <!-- [CloudStorage v20260723-01] Cloud storage providers + SDK deps not shipped by Oqtane host -->
    <file src="..\MegaForm.Oqtane.Server\bin\Release\net9.0\MegaForm.Integrations.CloudStorage.dll" target="lib\net9.0" />
    <file src="..\MegaForm.Oqtane.Server\bin\Release\net9.0\AWSSDK.Core.dll" target="lib\net9.0" />
    <file src="..\MegaForm.Oqtane.Server\bin\Release\net9.0\AWSSDK.S3.dll" target="lib\net9.0" />
    <!-- [AzureBlobRemoved v20260726 / AzureResidue 2026-08-11] The three Azure.* entries were
         deleted here, matching the same removal already made in MegaForm.Oqtane.nuspec:80-83.
         This file was the LAST git-tracked place in the repo naming Azure.Core.dll,
         Azure.Storage.Blobs.dll or Azure.Storage.Common.dll as files to stage.

         It was not shipping them: the Azure Blob provider went away on 2026-07-26, so
         bin\Release\net9.0 no longer contains those DLLs and `nuget pack` aborted with NU5019
         before producing anything - the Oqtane 6.x packaging line was simply dead.

         The danger was the obvious repair. Faced with NU5019 the natural move is to restore the
         Azure.Storage.Blobs PackageReference to MegaForm.Integrations.CloudStorage - whose
         TargetFrameworks are net472;net8.0;net9.0;net10.0. The net472 leg is exactly the bin that
         DNN attribute-scans at startup, so an "Oqtane 6" fix would silently re-crash every DNN
         site's Control Bar. Deleting these lines removes the residue and the pressure together.
         Full rationale: MegaForm.DNN/MegaForm.dnn, the [AzureResidue 2026-08-11] block. -->
    <!-- [OqtaneLicensing v20260723] Oqtane Marketplace licensing (LicenseView + offline key validation);
         Client/Shared also declared in ModuleInfo.Dependencies (required for Blazor WebAssembly). -->
    <file src="..\MegaForm.Oqtane.Server\bin\Release\net9.0\Oqtane.Licensing.Client.Oqtane.dll" target="lib\net9.0" />
    <file src="..\MegaForm.Oqtane.Server\bin\Release\net9.0\Oqtane.Licensing.Server.Oqtane.dll" target="lib\net9.0" />
    <file src="..\MegaForm.Oqtane.Server\bin\Release\net9.0\Oqtane.Licensing.Shared.Oqtane.dll" target="lib\net9.0" />

    <!-- wwwroot assets → {webroot}/Modules/MegaForm/ (incl. AI Designer bundles + Beary png) -->
    <!-- [LicenseEdition 2026-07-24] EXCLUDE license.lic — Oqtane is Marketplace-licensed
         (OqtaneLicenseBridge), not file-licensed. Fresh install = TRIAL until a key is activated. -->
    <file src="..\MegaForm.Oqtane.Server\wwwroot\Modules\MegaForm\**\*.*" target="wwwroot\Modules\MegaForm" exclude="**\license.lic" />

    <file src="icon.png" target="" />
    <file src="license.txt" target="" />
  </files>
</package>
