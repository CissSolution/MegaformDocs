        Source          NVARCHAR(40) NOT NULL CONSTRAINT DF_MF_AI_KBTpl_Source DEFAULT 'customer',
        Version         INT NOT NULL CONSTRAINT DF_MF_AI_KBTpl_Version DEFAULT 1,
