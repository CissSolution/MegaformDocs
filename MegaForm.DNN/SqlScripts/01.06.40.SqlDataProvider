-- MegaForm 01.06.40 — dbo-qualified typed submission storage (2026-07-18)
--
-- Creates the record-field table + six typed value tables using explicit dbo.* names
-- to match the DNN runtime data layer (DnnSubmissionDataStore, DnnExternalBindingStore,
-- DnnExternalRowMapStore, FormRepository, etc. all hard-code dbo.MF_*).
--
-- Context: 01.06.39 used {databaseOwner}{objectQualifier} placeholders. On default DNN installs
-- (dbo + empty qualifier) both resolve to dbo.MF_* and work. On non-default qualifier installs
-- the runtime still targets dbo.MF_* while 01.06.39 created {qualifier}MF_*, causing typed writes
-- to hit non-existent tables. Rather than refactor the entire DNN data layer for this release,
-- this script enforces dbo.* consistency and non-default DNN object qualifier is documented as
-- unsupported for typed submission storage until a full qualifier-aware refactor is done.
--
-- Idempotent: IF OBJECT_ID / IF NOT EXISTS guards allow re-run. On default installs where
-- 01.06.39 already created dbo.MF_*, this script is a no-op.
--
-- FK cascade from MF_Submissions -> MF_SubmissionFields -> MF_SubmissionValue* means a
-- submission delete removes all typed rows at the DB level.
--
-- Idempotent (IF OBJECT_ID / IF NOT EXISTS) so re-running the install is safe.
-- Oqtane parity: MegaForm.Oqtane.Server\Migrations\01060039_AddTypedSubmissionStorage.cs
-- (Oqtane builds its schema from the EF model, so the FK/cascade there is enforced in the
--  repository; on DNN it is a real DB-level FK created here).

-- ===== MF_SubmissionFields ==============================================
IF OBJECT_ID('dbo.MF_SubmissionFields', 'U') IS NULL
BEGIN
    CREATE TABLE dbo.MF_SubmissionFields (
        SubmissionFieldId BIGINT IDENTITY(1,1) NOT NULL,
        SubmissionId      INT             NOT NULL,
        FormId            INT             NOT NULL,
        FormFieldId       BIGINT          NULL,
        FieldKey          NVARCHAR(256)   NULL,
        FieldId           NVARCHAR(256)   NULL,
        FieldAlias        NVARCHAR(256)   NULL,
        FieldType         NVARCHAR(128)   NULL,
        DataType          NVARCHAR(64)    NULL,
        LabelSnapshot     NVARCHAR(512)   NULL,
        PageIndex         INT             NULL,
        FieldOrder        INT             NULL,
        DisplayValue      NVARCHAR(MAX)   NULL,
        HasValue          BIT             NOT NULL CONSTRAINT DF_MF_SubmissionFields_HasValue DEFAULT 0,
        IsSensitive       BIT             NOT NULL CONSTRAINT DF_MF_SubmissionFields_IsSensitive DEFAULT 0,
        CreatedOnUtc      DATETIME2       NOT NULL CONSTRAINT DF_MF_SubmissionFields_CreatedOn DEFAULT SYSUTCDATETIME(),
        UpdatedOnUtc      DATETIME2       NULL,
        CONSTRAINT PK_MF_SubmissionFields PRIMARY KEY CLUSTERED (SubmissionFieldId),
        CONSTRAINT FK_MF_SubmissionFields_MF_Submissions FOREIGN KEY (SubmissionId)
            REFERENCES dbo.MF_Submissions(SubmissionId) ON DELETE CASCADE
    );
    CREATE INDEX IX_MF_SubmissionFields_Submission_FieldKey ON dbo.MF_SubmissionFields (SubmissionId, FieldKey);
    CREATE INDEX IX_MF_SubmissionFields_Form_FieldKey       ON dbo.MF_SubmissionFields (FormId, FieldKey);
    CREATE INDEX IX_MF_SubmissionFields_SubmissionId        ON dbo.MF_SubmissionFields (SubmissionId);
    CREATE INDEX IX_MF_SubmissionFields_Form_DataType       ON dbo.MF_SubmissionFields (FormId, DataType);
END
GO

