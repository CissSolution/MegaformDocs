-- MegaForm 02.00.015 - sortable form list
--
-- The Persona Bar panel pages the list on the SERVER (20 rows at a time), so sorting the rows
-- the browser happens to hold would only reorder one page of a hundred forms and call it sorted.
-- The order has to come from the same query that does the paging, which means it has to come
-- from here.
--
-- No dynamic SQL: @SortBy and @SortDir are parameters, and the ORDER BY is a fixed set of CASE
-- terms. A value that is not on the list simply matches no term and the list falls back to the
-- order it has always had (CreatedOnUtc DESC), which is also the tie-breaker.
--
-- Numbered 02.00.015 because the package is at 02.00.014 on installed sites and DNN only runs
-- scripts whose version is higher than the installed one.

IF OBJECT_ID('dbo.usp_MF_Form_List','P') IS NOT NULL DROP PROCEDURE dbo.usp_MF_Form_List;
GO
CREATE PROCEDURE dbo.usp_MF_Form_List
    @PortalId INT,
    @Status   NVARCHAR(20) = NULL,
    @Search   NVARCHAR(200) = NULL,
    @PageIndex INT = 0,
    @PageSize  INT = 20,
    @SortBy   NVARCHAR(20) = NULL,   -- title | submissions | modified | created (default)
    @SortDir  NVARCHAR(4)  = NULL    -- asc | desc (default desc for dates, asc for text)
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @Desc BIT = CASE WHEN @SortDir = 'desc' THEN 1 ELSE 0 END;

    ;WITH q AS (
        SELECT f.*,
               (SELECT COUNT(*) FROM dbo.MF_Submissions s WHERE s.FormId = f.FormId AND s.IsSpam = 0) AS SubmissionCount
        FROM dbo.MF_Forms f
        WHERE f.PortalId = @PortalId
          AND (@Status IS NULL OR f.[Status] = @Status)
          AND (@Search IS NULL OR f.Title LIKE '%' + @Search + '%')
    )
    SELECT *
    FROM q
    ORDER BY
        CASE WHEN @SortBy = 'title'       AND @Desc = 0 THEN q.Title END ASC,
        CASE WHEN @SortBy = 'title'       AND @Desc = 1 THEN q.Title END DESC,
        CASE WHEN @SortBy = 'status'      AND @Desc = 0 THEN q.[Status] END ASC,
        CASE WHEN @SortBy = 'status'      AND @Desc = 1 THEN q.[Status] END DESC,
        CASE WHEN @SortBy = 'submissions' AND @Desc = 0 THEN q.SubmissionCount END ASC,
        CASE WHEN @SortBy = 'submissions' AND @Desc = 1 THEN q.SubmissionCount END DESC,
        CASE WHEN @SortBy = 'modified'    AND @Desc = 0 THEN COALESCE(q.UpdatedOnUtc, q.CreatedOnUtc) END ASC,
        CASE WHEN @SortBy = 'modified'    AND @Desc = 1 THEN COALESCE(q.UpdatedOnUtc, q.CreatedOnUtc) END DESC,
        CASE WHEN @SortBy = 'created'     AND @Desc = 0 THEN q.CreatedOnUtc END ASC,
        q.CreatedOnUtc DESC
    OFFSET @PageIndex * @PageSize ROWS FETCH NEXT @PageSize ROWS ONLY;
END
GO
