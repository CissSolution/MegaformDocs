-- MegaForm 02.00.012 - Workflow Timer Scheduler Registration
-- [CloudReady A2 v20260806] Registers the DNN scheduled task that resumes due
-- Delay waits and sends the one-shot overdue task reminder.
--
-- Numbered 02.00.012, not 01.06.43: the package is already at 02.00.011 on every
-- installed site, and DNN only runs scripts whose version is HIGHER than the
-- installed one. An 01.06.xx script would be skipped forever and the scheduled
-- task would never be registered. Keep new scripts in the 02.00.xxx series.

IF NOT EXISTS (SELECT 1 FROM Schedule WHERE TypeFullName = 'MegaForm.DNN.Services.WorkflowTimerScheduleItem, MegaForm.DNN')
BEGIN
    INSERT INTO Schedule (
        TypeFullName,
        TimeLapse,
        TimeLapseMeasurement,
        RetryTimeLapse,
        RetryTimeLapseMeasurement,
        RetainHistoryNum,
        AttachToEvent,
        CatchUpEnabled,
        Enabled,
        ObjectDependencies,
        Servers,
        FriendlyName
    )
    VALUES (
        'MegaForm.DNN.Services.WorkflowTimerScheduleItem, MegaForm.DNN',
        1,
        'm',
        2,
        'm',
        10,
        '',
        0,
        1,
        '',
        NULL,
        'MegaForm Workflow Timer'
    );
END
GO

PRINT 'MegaForm 02.00.012 - Workflow timer scheduler registered.';
