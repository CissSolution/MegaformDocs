-- MegaForm 01.06.39 — Umbraco Forms-style typed submission storage (2026-07-17)
--
-- Creates the record-field table + six typed value tables, written in PARALLEL with
-- MF_Submissions.DataJson by DnnSubmissionDataStore (DNN keeps DataJson as the runtime
-- source of truth; typed rows are additive until DNN readers are switched).
--
-- FK cascade from MF_Submissions -> MF_SubmissionFields -> MF_SubmissionValue* means a
-- submission delete removes all typed rows at the DB level.
--
-- Idempotent (IF OBJECT_ID / IF NOT EXISTS) so re-running the install is safe.
-- Oqtane parity: MegaForm.Oqtane.Server\Migrations\01060039_AddTypedSubmissionStorage.cs
-- (Oqtane builds its schema from the EF model, so the FK/cascade there is enforced in the
--  repository; on DNN it is a real DB-level FK created here).

-- ===== MF_SubmissionFields ==============================================
IF OBJECT_ID('{databaseOwner}{objectQualifier}MF_SubmissionFields', 'U') IS NULL
BEGIN
    CREATE TABLE {databaseOwner}{objectQualifier}MF_SubmissionFields (
        SubmissionFieldId BIGINT IDENTITY(1,1) NOT NULL,
        SubmissionId      INT             NOT NULL,
        FormId            INT             NOT NULL,
        FormFieldId       BIGINT          NULL,
        FieldKey          NVARCHAR(256)   NULL,
        FieldId           NVARCHAR(256)   NULL,
        FieldAlias        NVARCHAR(256)   NULL,
        FieldType         NVARCHAR(128)   NULL,
        DataType          NVARCHAR(64)    NULL,
        LabelSnapshot     NVARCHAR(512)   NULL,
        PageIndex         INT             NULL,
        FieldOrder        INT             NULL,
        DisplayValue      NVARCHAR(MAX)   NULL,
        HasValue          BIT             NOT NULL CONSTRAINT DF_MF_SubmissionFields_HasValue DEFAULT 0,
        IsSensitive       BIT             NOT NULL CONSTRAINT DF_MF_SubmissionFields_IsSensitive DEFAULT 0,
        CreatedOnUtc      DATETIME2       NOT NULL CONSTRAINT DF_MF_SubmissionFields_CreatedOn DEFAULT SYSUTCDATETIME(),
        UpdatedOnUtc      DATETIME2       NULL,
        CONSTRAINT PK_MF_SubmissionFields PRIMARY KEY CLUSTERED (SubmissionFieldId),
        CONSTRAINT FK_MF_SubmissionFields_MF_Submissions FOREIGN KEY (SubmissionId)
            REFERENCES {databaseOwner}{objectQualifier}MF_Submissions(SubmissionId) ON DELETE CASCADE
    );
    CREATE INDEX IX_MF_SubmissionFields_Submission_FieldKey ON {databaseOwner}{objectQualifier}MF_SubmissionFields (SubmissionId, FieldKey);
    CREATE INDEX IX_MF_SubmissionFields_Form_FieldKey       ON {databaseOwner}{objectQualifier}MF_SubmissionFields (FormId, FieldKey);
    CREATE INDEX IX_MF_SubmissionFields_SubmissionId        ON {databaseOwner}{objectQualifier}MF_SubmissionFields (SubmissionId);
    CREATE INDEX IX_MF_SubmissionFields_Form_DataType       ON {databaseOwner}{objectQualifier}MF_SubmissionFields (FormId, DataType);
END
GO

