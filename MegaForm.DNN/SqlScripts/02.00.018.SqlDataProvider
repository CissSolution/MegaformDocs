-- MegaForm 02.00.018 - Automation AsyncWorker scheduler

-- [OutboxInstall 2026-08-14] The ALTER statements below used to be the first thing this script
-- did, but nothing in SqlScripts\ ever created the table: MF_AutomationOutbox is built at runtime
-- by DnnAutomationExecutionQueue.EnsureSchema, which does not run until the first enqueue. On a
-- fresh install the ALTERs therefore hit a table that does not exist and the install log carries
-- "Msg 4902 - Cannot find the object dbo.MF_AutomationOutbox" (verified by running this script on
-- an empty database). The scheduler row still landed, because it sits in the batch after GO, so
-- the failure looked harmless while being real. Create the table here, matching EnsureSchema
-- column for column - the two definitions must stay in step.
IF OBJECT_ID('dbo.MF_AutomationOutbox','U') IS NULL
CREATE TABLE [dbo].[MF_AutomationOutbox] (
    [OutboxId] bigint IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [FormId] int NOT NULL,
    [SubmissionId] int NULL,
    [Stage] nvarchar(30) NOT NULL,
    [PayloadJson] nvarchar(max) NULL,
    [Status] nvarchar(20) NOT NULL DEFAULT('pending'),
    [Attempts] int NOT NULL DEFAULT(0),
    [LastError] nvarchar(2000) NULL,
    [QueuedOnUtc] datetime NOT NULL,
    [NextRunUtc] datetime NULL,
    [CompletedUtc] datetime NULL
);
GO

IF COL_LENGTH('dbo.MF_AutomationOutbox','LockedOnUtc') IS NULL
    ALTER TABLE [dbo].[MF_AutomationOutbox] ADD [LockedOnUtc] datetime NULL;
IF COL_LENGTH('dbo.MF_AutomationOutbox','LockedBy') IS NULL
    ALTER TABLE [dbo].[MF_AutomationOutbox] ADD [LockedBy] nvarchar(100) NULL;
GO

-- EnsureSchema creates this index too; without it here, a fresh install would leave the worker's
-- dequeue scanning the table until the first runtime enqueue happened to add it.
IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_MF_AutomationOutbox_Pending')
    CREATE INDEX [IX_MF_AutomationOutbox_Pending]
        ON [dbo].[MF_AutomationOutbox] ([Status], [NextRunUtc]);
GO

IF NOT EXISTS (
    SELECT 1 FROM Schedule
    WHERE TypeFullName = 'MegaForm.DNN.Services.AutomationWorkerScheduleItem, MegaForm.DNN'
)
BEGIN
    INSERT INTO Schedule (
        TypeFullName,
        TimeLapse,
        TimeLapseMeasurement,
        RetryTimeLapse,
        RetryTimeLapseMeasurement,
        RetainHistoryNum,
        AttachToEvent,
        CatchUpEnabled,
        Enabled,
        ObjectDependencies,
        Servers,
        FriendlyName
    )
    VALUES (
        'MegaForm.DNN.Services.AutomationWorkerScheduleItem, MegaForm.DNN',
        1,
        'm',
        2,
        'm',
        10,
        '',
        0,
        1,
        '',
        NULL,
        'MegaForm Automation Worker'
    );
END
GO

PRINT 'MegaForm 02.00.018 - Automation worker scheduler registered.';

GO
