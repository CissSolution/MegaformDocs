-- Three prompt_rule entries that keep the AI on rails when a form WRITES into an existing
-- SQL table (the "form nhap lieu cho bang X" flow), including tables with foreign keys:
--   sql-table-data-entry-form           — one field per real column, FK column -> SQL-backed Select
--   db-insert-token-rules               — :token semantics: composite sub-parts (:name.first),
--                                         multi-select CSV coercion, auto-supplied :_submissionId
--   premium-template-retarget-sql-table — retarget a premium template at a table: fields change,
--                                         customHtml/customCss/theme and Section steps do NOT
--
-- Canonical twin: MegaForm.Core/Seed/ai-knowledge-seed.json (entries 330/331/332) — the Oqtane,
-- Web and Umbraco ports seed from that embedded resource; DNN seeds from SqlScripts, so BOTH
-- must carry the same text. Idempotent MERGE on Slug (built-in rows only) — safe to re-run.

MERGE dbo.MF_AI_Knowledge AS t
USING (SELECT N'sql-table-data-entry-form' AS Slug, CAST(NULL AS INT) AS PortalId) AS s
  ON (t.Slug = s.Slug AND t.PortalId IS NULL)
WHEN MATCHED AND t.Source = 'megaform-builtin' THEN UPDATE SET
  Kind = N'prompt_rule',
  Title = N'Data-entry form for an existing SQL table (including tables with foreign keys)',
