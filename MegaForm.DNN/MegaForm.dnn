        </component>
        <component type="Assembly">
          <assemblies>
            <assembly>
              <name>MegaForm.DNN.dll</name>
              <path>bin</path>
            </assembly>
            <assembly>
              <name>MegaForm.Core.dll</name>
              <path>bin</path>
            </assembly>
            <!-- [2026-06-23] MegaForm.Sdk.dll was missing from the manifest, so every
                 DNN install/upgrade shipped without it. DnnServiceLocator..ctor() loads
                 the SDK, so the FIRST code to touch DnnServiceLocator.Instance (FormsOverview,
                 Reports/Backfill, scheduler tasks like BlogScheduledPublishTask) threw
                 "Could not load file or assembly 'MegaForm.Sdk'". Bundling it here fixes
                 the gap at the source. -->
            <assembly>
              <name>MegaForm.Sdk.dll</name>
              <path>bin</path>
            </assembly>
            <!-- [CloudStorage v20260723-01] Cloud file mirror: Google Drive rides on MegaForm.Core
                 + the framework HttpClient, so it needs no assembly of its own.
                 [AzureBlobRemoved v20260726] Azure Blob provider DROPPED. Azure.Storage.Blobs pulled
                 Azure.Core 1.55 → System.ClientModel + .NET 10 System.* transitively; Azure.Core has an
                 assembly-level attribute whose type lives in System.ClientModel, and DNN scans EVERY
                 bin assembly's attributes at startup (MEF SafeDirectoryCatalog) → a missing
                 System.ClientModel.dll crashed the WHOLE site (TypeInitializationException).
                 [S3AddOn 2026-07-28] Amazon S3 moved OUT of this package into
                 MegaForm.CloudStorageS3_<version>_Install.zip: MegaForm.Integrations.CloudStorage.dll
                 + AWSSDK.Core + AWSSDK.S3 are 0.73 MB that only an S3-mirroring install executes.
                 DnnServiceLocator resolves the provider by reflection, so the module works with or
                 without the add-on and the two can be installed in either order. -->
          </assemblies>
        </component>
        <component type="ResourceFile">
          <resourceFiles>
            <basePath>DesktopModules/MegaForm</basePath>
            <resourceFile>
              <name>Resources.zip</name>
            </resourceFile>
          </resourceFiles>
        </component>
        <component type="File">
          <files>
            <file><name>icon.gif</name></file>
          </files>
        </component>

        <!-- ============================================================
             [PersonaBarMerge 2026-08-01] Content > MegaForm panel.
             Was the separate MegaForm.PersonaBar package (01.00.000); folded in here so one
             install gives a site both the module and its portal-wide admin panel.

             PersonaBar.zip carries the panel's SPA and unpacks into the Persona Bar's own
             Modules folder — that path is fixed by the loader, which resolves
             Modules/<folderName>/<path>.{html,js,css} from the menu row below.
             ============================================================ -->
        <component type="ResourceFile">
          <resourceFiles>
            <basePath>DesktopModules/admin/Dnn.PersonaBar/Modules</basePath>
            <resourceFile>
              <name>PersonaBar.zip</name>
            </resourceFile>
          </resourceFiles>
        </component>
        <component type="Assembly">
          <assemblies>
            <!-- net48, unlike MegaForm.DNN.dll (net472): Dnn.PersonaBar.Library on DNN 10.x is
                 built for 4.8 and a 4.7.2 build cannot even reference it. Both load fine on the
                 4.8 runtime every DNN 9.4+ site already requires. -->
            <assembly>
              <name>MegaForm.PersonaBar.dll</name>
              <path>bin</path>
            </assembly>
          </assemblies>
        </component>
        <component type="PersonaBarMenu">
          <menu>
            <!-- identifier is what [MenuPermission(MenuName = "MegaForm")] checks; folderName +
                 path are what the loader turns into Modules/MegaForm/MegaForm.{html,js,css}. -->
            <identifier>MegaForm</identifier>
            <moduleName>MegaForm</moduleName>
            <folderName>MegaForm</folderName>
            <resourceKey>nav_MegaForm</resourceKey>
            <path>MegaForm</path>
            <parent>Content</parent>
            <order>25</order>
            <defaultPermissions>Administrators</defaultPermissions>
          </menu>
        </component>
      </components>
    </package>
  </packages>
</dotnetnuke>
