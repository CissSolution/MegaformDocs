@namespace MegaForm.Blogs.Client
@inherits ModuleBase
@inject MegaForm.Sdk.IMegaFormClient Mega
@inject NavigationManager Nav
@* Read tracking identifies a visitor with a random id kept in their own browser. This module is a
   CLIENT assembly (it must be able to run under WebAssembly), so IHttpContextAccessor is not
   available to it at all — which turns out to be the better answer anyway. See TrackReadAsync. *@
@inject IJSRuntime JS

@* MegaForm Blogs - public Oqtane surface (twin of MegaFormBlogs.cshtml).

   ONE module, many surfaces. Which surface this instance is comes from Module Settings
   (BlogInstanceConfig.Mode + Profile); the query for that surface comes from BlogQueryPlan.
   Nothing on this page is hardcoded to "blog": a News instance is the same code with a
   different profile and a content_type filter.

   Data contract: IMegaFormClient only. No DataJson parsing, no direct database access. *@

@if (_config.IsConsole)
{
    @* The editorial console as a PAGE, not a popup. This is the intended way to run it: the
       console sits in the module pane like any other module, and ConsoleShell gives it the
       windowed/fullscreen surface. Its tabs stay on THIS page's URL, so nothing ever navigates
       into Oqtane's admin dialog. *@
    <ConsoleShell Scope="_scope"
                  ConsoleBaseUrl="@BaseUrl"
                  BlogUrl="@PublicBaseUrl()"
                  PostUrl="ConsolePostUrl"
                  AppKey="@_config.AppKey"
                  IsNews="_config.IsNews"
                  Allowed="_consoleAllowed"
                  View="@_consoleView"
                  EditId="_consoleEditId" />
}
else
{
<link rel="stylesheet" href="/Modules/MegaFormBlogs/megaform-blogs.css?v=20260731a" />
<script src="/Modules/MegaFormBlogs/megaform-blogs-read.js?v=20260731a"></script>

<main class="@_config.WrapperClass()" aria-labelledby="mfb-title">
    @if (_loadError != null)
    {
        <section class="mfb-state mfb-state-error">
            <strong>@(_config.IsNews ? "The newsroom is being prepared." : "Blog is being prepared.")</strong>
            <span>@_loadError</span>
        </section>
    }
    else if (_loading)
    {
        <section class="mfb-state">Loading@(_config.IsNews ? " the latest" : " stories")…</section>
    }
    else if (_app == null)
    {
        <section class="mfb-state">The Blog Publishing app has not been installed for this site.</section>
    }
    else if (_notFound)
    {
        @* ---- not found: an unknown slug must not render a hero and an empty list -------- *@
        <section class="mfb-state mfb-state-empty">
            <strong>@(_config.IsNews ? "That article is not available." : "That story is not available.")</strong>
            <span>It may have been unpublished, or the link may be wrong.</span>
            <a class="mfb-btn" href="@BaseUrl">@(_config.IsNews ? "Back to the news desk" : "Back to the blog")</a>
        </section>
    }
    else if (_detail != null)
    {
        var author = BlogData.Text(_detail, "author_name", DefaultAuthor);
        var avatar = BlogData.Text(_detail, "author_avatar_url", "");
        var tags = BlogData.Text(_detail, "tags", "")
            .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
        <article class="mfb-article">
            <nav class="mfb-breadcrumb" aria-label="Breadcrumb">
                <a href="@BaseUrl">@(_config.IsNews ? "News" : "Blog")</a><span>/</span>
                <span>@BlogData.Text(_detail, "category", DefaultCategory)</span>
            </nav>
            <header class="mfb-article-head">
                <span class="mfb-chip">@BlogData.Text(_detail, "content_type", _config.IsNews ? "News" : "Article")</span>
                <h1 id="mfb-title">@BlogData.Text(_detail, "title", UntitledLabel)</h1>
                <p class="mfb-lead">@BlogData.Text(_detail, "subtitle", BlogData.Text(_detail, "excerpt", ""))</p>
                @if (_config.ShowAuthor)
                {
                    <div class="mfb-byline">
                        @if (!string.IsNullOrWhiteSpace(avatar))
                        {
                            <img src="@avatar" alt="" />
                        }
                        else
                        {
                            <span class="mfb-avatar">@BlogData.Initials(author)</span>
                        }
                        <span>
                            <strong>@author</strong>
                            <small>
                                <time datetime="@BlogData.DateAttribute(_detail, "publish_date")">@DateText(_detail)</time>
                                @if (_config.ShowReadingTime)
                                {
                                    @(" · " + ReadingMinutes(_detail) + " min read")
                                }
                            </small>
                        </span>
                    </div>
                }
            </header>
            <figure class="mfb-article-hero">
                <img src="@ImageUrl(_detail)"
                     alt="@BlogData.Text(_detail, "image_alt_text", BlogData.Text(_detail, "title", "Article image"))" />
            </figure>
            <div class="mfb-article-layout">
                <div class="mfb-prose">@((MarkupString)BlogData.Text(_detail, "body", "<p>Article content is being prepared.</p>"))</div>
                <aside>
                    @if (_config.ShowAuthor)
                    {
                        <section class="mfb-author-card">
                            <span class="mfb-avatar mfb-avatar-lg">@BlogData.Initials(author)</span>
                            <h2>@author</h2>
                            <p class="mfb-muted">@BlogData.Text(_detail, "author_role", "Contributor")</p>
                            <p>@BlogData.Text(_detail, "author_bio", "")</p>
                            <a class="mfb-panel-link" href="@AuthorUrl(author)">More from this author →</a>
                        </section>
                    }
                    @if (_config.ShowTags && tags.Length > 0)
                    {
                        <section class="mfb-side-card">
                            <h2>Topics</h2>
                            <div class="mfb-tags">
                                @foreach (var tag in tags)
                                {
                                    <a href="@TagUrl(tag.Trim())">#@tag.Trim()</a>
                                }
                            </div>
                        </section>
                    }
                    @if (_config.ShowAttachments && _detailFiles.Count > 0)
                    {
                        <section class="mfb-side-card">
                            <h2>Attachments</h2>
                            @foreach (var file in _detailFiles)
                            {
                                <a class="mfb-attachment" href="@($"/api/MegaForm/SdkDemo/Download?submissionId={_detail.SubmissionId}&fileId={file.FileId}")">
                                    <span>↓</span> @file.FileName
                                </a>
                            }
                        </section>
                    }
                </aside>
            </div>
        </article>
    }
    else
    {
        @* ---- listing / category / author / archive / featured -------------------------- *@
        @if (_config.ShowHero && _config.Mode != "archive")
        {
            @* The module's own eyebrow + H1 + strapline are OFF by default since 1.4.0.
               Both hosts already print a title above the module — Oqtane's container renders
               ModuleState.Title, DNN's renders the module header — so rendering a second, larger
               one stacked directly under it is duplicated chrome, and it pushed the actual
               content most of a screen down. Turn "Hero heading" on for a standalone magazine
               page where nothing else supplies the title. *@
            <section class="mfb-hero @(_config.ShowHeroText ? "" : "mfb-hero-bare")">
                <div class="mfb-shell">
                    @if (_config.ShowHeroText)
                    {
                        <span class="mfb-eyebrow">@HeroEyebrow</span>
                        <h1 id="mfb-title">@HeroTitle</h1>
                        <p>@HeroSubtitle</p>
                    }
                    @if (_featured != null)
                    {
                        <article class="mfb-feature">
                            <a class="mfb-feature-image" href="@SlugUrl(_featured)">
                                <img src="@ImageUrl(_featured)" alt="@BlogData.Text(_featured, "image_alt_text", "")" />
                                <span>@(_config.IsNews ? "Top story" : "Featured")</span>
                            </a>
                            <div class="mfb-feature-copy">
                                <div>
                                    <span class="mfb-chip">@BlogData.Text(_featured, "category", DefaultCategory)</span>
                                    @if (_config.ShowReadingTime)
                                    {
                                        <small>@ReadingMinutes(_featured) min read</small>
                                    }
                                </div>
                                <h2><a href="@SlugUrl(_featured)">@BlogData.Text(_featured, "title", UntitledLabel)</a></h2>
                                <p>@BlogData.Text(_featured, "excerpt", "")</p>
                                <div class="mfb-card-foot">
                                    @if (_config.ShowAuthor)
                                    {
                                        <span>
                                            <strong>@BlogData.Text(_featured, "author_name", DefaultAuthor)</strong>
                                            <small><time datetime="@BlogData.DateAttribute(_featured, "publish_date")">@DateText(_featured)</time></small>
                                        </span>
                                    }
                                    @if (_config.ShowMetrics)
                                    {
                                        <span>@BlogData.Compact(BlogData.Num(_featured, "view_count")) reads · @BlogData.Num(_featured, "comment_count") comments</span>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        @if (_config.Mode != "featured")
        {
            <section class="mfb-shell mfb-content">
                <div class="mfb-main">
                    <header class="mfb-section-head">
                        <div>
                            <span class="mfb-trend">↗</span>
                            @* main[aria-labelledby] points at whichever heading actually exists.
                               With the hero heading off (the default) that is this h2, not the
                               hero h1 — a dangling aria-labelledby names nothing to a screen
                               reader. Tracks ShowHeroText, not ShowHero: the featured card can
                               be on while the heading is off. *@
                            <h2 id="@(HeroHeadingRendered ? "" : "mfb-title")">@SectionHeading</h2>
                        </div>
                        <span>@_total @(_total == 1 ? ItemLabelSingular : ItemLabelPlural)</span>
                    </header>

                    @* A GET form works under static SSR and interactive rendering alike. *@
                    <form class="mfb-filterbar" method="get" action="@BaseUrl">
                        <input type="search" name="q" value="@_url.Search"
                               placeholder="@(_config.IsNews ? "Search the news" : "Search stories")"
                               aria-label="Search" />
                        @if (_plan.HasFilter && _config.AllowUrlFilter)
                        {
                            <input type="hidden" name="@FilterQueryKey(_plan.FilterField)" value="@_plan.FilterValue" />
                        }
                        <button type="submit">Search</button>
                        @if (_url.Search.Length > 0 || _plan.HasFilter)
                        {
                            <a class="mfb-filter-clear" href="@BaseUrl">Clear</a>
                        }
                    </form>

                    @if (_truncated)
                    {
                        @* The read engine bounds its source scan. Say so rather than quietly
                           serving a short list - CLAUDE.md rule 11 is about silence, not the cap. *@
                        <div class="mfb-state mfb-state-note">
                            Showing the most recent @BlogInstanceConfig.MaxSourceRecords records only.
                            Narrow the filter to reach older @ItemLabelPlural.
                        </div>
                    }

                    @if (_posts.Count == 0)
                    {
                        <div class="mfb-state mfb-state-empty">@EmptyMessage</div>
                    }
                    else
                    {
                        <div class="mfb-grid">
                            @foreach (var post in VisiblePosts())
                            {
                                <article class="mfb-card">
                                    <a class="mfb-card-image" href="@SlugUrl(post)">
                                        <img src="@ImageUrl(post)" alt="@BlogData.Text(post, "image_alt_text", "")" />
                                    </a>
                                    <div class="mfb-card-body">
                                        <div>
                                            <a class="mfb-chip" href="@CategoryUrl(BlogData.Text(post, "category", DefaultCategory))">@BlogData.Text(post, "category", DefaultCategory)</a>
                                            @if (_config.ShowReadingTime)
                                            {
                                                <small>@ReadingMinutes(post) min</small>
                                            }
                                        </div>
                                        <h3><a href="@SlugUrl(post)">@BlogData.Text(post, "title", UntitledLabel)</a></h3>
                                        <p>@BlogData.Text(post, "excerpt", "")</p>
                                        <div class="mfb-card-foot">
                                            @if (_config.ShowAuthor)
                                            {
                                                <span>
                                                    <strong>@BlogData.Text(post, "author_name", DefaultAuthor)</strong>
                                                    <small><time datetime="@BlogData.DateAttribute(post, "publish_date")">@DateText(post)</time></small>
                                                </span>
                                            }
                                            @if (_config.ShowMetrics)
                                            {
                                                <span>@BlogData.Compact(BlogData.Num(post, "view_count")) reads</span>
                                            }
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>

                        @if (_totalPages > 1)
                        {
                            <nav class="mfb-pager" aria-label="Pagination">
                                @if (_plan.Page > 1)
                                {
                                    <a class="mfb-pager-prev" href="@PageUrl(_plan.Page - 1)" rel="prev">← Newer</a>
                                }
                                <span class="mfb-pager-pages">
                                    @foreach (var number in PageWindow())
                                    {
                                        if (number == _plan.Page)
                                        {
                                            <strong aria-current="page">@number</strong>
                                        }
                                        else
                                        {
                                            <a href="@PageUrl(number)">@number</a>
                                        }
                                    }
                                </span>
                                <span class="mfb-pager-of">Page @_plan.Page of @_totalPages</span>
                                @if (_plan.Page < _totalPages)
                                {
                                    <a class="mfb-pager-next" href="@PageUrl(_plan.Page + 1)" rel="next">Older →</a>
                                }
                            </nav>
                        }
                    }
                </div>
            </section>
        }
    }
</main>
}

@code {
    private static readonly string[] ConsoleRolesFallback =
    {
        "Administrators", "Host", "Blog Authors", "Blog Editors",
        "SEO Reviewers", "Content Legal Reviewers", "Blog Publishers"
    };

    private bool _loading = true;
    private string _loadError;
    private AppDto _app;
    private AppRecordDto _featured;
    private AppRecordDto _detail;
    private List<AppRecordDto> _posts = new List<AppRecordDto>();
    private IReadOnlyList<FileDto> _detailFiles = new List<FileDto>();
    private int _total;
    private int _totalPages = 1;
    private bool _truncated;
    private bool _notFound;

    private BlogInstanceConfig _config = new BlogInstanceConfig();
    private BlogUrlState _url = new BlogUrlState();
    private BlogQueryPlan _plan = BlogQueryPlan.Build(new BlogInstanceConfig(), new BlogUrlState());

    /// <summary>The slug whose read has already been recorded on this circuit.</summary>
    private string _trackedSlug;

    private MegaFormScope _scope = new MegaFormScope();
    private bool _consoleAllowed;
    private string _consoleView = "dashboard";
    private int _consoleEditId;

    public override string Title => "MegaForm Blogs";

    private string BaseUrl => NavigateUrl(PageState.Page.Path);

    // ---- lifecycle ---------------------------------------------------------------------------

    protected override async Task OnParametersSetAsync()
    {
        _config = BlogInstanceConfig.Read(ModuleState?.Settings);
        _url = BlogUrlState.Parse(Nav?.Uri ?? "", _config);

        // urlparameters mode: /page/!/my-slug puts the slug in PageState.UrlParameters.
        if (_config.SlugSource == "urlparameters" && _url.Slug.Length == 0)
            _url.Slug = FirstUrlParameter();

        _plan = BlogQueryPlan.Build(_config, _url);
        BuildScope();
        await LoadAsync();
    }

    private void BuildScope()
    {
        var user = PageState?.User;
        var roles = SplitRoles(user?.Roles);
        _scope = new MegaFormScope
        {
            PortalId = PageState?.Site?.SiteId ?? 0,
            UserId = user?.UserId ?? 0,
            UserName = user?.Username ?? "",
            DisplayName = user?.DisplayName ?? "",
            UserEmail = user?.Email ?? "",
            IsAuthenticated = user != null && user.UserId > 0,
            IsAdmin = roles.Any(r => r.Equals("Administrators", StringComparison.OrdinalIgnoreCase)
                                  || r.Equals("Host", StringComparison.OrdinalIgnoreCase)),
            IsSuperUser = roles.Any(r => r.Equals("Host", StringComparison.OrdinalIgnoreCase)),
            Roles = roles
        };

        // The ConsoleRoles setting may only NARROW access. The independent role check below is
        // what actually grants it, so a mis-typed setting can never open the console up.
        var allowed = _config.ConsoleRoleList();
        if (allowed.Count == 0) allowed = ConsoleRolesFallback.ToList();
        _consoleAllowed = user != null && user.UserId > 0
                          && roles.Any(r => allowed.Contains(r, StringComparer.OrdinalIgnoreCase))
                          && roles.Any(r => ConsoleRolesFallback.Contains(r, StringComparer.OrdinalIgnoreCase));

        var requested = BlogUrlState.Read(Nav?.Uri ?? "", "view", 32).ToLowerInvariant();
        _consoleView = BlogInstanceConfig.ConsoleRoutes.Contains(requested) ? requested : _config.ConsoleView;
        _consoleEditId = BlogUrlState.ReadId(Nav?.Uri ?? "", "id");

        // "edit" without a post is not a screen. Land on the board instead of rendering an
        // editor that can only say "no post was selected".
        if (_consoleView == "edit" && _consoleEditId <= 0) _consoleView = "editorial";
    }

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            _notFound = false;
            _app = await Mega.Apps.GetAppAsync(_config.AppKey, _scope);
            if (_app == null) return;

            // The console reads its own data through the admin components.
            if (_config.IsConsole)
            {
                _loadError = null;
                return;
            }

            if (_plan.DetailWithoutSlug)
            {
                _notFound = true;
                _loadError = null;
                return;
            }

            var result = await Mega.Queries.ExecuteAsync(
                _config.AppKey, _plan.QueryKey, _plan.Request, _scope);

            _posts = result?.Items?.ToList() ?? new List<AppRecordDto>();
            _total = result?.TotalCount ?? 0;
            _truncated = result?.IsBounded ?? false;
            _totalPages = _plan.TotalPages(_total);

            if (_plan.IsDetail)
            {
                _detail = _posts.FirstOrDefault();
                _featured = null;
                if (_detail == null)
                {
                    _notFound = true;
                    _detailFiles = new List<FileDto>();
                }
                else
                {
                    _detailFiles = _config.ShowAttachments
                        ? await Mega.Files.ListForSubmissionAsync(_detail.SubmissionId, _scope)
                        : new List<FileDto>();
                }
            }
            else
            {
                _detail = null;
                _featured = await LoadFeaturedAsync();
            }
            _loadError = null;
        }
        catch (Exception)
        {
            // This surface is anonymous: never echo exception text to visitors.
            _loadError = "The content could not be loaded. The site log has the details.";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Record that this post was read.
    ///
    /// ⭐ WHY THIS RUNS FROM JAVASCRIPT AND NOT ON THE SERVER RENDER.
    /// This module is a CLIENT assembly — it has to be loadable under WebAssembly — so
    /// IHttpContextAccessor is not merely unavailable at runtime, it does not compile. There is no
    /// request, no IP and no user agent here.
    ///
    /// Asking the browser instead is better on every axis that matters:
    ///  - PRIVACY: the visitor id is a random value the browser generated and keeps in its own
    ///    localStorage. No IP is read, nothing is hashed, and clearing site data resets it.
    ///  - BOTS: crawlers, uptime monitors and link previewers do not execute JavaScript, so they
    ///    are excluded by construction rather than by guessing from a user-agent blocklist.
    ///  - DOUBLE RENDER: this module does not override ModuleBase.RenderMode, so it runs
    ///    Interactive even on a Static site and renders twice per visit. Counting after the circuit
    ///    connects, once per slug, sidesteps that entirely.
    ///
    /// Its own try/catch, and it never touches _loadError: a reader's page must not show an error
    /// banner because analytics failed.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!_config.TrackReads || _config.IsConsole || _detail == null) return;

            var slug = BlogData.Text(_detail, "slug", "");
            if (slug.Length == 0 || string.Equals(slug, _trackedSlug, StringComparison.Ordinal)) return;

            var postUid = BlogData.Text(_detail, "post_uid", "");
            if (postUid.Length == 0) return;   // unattributable: the rollup groups on post_uid

            // Mark before awaiting: a second render must not race a second write in.
            _trackedSlug = slug;

            var visitorKey = await JS.InvokeAsync<string>("megaFormBlogsVisitorId");
            if (string.IsNullOrWhiteSpace(visitorKey)) return;

            await BlogReadTracker.TrackReadAsync(
                Mega, _scope, _config.AppKey,
                postUid, slug,
                visitorKey,
                _scope?.UserId ?? 0,
                referrer: "",
                // null means "no user agent to judge" — the JS call above already proved this is a
                // real browser, so the blocklist has nothing left to add.
                userAgent: null);
        }
        catch (Exception)
        {
            // Analytics must never break a reader's page. A prerender pass where JS interop is not
            // available yet lands here too, and the next render simply tries again.
            _trackedSlug = null;
        }
    }

    /// <summary>
    /// The hero. An empty FeaturedQueryKey means the admin turned the hero off; in "featured" mode
    /// the main query IS the featured query, so reuse its first row instead of querying twice.
    /// </summary>
    private async Task<AppRecordDto> LoadFeaturedAsync()
    {
        if (!_config.ShowHero) return null;
        if (_config.Mode == "featured") return _posts.FirstOrDefault();
        if (string.IsNullOrWhiteSpace(_config.FeaturedQueryKey)) return null;

        // A filtered surface (a category or author page) should lead with one of ITS posts,
        // not with the site-wide featured story.
        if (_plan.HasFilter || _url.Search.Length > 0) return _posts.FirstOrDefault();

        var featured = await Mega.Queries.ExecuteAsync(
            _config.AppKey, _config.FeaturedQueryKey, BlogQueryPlan.FeaturedRequest(), _scope);
        return featured?.Items?.FirstOrDefault() ?? _posts.FirstOrDefault();
    }

    /// <summary>Do not repeat the hero story as the first card.</summary>
    private IEnumerable<AppRecordDto> VisiblePosts()
        => _posts.Where(p => _featured == null || p.SubmissionId != _featured.SubmissionId);

    // ---- wording -----------------------------------------------------------------------------

    private string DefaultAuthor => "MegaForm Editorial";
    private string DefaultCategory => _config.IsNews ? "News" : "Insights";
    private string UntitledLabel => _config.IsNews ? "Untitled article" : "Untitled story";
    private string ItemLabelSingular => _config.IsNews ? "article" : "story";
    private string ItemLabelPlural => _config.IsNews ? "articles" : "stories";

    /// <summary>True when the hero actually renders an h1 that aria-labelledby can point at.</summary>
    private bool HeroHeadingRendered
        => _config.ShowHero && _config.ShowHeroText && _config.Mode != "archive";

    private string HeroEyebrow => Or(_config.HeroEyebrow, _config.IsNews ? "Latest" : "◆ Featured stories");

    private string HeroTitle => Or(_config.HeroTitle, _config.IsNews ? "Newsroom" : "Insights & Ideas");

    private string HeroSubtitle => Or(_config.HeroSubtitle, _config.IsNews
        ? "Reporting and analysis from the MegaForm newsroom."
        : "Design, development and product thinking from the MegaForm community.");

    private string SectionHeading
    {
        get
        {
            if (_config.SectionHeading.Length > 0) return _config.SectionHeading;
            switch (_config.Mode)
            {
                case "category": return _plan.HasFilter ? _plan.FilterValue : "All categories";
                case "author": return _plan.HasFilter ? _plan.FilterValue : "All authors";
                case "archive": return "Archive";
                default:
                    if (_url.Search.Length > 0) return "Results for “" + _url.Search + "”";
                    return _config.IsNews ? "Latest news" : "Popular this week";
            }
        }
    }

    private string EmptyMessage => Or(_config.EmptyMessage,
        _url.Search.Length > 0
            ? "Nothing matched that search."
            : (_config.IsNews ? "No news published yet." : "No published stories yet."));

    private static string Or(string value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value;

    /// <summary>A blog reads better relative; a news desk needs the dateline.</summary>
    private string DateText(AppRecordDto record)
        => BlogData.DateLabel(record, "publish_date", relative: !_config.IsNews);

    // ---- urls --------------------------------------------------------------------------------

    private string ImageUrl(AppRecordDto record)
        => BlogData.Text(record, "featured_image_url", _config.PlaceholderImageUrl);

    /// <summary>
    /// Where a post opens. DetailPageId sends readers to a dedicated detail instance; 0 keeps
    /// them on this page. SlugSource picks between ?slug= and Oqtane url parameters.
    /// </summary>
    private string SlugUrl(AppRecordDto record)
        => PostUrlForSlug(BlogData.Text(record, "slug", ""));

    /// <summary>
    /// The reader-facing URL for one slug. Shared with the console, which hands this method to
    /// its screens so an editor can preview a post without knowing the site's page layout.
    /// </summary>
    private string PostUrlForSlug(string slug)
    {
        var target = _config.IsConsole ? PublicBaseUrl() : DetailBaseUrl();
        if (string.IsNullOrWhiteSpace(slug)) return target;

        if (_config.SlugSource == "urlparameters")
            return target.TrimEnd('/') + "/!/" + Uri.EscapeDataString(slug);

        return target + "?" + _config.SlugParam + "=" + Uri.EscapeDataString(slug);
    }

    private string DetailBaseUrl() => PageUrlOr(_config.DetailPageId, BaseUrl);

    /// <summary>
    /// Where readers actually are. A console instance sits on an admin page, so its own URL is
    /// the wrong answer — PublicPageId names the public surface, with DetailPageId as a sensible
    /// second guess and this page as the last resort (which is what it did before the setting
    /// existed, so an un-configured console behaves exactly as it used to).
    /// </summary>
    private string PublicBaseUrl()
        => PageUrlOr(_config.PublicPageId, PageUrlOr(_config.DetailPageId, BaseUrl));

    /// <summary>
    /// The console's preview links. Returns "" — which hides them — while the resolved public
    /// page is still this console's own page, because a "view the post" link that lands back on
    /// the console is the same broken promise as the placeholder tiles it replaced. Naming a
    /// page in the Public blog page setting turns the links on.
    /// </summary>
    private string ConsolePostUrl(string slug)
        => PublicIsElsewhere ? PostUrlForSlug(slug) : "";

    private bool PublicIsElsewhere
        => !string.Equals(PublicBaseUrl(), BaseUrl, StringComparison.OrdinalIgnoreCase);

    private string PageUrlOr(int pageId, string fallback)
    {
        if (pageId > 0)
        {
            var target = PageState?.Pages?.FirstOrDefault(p => p != null && p.PageId == pageId);
            if (target != null) return NavigateUrl(target.Path);
        }
        return fallback;
    }

    private string CategoryUrl(string category)
        => _config.AllowUrlFilter && !string.IsNullOrWhiteSpace(category)
            ? BaseUrl + "?category=" + Uri.EscapeDataString(category)
            : BaseUrl;

    private string TagUrl(string tag)
        => _config.AllowUrlFilter && !string.IsNullOrWhiteSpace(tag)
            ? BaseUrl + "?tag=" + Uri.EscapeDataString(tag)
            : BaseUrl;

    private string AuthorUrl(string author)
        => _config.AllowUrlFilter && !string.IsNullOrWhiteSpace(author)
            ? BaseUrl + "?author=" + Uri.EscapeDataString(author)
            : BaseUrl;

    private static string FilterQueryKey(string field)
    {
        switch (field)
        {
            case "tags": return "tag";
            case "author_name": return "author";
            default: return "category";
        }
    }

    /// <summary>Page links keep the current filter and search; only the page number moves.</summary>
    private string PageUrl(int number)
    {
        var parts = new List<string>();
        if (_url.Category.Length > 0) parts.Add("category=" + Uri.EscapeDataString(_url.Category));
        if (_url.Tag.Length > 0) parts.Add("tag=" + Uri.EscapeDataString(_url.Tag));
        if (_url.Author.Length > 0) parts.Add("author=" + Uri.EscapeDataString(_url.Author));
        if (_url.Search.Length > 0) parts.Add("q=" + Uri.EscapeDataString(_url.Search));
        if (number > 1) parts.Add("page=" + number.ToString(CultureInfo.InvariantCulture));
        return parts.Count == 0 ? BaseUrl : BaseUrl + "?" + string.Join("&", parts);
    }

    /// <summary>At most seven page numbers, centred on the current one.</summary>
    private IEnumerable<int> PageWindow()
    {
        const int window = 7;
        var first = Math.Max(1, _plan.Page - window / 2);
        var last = Math.Min(_totalPages, first + window - 1);
        first = Math.Max(1, last - window + 1);
        for (var number = first; number <= last; number++) yield return number;
    }

    private string FirstUrlParameter()
    {
        var parameters = PageState?.UrlParameters;
        if (string.IsNullOrWhiteSpace(parameters)) return "";
        var first = parameters.Split(new[] { '/' }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
        first = first.Trim();
        return first.Length > 200 ? first.Substring(0, 200) : first;
    }

    private static List<string> SplitRoles(string roles)
        => (roles ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(r => r.Trim()).Where(r => r.Length > 0).ToList();

    private int ReadingMinutes(AppRecordDto record)
    {
        var configured = BlogData.Num(record, "reading_time");
        if (configured > 0) return configured;
        var plain = System.Text.RegularExpressions.Regex.Replace(
            BlogData.Text(record, "body", ""), "<[^>]+>", " ");
        var words = System.Text.RegularExpressions.Regex.Matches(plain, @"\b[\p{L}\p{N}]+\b").Count;
        return Math.Max(1, (int)Math.Ceiling(words / 220d));
    }
}
