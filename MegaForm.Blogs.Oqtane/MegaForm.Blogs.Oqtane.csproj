<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    MegaForm Blogs for Oqtane - the Oqtane twin of MegaForm.Blogs.DNN.
    Client-only module: it owns no tables and no server manager. Everything it reads or
    writes goes through the public MegaForm.Sdk facade, exactly like the DNN Razor Host
    scripts. MegaForm.Sdk.dll ships with the MegaForm module, so this package does not
    re-ship it; it declares the dependency instead.
  -->

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Version>1.1.0</Version>
    <Authors>MegaForm Team</Authors>
    <Company>MegaForm</Company>
    <Description>MegaForm Blogs for Oqtane - public blog and editorial console over the blog-starter app.</Description>
    <Product>MegaForm Blogs</Product>
    <AssemblyName>MegaForm.Blogs.Oqtane.Client.Oqtane</AssemblyName>
    <RootNamespace>MegaForm.Blogs.Client</RootNamespace>
    <BlazorWebAssemblyEnableLinking>false</BlazorWebAssemblyEnableLinking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.3" />
    <PackageReference Include="Oqtane.Client" Version="10.1.0" />
    <PackageReference Include="Oqtane.Shared" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="9.0.9" />
    <PackageReference Include="Oqtane.Client" Version="6.0.1" />
    <PackageReference Include="Oqtane.Shared" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MegaForm.Sdk\MegaForm.Sdk.csproj" />
  </ItemGroup>

</Project>
