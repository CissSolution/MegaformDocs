@namespace MegaForm.Blogs.Client
@inherits ModuleBase
@inject NavigationManager Nav

@* MegaForm Blogs - the module's Edit action.

   Oqtane renders every module action control inside `.app-admin-modal > .modal`
   (position:fixed; z-index:9999) — a popup. An editorial console is not popup work, so:

     - the preferred way to run the console is INLINE: give the instance the
       "admin console" View in Module Settings and it renders in the page pane
       (Index.razor). That path has no dialog at all.
     - this route still works, and ConsoleShell's surface can be lifted out of the
       dialog with the Fullscreen toggle (.mf-oq-surface.is-fs is z-index:10000).

   All the markup lives in ConsoleShell so the two hosts cannot drift. The role gate is
   enforced here, independently of the Oqtane page permission, so a page grant alone
   never exposes the console. *@

<ConsoleShell Scope="_scope"
              ConsoleBaseUrl="@AdminBaseUrl"
              BlogUrl="@BlogUrl"
              PostUrl="PostUrlForSlug"
              AppKey="@_config.AppKey"
              IsNews="_config.IsNews"
              Allowed="_allowed"
              View="@_view"
              EditId="_editId" />

@code {
    private static readonly string[] BlogRoles =
    {
        "Administrators", "Host", "Blog Authors", "Blog Editors",
        "SEO Reviewers", "Content Legal Reviewers", "Blog Publishers"
    };

    private bool _allowed;
    private string _view = "dashboard";
    private int _editId;
    private MegaFormScope _scope = new MegaFormScope();
    private BlogInstanceConfig _config = new BlogInstanceConfig();

    public override string Title => "Blog editorial console";

    // ⭐ THIS is what stops the popup. Oqtane.UI.ContainerBuilder.OnParametersSet swaps the
    // theme's container for Oqtane.Themes.AdminContainer — which renders
    // `.app-admin-modal > .modal[role=dialog]` at position:fixed; z-index:9999 — whenever
    //     PageState.ModuleId != -1 && PageState.Route.Action != "" && ModuleState.UseAdminContainer
    // ModuleBase declares `public virtual bool UseAdminContainer => true`, so every action
    // control gets the dialog by default. Overriding it to false keeps the normal theme
    // container, so the console renders INLINE in the pane on this route too.
    // (Verified against the decompiled Oqtane.Client 10.1.0 assembly.)
    public override bool UseAdminContainer => false;

    // Inside the dialog the tabs must stay on the Edit action, or a click would drop the user
    // onto the public page. EditUrl(action) is the idiom MegaForm's own module uses
    // (Oqtane.Client/Index.razor:2786).
    private string AdminBaseUrl => EditUrl("Edit");

    /// <summary>
    /// The public surface. PublicPageId names it explicitly; without it this route falls back to
    /// the page the console was opened from, which is what it did before the setting existed.
    /// </summary>
    private string BlogUrl
    {
        get
        {
            var pageId = _config.PublicPageId > 0 ? _config.PublicPageId : _config.DetailPageId;
            if (pageId > 0)
            {
                var target = PageState?.Pages?.FirstOrDefault(p => p != null && p.PageId == pageId);
                if (target != null) return NavigateUrl(target.Path);
            }
            return NavigateUrl(PageState.Page.Path);
        }
    }

    /// <summary>Reader-facing URL for one slug — the console's preview links. Twin of Index.razor's.</summary>
    private string PostUrlForSlug(string slug)
    {
        var target = BlogUrl;
        if (string.IsNullOrWhiteSpace(slug)) return target;
        if (_config.SlugSource == "urlparameters")
            return target.TrimEnd('/') + "/!/" + Uri.EscapeDataString(slug);
        return target + "?" + _config.SlugParam + "=" + Uri.EscapeDataString(slug);
    }

    protected override void OnParametersSet()
    {
        _config = BlogInstanceConfig.Read(ModuleState?.Settings);

        _view = BlogUrlState.Read(Nav?.Uri ?? "", "view", 32).ToLowerInvariant();
        if (!BlogInstanceConfig.ConsoleRoutes.Contains(_view)) _view = _config.ConsoleView;
        _editId = BlogUrlState.ReadId(Nav?.Uri ?? "", "id");
        if (_view == "edit" && _editId <= 0) _view = "editorial";

        var user = PageState?.User;
        var roles = SplitRoles(user?.Roles);

        // The ConsoleRoles setting may only NARROW access: an editor must be in the configured
        // list AND in the module's own role list, so a mis-typed setting cannot open this up.
        var configured = _config.ConsoleRoleList();
        if (configured.Count == 0) configured = BlogRoles.ToList();
        _allowed = user != null && user.UserId > 0
                   && roles.Any(r => BlogRoles.Contains(r, StringComparer.OrdinalIgnoreCase))
                   && roles.Any(r => configured.Contains(r, StringComparer.OrdinalIgnoreCase));

        _scope = new MegaFormScope
        {
            PortalId = PageState?.Site?.SiteId ?? 0,
            UserId = user?.UserId ?? 0,
            UserName = user?.Username ?? "",
            DisplayName = user?.DisplayName ?? "",
            UserEmail = user?.Email ?? "",
            IsAuthenticated = user != null && user.UserId > 0,
            IsAdmin = roles.Any(r => r.Equals("Administrators", StringComparison.OrdinalIgnoreCase)
                                  || r.Equals("Host", StringComparison.OrdinalIgnoreCase)),
            IsSuperUser = roles.Any(r => r.Equals("Host", StringComparison.OrdinalIgnoreCase)),
            Roles = roles
        };
    }

    private static List<string> SplitRoles(string roles)
        => (roles ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(r => r.Trim()).Where(r => r.Length > 0).ToList();
}
