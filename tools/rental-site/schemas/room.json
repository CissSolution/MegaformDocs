{
  "version": "1.0",
  "fields": [
    {
      "key": "room_code",
      "type": "Text",
      "label": "Room code (Mã phòng)",
      "order": 1,
      "required": true,
      "pageIndex": 0,
      "placeholder": "TB01-0203",
      "helpText": "Unique business key for this room. Monthly readings and tenants point back here with this exact value.",
      "validation": {
        "minLength": 2,
        "maxLength": 40,
        "pattern": "^[A-Z0-9][A-Z0-9_.-]{1,39}$",
        "patternMessage": "Upper-case letters, digits, - . _ (2-40 chars), e.g. TB01-0203."
      }
    },
    {
      "key": "building_code",
      "type": "Text",
      "label": "Building code (Mã toà nhà)",
      "order": 2,
      "required": true,
      "pageIndex": 0,
      "placeholder": "TB01",
      "helpText": "FOREIGN KEY. Must repeat the parent building record's Building code exactly (matched case-insensitively by the auto-link).",
      "validation": {
        "minLength": 2,
        "maxLength": 20,
        "pattern": "^[A-Z0-9][A-Z0-9_-]{1,19}$",
        "patternMessage": "Must match an existing building code, e.g. TB01."
      }
    },
    {
      "key": "room_name",
      "type": "Text",
      "label": "Room name / number (Tên hoặc số phòng)",
      "order": 3,
      "required": false,
      "pageIndex": 0,
      "validation": {
        "maxLength": 100
      }
    },
    {
      "key": "floor_level",
      "type": "Number",
      "label": "Floor level (Tầng)",
      "order": 4,
      "required": false,
      "pageIndex": 0,
      "validation": {
        "min": 0,
        "max": 50
      }
    },
    {
      "key": "area_m2",
      "type": "Number",
      "label": "Area in m2 (Diện tích, m²)",
      "order": 5,
      "required": true,
      "pageIndex": 0,
      "validation": {
        "min": 5,
        "max": 500
      }
    },
    {
      "key": "base_rent",
      "type": "Number",
      "label": "Base rent, VND per month (Giá thuê gốc, VNĐ/tháng)",
      "order": 6,
      "required": true,
      "pageIndex": 0,
      "helpText": "Plain number, no thousands separators and no currency symbol. There is no Currency field type in this engine — the unit lives in the label.",
      "validation": {
        "min": 0,
        "max": 500000000
      }
    },
    {
      "key": "discount_percent",
      "type": "Number",
      "label": "Discount percent (Giảm giá, %)",
      "order": 7,
      "required": false,
      "pageIndex": 0,
      "defaultValue": "0",
      "validation": {
        "min": 0,
        "max": 100
      }
    },
    {
      "key": "final_price",
      "type": "Number",
      "label": "Final price, VND per month (Giá cuối, VNĐ/tháng)",
      "order": 8,
      "required": true,
      "pageIndex": 0,
      "helpText": "Deliberately denormalised = base rent x (100 - discount) / 100. Stored so a price-range filter can hit one numeric column instead of computing at query time.",
      "validation": {
        "min": 0,
        "max": 500000000
      }
    },
    {
      "key": "deposit",
      "type": "Number",
      "label": "Deposit, VND (Tiền cọc, VNĐ)",
      "order": 9,
      "required": false,
      "pageIndex": 0,
      "validation": {
        "min": 0,
        "max": 500000000
