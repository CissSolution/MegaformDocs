      "message": "Redirecting with ref={{field:first_name}}",
      "redirectUrl": "http://megaclean008.ai/mfqa-form?ref={{field:first_name}}",
      "redirectDelaySeconds": 1,
      "redirectNotice": "Redirecting in",
      "showSubmissionId": false,
      "showAnswerSummary": false,
      "allowFillAgain": false
