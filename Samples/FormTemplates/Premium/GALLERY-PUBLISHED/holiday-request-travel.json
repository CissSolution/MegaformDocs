    "customHtml": "<div class='mfp mfp-hol mfp-native-generated' data-mf-flexgrid=\"locked\" style=\"background:transparent!important;border:0!important;border-radius:0!important;padding:0!important;box-shadow:none!important\"><div class='hol-card'><div class='hol-accent'></div><header class='hol-head'><div><h1>Holiday Request Form</h1><p>Domestic &amp; International</p></div><div class='hol-art' role='presentation'></div></header><div class='hol-rule'></div><div class='hol-body'><section><div class='hol-sec'><div class='hol-sec-icon'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg></div><div><div class='hol-sec-t'>Personal Information</div><div class='hol-sec-s'>Your basic details</div></div></div><div class='hol-grid hol-name'><label class='hol-field'><span>Prefix</span>{{field:prefix}}</label><label class='hol-field'><span>First name *</span>{{field:first_name}}</label><label class='hol-field'><span>Last name *</span>{{field:last_name}}</label></div><div class='hol-grid hol-2'><label class='hol-field'><span>Mobile number</span>{{field:mobile}}</label><label class='hol-field'><span>Email *</span>{{field:email}}</label></div><div class='hol-grid hol-2'><label class='hol-field'><span>Country of residence</span>{{field:country}}</label><label class='hol-field'><span>Language level</span>{{field:language_level}}</label></div></section><section><div class='hol-sec'><div class='hol-sec-icon'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z'/><circle cx='12' cy='10' r='3'/></svg></div><div><div class='hol-sec-t'>Holiday Destination</div><div class='hol-sec-s'>Where would you like to go?</div></div></div><div class='hol-grid hol-2'><label class='hol-field'><span>Destination *</span>{{field:destination}}</label><label class='hol-field'><span>Duration</span>{{field:duration}}</label></div><label class='hol-field hol-wide'><span>Travel type *</span>{{field:travel_type}}</label></section><section><div class='hol-sec'><div class='hol-sec-icon'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M22 10 12 5 2 10l10 5 10-5z'/><path d='M6 12v5c3 3 9 3 12 0v-5'/></svg></div><div><div class='hol-sec-t'>Programme</div><div class='hol-sec-s'>Select your preferred track</div></div></div><label class='hol-field hol-wide'><span class='hol-hide'>Programme</span>{{field:programme}}</label><div class='hol-grid hol-2'><label class='hol-field'><span>Preferred start</span>{{field:start_month}}</label><label class='hol-field'><span>Accommodation</span>{{field:accommodation}}</label></div></section><section><div class='hol-sec'><div class='hol-sec-icon'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8'/></svg></div><div><div class='hol-sec-t'>Interests</div><div class='hol-sec-s'>Pick what excites you (optional)</div></div></div><label class='hol-field hol-wide'><span class='hol-hide'>Interests</span>{{field:interests}}</label></section><section><div class='hol-sec'><div class='hol-sec-icon'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='3' y='5' width='18' height='16' rx='2'/><path d='M16 3v4M8 3v4M3 11h18'/></svg></div><div><div class='hol-sec-t'>Motivation</div><div class='hol-sec-s'>Tell us about your goals (optional)</div></div></div><label class='hol-field hol-wide'><span class='hol-hide'>Motivation</span>{{field:motivation}}</label></section><section class='hol-consent'><label class='hol-field hol-consent-item'><span>Newsletter</span>{{field:newsletter}}</label><label class='hol-field hol-consent-item'><span>Terms</span>{{field:terms}}</label></section><button class='hol-submit' type='submit' style=\"background:var(--hol-primary)!important;color:va