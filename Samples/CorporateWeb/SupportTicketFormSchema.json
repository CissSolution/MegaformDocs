{
  "version": "1.0",
  "fields": [
    {
      "key": "full_name",
      "type": "Text",
      "label": "Full Name",
      "placeholder": "Enter your full name",
      "required": true,
      "order": 1,
      "pageIndex": 0,
      "width": "100%",
      "prefillParam": "name"
    },
    {
      "key": "email",
      "type": "Email",
      "label": "Email Address",
      "placeholder": "you@example.com",
      "required": true,
      "order": 2,
      "pageIndex": 0,
      "width": "100%",
      "prefillParam": "email"
    },
    {
      "key": "category",
      "type": "Select",
      "label": "Issue Category",
      "required": true,
      "order": 3,
      "pageIndex": 0,
      "options": [
        { "label": "-- Please select --", "value": "", "disabled": true },
        { "label": "Account access", "value": "account" },
        { "label": "Billing", "value": "billing" },
        { "label": "Bug report", "value": "bug" },
        { "label": "Feature request", "value": "feature" },
        { "label": "Other", "value": "other" }
      ]
    },
    {
      "key": "priority",
      "type": "Radio",
      "label": "Priority",
      "required": true,
      "order": 4,
      "pageIndex": 0,
      "options": [
        { "label": "Low", "value": "low" },
        { "label": "Medium", "value": "medium" },
        { "label": "High", "value": "high" }
      ]
    },
    {
      "key": "subject",
      "type": "Text",
      "label": "Subject",
      "placeholder": "Short summary of your issue",
      "required": true,
      "order": 5,
      "pageIndex": 0,
      "width": "100%"
    },
    {
      "key": "message",
      "type": "Textarea",
      "label": "Message",
      "placeholder": "Describe your issue in detail...",
      "required": true,
      "order": 6,
      "pageIndex": 0,
      "validation": {
        "minLength": 10,
        "maxLength": 2000
      }
    },
    {
      "key": "attachment",
      "type": "File",
      "label": "Attachment (optional)",
      "order": 7,
      "pageIndex": 0,
      "fileSettings": {
        "maxSizeMB": 5,
        "allowedExtensions": [".png", ".jpg", ".jpeg", ".pdf"],
        "maxFiles": 2
      }
    },
    {
      "key": "case_id",
      "type": "Hidden",
      "label": "Case ID",
      "order": 99,
      "pageIndex": 0,
      "prefillParam": "case"
    }
  ],
  "pages": [
    { "index": 0, "title": "Support Ticket", "description": "How can we help?" }
  ],
  "settings": {
    "multiPage": false,
    "showProgressBar": false,
    "showPageTitles": false,
    "honeypotFieldName": "__mf_hp",
    "rateLimitWindowMinutes": 5,
    "rateLimitMaxPerWindow": 3,
    "enableAnalytics": true,
    "labelPosition": "top",
    "formWidth": "100%",
    "saveAndContinueDays": 7
  }
}
