<Project Sdk="Microsoft.NET.Sdk">

  <!--
    [CloudStorage v20260723-01] Optional cloud storage providers that carry heavy SDK
    dependencies (AWSSDK.S3, Azure.Storage.Blobs) so MegaForm.Core stays dependency-light.
    Providers implement MegaForm.Core.Integrations.Storage.IStorageProvider directly and are
    stateless — SDK clients are created per operation from StorageConnectionSettings, which
    keeps DI trivial on every host (singleton registration / manual new on DNN).

    Credential mapping (StorageConnectionSettings):
      AmazonS3   : ClientId = access key id, ClientSecret = secret access key,
                   BaseFolder = bucket, Extra["Region"] (default us-east-1),
                   BaseUrl = optional service URL for S3-compatible storage (MinIO, R2...).
      AzureBlob  : ClientSecret = storage connection string, BaseFolder = container name.
  -->
  <PropertyGroup>
    <TargetFrameworks>net472;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>MegaForm.Integrations.CloudStorage</AssemblyName>
    <RootNamespace>MegaForm.Integrations.CloudStorage</RootNamespace>
    <Description>MegaForm cloud storage provider (Amazon S3) — optional add-on for MegaForm.Core.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>MegaForm.Integrations.CloudStorage</PackageId>
    <Version>1.0.0</Version>
    <Authors>MegaForm Team</Authors>
    <Company>MegaForm</Company>
    <Copyright>© 2026 MegaForm. All rights reserved.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://megaform.github.io/MegaFormSolution</PackageProjectUrl>
    <RepositoryUrl>https://github.com/megaform/MegaFormSolution.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>megaform;forms;storage;s3;cloud</PackageTags>
    <PackageReleaseNotes>MegaForm.Integrations.CloudStorage 1.0.0: Amazon S3 IStorageProvider implementation for MegaForm file uploads.</PackageReleaseNotes>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Match MegaForm.Core: net472 leg is locked to C# 7.3 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0'">
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <LangVersion>13</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MegaForm.Core\MegaForm.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.4" />
    <!-- [AzureBlobRemoved v20260726] Azure.Storage.Blobs dropped: it pulled Azure.Core 1.55 →
         System.ClientModel + .NET 10 System.* transitively, which DNN's net472 bin does not carry
         and crashed the whole DNN site at startup (MEF attribute scan). Azure Blob mirroring is
         gone; Google Drive + Amazon S3 storage providers remain. -->
  </ItemGroup>

</Project>
