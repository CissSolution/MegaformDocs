@{
    var portalId = DotNetNuke.Entities.Portals.PortalSettings.Current == null
        ? 0 : DotNetNuke.Entities.Portals.PortalSettings.Current.PortalId;
    var activeTab = DotNetNuke.Entities.Portals.PortalSettings.Current == null
        ? null : DotNetNuke.Entities.Portals.PortalSettings.Current.ActiveTab;
    var adminBaseUrl = activeTab == null
        ? Request.RawUrl : DotNetNuke.Common.Globals.NavigateURL(activeTab.TabID);
    var editorialUrl = adminBaseUrl + "?view=editorial";
    var commentsUrl = adminBaseUrl + "?view=comments";
    var analyticsUrl = adminBaseUrl + "?view=analytics";
    var authorsUrl = adminBaseUrl + "?view=authors";
    var settingsUrl = adminBaseUrl + "?view=settings";
    var categoriesUrl = adminBaseUrl + "?view=categories";
    var mediaUrl = adminBaseUrl + "?view=media";
    var templatesUrl = adminBaseUrl + "?view=templates";
    var formatsUrl = adminBaseUrl + "?view=formats";
    var newPostUrl = adminBaseUrl + "?edit=0";
    var blogUrl = "/Blogs";
    var user = DotNetNuke.Entities.Users.UserController.Instance.GetCurrentUserInfo();
    // DNN's service locator is process-wide, so it deliberately does not capture a
    // request user. Carry the complete actor in the SDK scope: workflow role queues
    // must see the same identity that passed the DNN page permission check.
    var scope = new MegaFormScope
    {
        PortalId = portalId,
        UserId = user == null ? 0 : user.UserID,
        UserName = user == null ? "" : user.Username,
        DisplayName = user == null ? "" : user.DisplayName,
        UserEmail = user == null ? "" : user.Email,
        IsAuthenticated = user != null && user.UserID >= 0,
        IsAdmin = user != null && (user.IsSuperUser || user.IsInRole("Administrators")),
        IsSuperUser = user != null && user.IsSuperUser,
        Roles = user == null || user.Roles == null ? new List<string>() : user.Roles.ToList(),
        IpAddress = Request.UserHostAddress ?? ""
    };
    var allowed = CanManage(user);
    var csrfToken = allowed ? EnsureCsrfToken() : "";
    var message = "";
    var messageError = false;

    AppDto app = null;
    AppRecordDto editing = null;
    var creatingNew = false;
    InboxBoardDto board = null;
    AppQueryResultDto queue = null;
    IReadOnlyList<FileDto> editingFiles = new List<FileDto>();
    IReadOnlyList<GalleryItemDto> postImages = new List<GalleryItemDto>();
    IReadOnlyList<GalleryItemDto> authorImages = new List<GalleryItemDto>();
    var commentsFormId = 0;
    var commentRows = new List<Tuple<SubmissionListItemDto, AppRecordDto>>();

    // Bounded admin scan. The comment child form has no named query, so the console reads
    // a capped page of submissions and resolves typed values per row; it never parses DataJson.
    const int CommentScanCap = 60;
    var commentScanTruncated = false;

    if (allowed && Request.HttpMethod == "POST")
    {
        try
        {
            ValidateCsrfToken(Request.Form["mfb_csrf"]);
            var actionToken = (Request.Form["mfb_action"] ?? "").Trim();
            var separator = actionToken.IndexOf('|');
            var action = (separator < 0 ? actionToken : actionToken.Substring(0, separator)).ToLowerInvariant();
            var actionArgument = separator < 0 ? "" : actionToken.Substring(separator + 1);
            var submissionId = 0;
            int.TryParse(Request.Form["submission_id"], out submissionId);

            if (action == "create")
            {
                // The named query result carries the posts form id, so there is no manifest
                // guessing: the same trick AdminNewPost.razor uses on Oqtane.
                var probeResult = Run(c => c.Queries.ExecuteAsync("blog-starter", "all-posts",
                    new AppQueryRequest { Page = 1, PageSize = 1 }, scope));
                var postsFormId = probeResult == null ? 0 : probeResult.FormId;
                var userName = user == null || string.IsNullOrWhiteSpace(user.DisplayName)
                    ? "MegaForm Editorial" : user.DisplayName;
                var userEmail = user == null ? "" : (user.Email ?? "");

                // The 7 fields the editor collects...
                var newValues = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
                foreach (var key in new[] { "title", "excerpt", "body", "category", "tags",
                                            "featured_image_url", "image_alt_text", "author_name",
                                            "author_avatar_url", "seo_title", "seo_description",
                                            "meta_keywords", "canonical_url", "social_title",
                                            "social_description", "og_image_url",
                                            "content_type", "status" })
                {
                    var raw = (Request.Form[key] ?? "").Trim();
                    if (raw.Length > 0) { newValues[key] = raw; }
                }

                // ...and the required ones it does not, seeded exactly like the Oqtane twin.
                var chosenStatus = (Request.Form["status"] ?? "draft").Trim();
                if (chosenStatus.Length == 0) { chosenStatus = "draft"; }
                newValues["status"] = chosenStatus;
                if (!newValues.ContainsKey("content_type")) { newValues["content_type"] = "Blog Post"; }
                newValues["audience"] = "Public";
                newValues["language"] = "en-US";
                // The editor has a real date box now; today is only the fallback.
                var newPublish = NormalizeDate(Request.Form["publish_date"], "Publish date");
                newValues["publish_date"] = newPublish.Length > 0
                    ? newPublish
                    : DateTime.UtcNow.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                foreach (var key in new[] { "embargo_until", "expiry_date" })
                {
                    var when = NormalizeDate(Request.Form[key], key);
                    if (when.Length > 0) { newValues[key] = when; }
                }
                foreach (var flag in new[] { "is_featured", "newsletter_featured", "rss_enabled" })
                {
                    newValues[flag] = string.Equals(Request.Form[flag], "true", StringComparison.OrdinalIgnoreCase)
                        ? "true" : "false";
                }
                if (!IsSafeUrl(Request.Form["canonical_url"]) || !IsSafeUrl(Request.Form["og_image_url"]))
                {
                    throw new InvalidOperationException("The canonical URL and social image must be a site-relative path or an http(s) URL.");
                }
                if (!newValues.ContainsKey("author_name")) { newValues["author_name"] = userName; }
                newValues["author_email"] = userEmail;
                newValues["category_uid"] = CategoryUid(Request.Form["category"] ?? "");
                // An unchecked checkbox posts nothing, so write the field either way. The schema
                // default is "false": leaving it unset shipped every new post with comments off.
                newValues["allow_comments"] =
                    string.Equals(Request.Form["allow_comments"], "true", StringComparison.OrdinalIgnoreCase)
                        ? "true" : "false";
                // The public thread gate reads this too; a new post opens its thread.
                newValues["moderation_status"] = "Open";

                if (postsFormId <= 0)
                {
                    message = "The posts form for this app could not be found.";
                    messageError = true;
                }

                var wantedSlug = (Request.Form["slug"] ?? "").Trim();
                if (wantedSlug.Length == 0) { wantedSlug = (Request.Form["title"] ?? "").Trim(); }
                var freeSlug = postsFormId <= 0 ? null : ClaimFreeSlug(wantedSlug, scope);
                if (postsFormId <= 0)
                {
                    // message already set above
                }
                else if (freeSlug == null)
                {
                    message = "That slug is already taken and a free variant could not be found.";
                    messageError = true;
                }
                else
                {
                    newValues["slug"] = freeSlug;
                    var created = Run(c => c.Submissions.SubmitAsync(postsFormId, newValues, scope));
                    if (created == null || !created.Success)
                    {
                        message = created == null || string.IsNullOrWhiteSpace(created.ErrorMessage)
                            ? "The post could not be saved." : created.ErrorMessage;
                        messageError = true;
                    }
                    else
                    {
                        // ðŸ”´ SubmitAsync writes the typed `status` field but leaves
                        // MF_Submissions.Status at whatever the form pipeline assigned. Named
                        // queries filter that MASTER column, so a post created as "published"
                        // would be invisible to public-posts. PatchRecordAsync updates both, so
                        // patch the status straight back over itself to reconcile them.
                        Run(c => c.Records.PatchRecordAsync(created.SubmissionId,
                            new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
                            { ["status"] = chosenStatus }, scope));

                        EnsureUniquePostUid(created.SubmissionId, scope);

                        editing = Run(c => c.Records.GetRecordAsync(created.SubmissionId, scope));
                        message = "Post created (#" + created.SubmissionId + ") as " + chosenStatus + ".";
                        messageError = false;
                    }
                }
            }
            else if (action == "save" && submissionId > 0)

            {
                var values = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
                {
                    ["title"] = Request.Form["title"] ?? "",
                    ["slug"] = Request.Form["slug"] ?? "",
                    ["excerpt"] = Request.Form["excerpt"] ?? "",
                    ["body"] = Request.Form["body"] ?? "",
                    ["category"] = Request.Form["category"] ?? "",
                    ["tags"] = Request.Form["tags"] ?? "",
                    ["featured_image_url"] = Request.Form["featured_image_url"] ?? "",
                    ["image_alt_text"] = Request.Form["image_alt_text"] ?? "",
                    ["author_name"] = Request.Form["author_name"] ?? "",
                    ["author_avatar_url"] = Request.Form["author_avatar_url"] ?? "",
                    ["seo_title"] = Request.Form["seo_title"] ?? "",
                    ["seo_description"] = Request.Form["seo_description"] ?? "",
                    // Unchecked checkboxes post nothing, so this is written on every save.
                    ["allow_comments"] =
                        string.Equals(Request.Form["allow_comments"], "true", StringComparison.OrdinalIgnoreCase)
                            ? "true" : "false"
                };

                // Status and content type were rendered by the editor but never saved, so both
                // boxes were decorative on an existing post. They are written now â€” which is only
                // safe because the lists above are complete and preselected from the record: a
                // save that touches neither box re-writes the value the post already had.
                // PatchRecordAsync mirrors "status" onto MF_Submissions.Status, the column every
                // named query filters, so this also reconciles the two if they ever drifted.
                var postedStatus = (Request.Form["status"] ?? "").Trim();
                if (postedStatus.Length > 0) { values["status"] = postedStatus; }
                var postedContentType = (Request.Form["content_type"] ?? "").Trim();
                if (postedContentType.Length > 0) { values["content_type"] = postedContentType; }

                // SEO / social / scheduling. Declared by the schema since day one, never editable.
                if (!IsSafeUrl(Request.Form["canonical_url"]) || !IsSafeUrl(Request.Form["og_image_url"]))
                {
                    throw new InvalidOperationException("The canonical URL and social image must be a site-relative path or an http(s) URL.");
                }
                foreach (var key in SeoKeys)
                {
                    values[key] = (Request.Form[key] ?? "").Trim();
                }
                foreach (var key in ScheduleKeys)
                {
                    var when = NormalizeDate(Request.Form[key], key);
                    // ðŸ”´ An empty publish_date is never written back. Every public list sorts on it,
                    // so blanking it would drop the post out of the blog â€” clearing an embargo or an
                    // expiry is a real intent, clearing the publication date is not.
                    if (key == "publish_date" && when.Length == 0) { continue; }
                    values[key] = when;
                }
                foreach (var flag in new[] { "is_featured", "newsletter_featured", "rss_enabled" })
                {
                    values[flag] = string.Equals(Request.Form[flag], "true", StringComparison.OrdinalIgnoreCase)
                        ? "true" : "false";
                }
                editing = Run(c => c.Records.PatchRecordAsync(submissionId, values, scope));
                message = editing == null ? "The post no longer exists." : "Typed blog record saved.";
                messageError = editing == null;
            }
            else if ((action == "capprove" || action == "cspam" || action == "chide") && !string.IsNullOrWhiteSpace(actionArgument))
            {
                var commentId = 0;
                int.TryParse(actionArgument, out commentId);
                var moderationFormId = ResolveCommentsFormId(scope);
                var target = commentId > 0 ? Run(c => c.Records.GetRecordAsync(commentId, scope)) : null;
                // Ownership check: only moderate rows that belong to this app's comment form.
                if (target == null || moderationFormId == 0 || target.FormId != moderationFormId)
                {
                    throw new InvalidOperationException("That comment does not belong to the Blog application.");
                }
                var next = action == "capprove" ? "approved" : action == "cspam" ? "spam" : "hidden";
                Run(c => c.Records.PatchRecordAsync(commentId, new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
                {
                    ["moderation_status"] = next
                }, scope));
                message = "Comment moved to " + next + ".";
            }
            else if ((action == "claim" || action == "approve" || action == "reject") && !string.IsNullOrWhiteSpace(actionArgument))
            {
                var blogRecords = Run(c => c.Queries.ExecuteAsync("blog-starter", "all-posts",
                    new AppQueryRequest { Page = 1, PageSize = 100 }, scope));
                var blogIds = new HashSet<int>();
                if (blogRecords != null && blogRecords.Items != null)
                {
                    foreach (var record in blogRecords.Items) { blogIds.Add(record.SubmissionId); }
                }
                var actionBoard = Run(c => c.Workflows.GetMyInboxAsync(new InboxQuery { RecentCompleted = 15 }, scope));
                var actionTask = actionBoard == null ? null
                    : actionBoard.Incoming.Concat(actionBoard.InProgress)
                        .FirstOrDefault(task => string.Equals(task.TaskId, actionArgument, StringComparison.OrdinalIgnoreCase));
                if (actionTask == null || !blogIds.Contains(actionTask.SubmissionId))
                {
                    throw new InvalidOperationException("This workflow task does not belong to the Blog application.");
                }
                var request = new InboxTaskActionRequest { TaskId = actionArgument, Comment = Request.Form["comment_" + actionArgument] };
                InboxTaskResultDto result;
                if (action == "claim") { result = Run(c => c.Workflows.ClaimAsync(request, scope)); }
                else if (action == "approve") { result = Run(c => c.Workflows.ApproveAsync(request, scope)); }
                else { result = Run(c => c.Workflows.RejectAsync(request, scope)); }
                message = result.Success ? "Workflow action completed." : (result.Error ?? "Workflow action failed.");
                messageError = !result.Success;
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageError = true;
        }
    }

    if (allowed)
    {
        try
        {
            app = Run(c => c.Apps.GetAppAsync("blog-starter", scope));
            board = Run(c => c.Workflows.GetMyInboxAsync(new InboxQuery { RecentCompleted = 15 }, scope));
            queue = Run(c => c.Queries.ExecuteAsync("blog-starter", "all-posts",
                new AppQueryRequest { Page = 1, PageSize = 100, Search = Request.QueryString["q"] }, scope));

            commentsFormId = ResolveCommentsFormId(scope);

            if (commentsFormId > 0)
            {
                var scan = Run(c => c.SubmissionDashboard.SearchAsync(
                    new SubmissionSearchQuery { FormId = commentsFormId, Page = 1, PageSize = CommentScanCap }, scope));
                if (scan != null && scan.Items != null)
                {
                    commentScanTruncated = scan.TotalCount > scan.Items.Count;
                    foreach (var row in scan.Items)
                    {
                        var typed = Run(c => c.Records.GetRecordAsync(row.SubmissionId, scope));
                        if (typed != null) { commentRows.Add(Tuple.Create(row, typed)); }
                    }
                }
            }

            var editId = 0;
            // ?edit=new opens the same editor with nothing in it. Reusing the edit form rather
            // than adding a screen keeps one set of markup, one CSRF path and one layout.
            // ðŸ”´ The trigger is "0", NOT "new". DNN rewrites ?edit=<v> into the path segment
            // /edit/<v>, and a NON-NUMERIC segment does not survive a form post: /edit/838 posts
            // back fine, /edit/new silently never reaches this handler - no POST, no message, and
            // the form just sits there looking broken. Measured 2026-07-31 by proving the existing
            // save path works on /edit/838 while create did nothing on /edit/new.
            var editRaw = (Request.QueryString["edit"] ?? "").Trim();
            creatingNew = editRaw == "0"
                          || string.Equals(editRaw, "new", StringComparison.OrdinalIgnoreCase);
            int.TryParse(Request.QueryString["edit"], out editId);
            if (editing == null && editId > 0) { editing = Run(c => c.Records.GetRecordAsync(editId, scope)); }
            if (editing != null)
            {
                editingFiles = Run(c => c.Files.ListForSubmissionAsync(editing.SubmissionId, scope));
                var postGallery = Run(c => c.Gallery.QueryGalleryAsync(new GalleryQueryRequest
                {
                    AppKey = "blog-starter",
                    QueryKey = "all-posts",
                    Query = new AppQueryRequest { Page = 1, PageSize = 100 },
                    ImageFieldKeys = new List<string> { "featured_image_url", "og_image_url", "author_avatar_url" },
                    TitleFieldKey = "title",
                    AltTextFieldKey = "image_alt_text",
                    CaptionFieldKey = "media_caption",
                    // The post library is a typed URL gallery. Attachments for the current
                    // record remain visible below through IFileApi; avoiding a per-record
                    // file lookup keeps the editorial page fast.
                    IncludeUploadedImages = false
                }, scope));
                var galleryItems = postGallery == null ? new List<GalleryItemDto>() : postGallery.Items.ToList();
                postImages = galleryItems.Where(i => !string.Equals(i.FieldKey, "author_avatar_url", StringComparison.OrdinalIgnoreCase)).ToList();
                authorImages = galleryItems.Where(i => string.Equals(i.FieldKey, "author_avatar_url", StringComparison.OrdinalIgnoreCase)).ToList();
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageError = true;
        }
    }

    var posts = queue == null || queue.Items == null ? new List<AppRecordDto>() : queue.Items.ToList();
    var totalPosts = queue == null ? 0 : queue.TotalCount;
    var totalReads = posts.Sum(p => Num(p, "view_count"));
    var uniqueReaders = posts.Sum(p => Num(p, "unique_readers"));
    var publishedThisMonth = posts.Count(p =>
    {
        DateTime when;
        return DateTime.TryParse(Text(p, "publish_date", ""), CultureInfo.InvariantCulture, DateTimeStyles.None, out when)
            && when.Year == DateTime.UtcNow.Year && when.Month == DateTime.UtcNow.Month;
    });
    var authors = posts.Select(p => Text(p, "author_name", "")).Where(a => !string.IsNullOrWhiteSpace(a))
        .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    var pendingComments = commentRows.Where(c => string.Equals(Text(c.Item2, "moderation_status", "pending"), "pending", StringComparison.OrdinalIgnoreCase)).ToList();
    var flaggedComments = commentRows.Count(c => c.Item1.IsSpam);
    var totalComments = commentRows.Count > 0 ? commentRows.Count : posts.Sum(p => Num(p, "comment_count"));
    var postsById = posts.ToDictionary(p => Text(p, "post_uid", "#" + p.SubmissionId), p => p, StringComparer.OrdinalIgnoreCase);
    var recentPosts = posts.OrderByDescending(p => p.SubmittedOnUtc).Take(5).ToList();
    var topPosts = posts.OrderByDescending(p => Num(p, "view_count")).Take(5).ToList();
    var topMax = topPosts.Count == 0 ? 1 : Math.Max(1, Num(topPosts[0], "view_count"));
}

<link rel="stylesheet" href="/DesktopModules/MegaForm/Assets/css/plugins/megaform-widget-rich-text.css?v=20260729a" />
<link rel="stylesheet" href="/DesktopModules/MegaFormBlogs/Assets/megaform-blogs-admin.css?v=20260809j" />

<div class="mfba">
    @if (!allowed)
    {
        <header class="mfba-head">
            <div class="mfba-head-row"><div><h1>Editorial access required</h1><p>Sign in with a Blog or Administrator role to manage posts.</p></div></div>
        </header>
    }
    else
    {
        <header class="mfba-head">
            <nav class="mfba-crumb" aria-label="Breadcrumb">
                <a href="@blogUrl">Blog</a>@Icon("chevron-right", "mfba-icon mfba-icon-md")<strong>Admin Dashboard</strong>
            </nav>
            <div class="mfba-head-row">
                <div>
                    <h1>Admin Dashboard</h1>
                    <p>Overview of your blog performance and content pipeline</p>
                </div>
                <div class="mfba-head-actions">
                    <label class="mfba-sr" for="mfba-q">Search posts and authors</label>
                    <span class="mfba-field">
                        @Icon("search")
                        <input id="mfba-q" value="@Request.QueryString["q"]" placeholder="Search posts, authors..."
                               onkeydown="if(event.key==='Enter'){event.preventDefault();document.getElementById('mfba-go').click();}" />
                    </span>
                    <button id="mfba-go" type="button" class="mfba-sr"
                            onclick="var q=document.getElementById('mfba-q').value.trim();window.location.href='@adminBaseUrl'+(q?'?q='+encodeURIComponent(q):'');">Search</button>
                    @* The bell was a <button type="button"> with no handler: a red dot that could
                       not be clicked. It is the shortest path to the thing it is warning about. *@
                    <a class="mfba-bell" href="@(commentsUrl + "&tab=pending")"
                       title="@pendingComments.Count comment(s) awaiting moderation">
                        @Icon("bell", "mfba-icon mfba-icon-lg")
                        @if (pendingComments.Count > 0) { <span></span> }
                    </a>
                    @* This button said "New Post" and opened the comment queue. The TILE below was
                       corrected in 1.3.0; the header button was left pointing at commentsUrl. *@
                    <a class="mfba-btn" href="@newPostUrl">@Icon("plus") New Post</a>
                </div>
            </div>
        </header>

        <input type="hidden" name="mfb_csrf" value="@csrfToken" />

        <main class="mfba-body">
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="mfba-notice @(messageError ? "err" : "ok")">@message</div>
            }

            <section class="mfba-stats" aria-label="Blog key figures">
                <div class="mfba-stat">
                    <div class="mfba-stat-top">
                        <span class="mfba-stat-chip mfba-c-blue">@Icon("file-text")</span>
                        <span class="mfba-trend up">@Icon("trending-up", "mfba-icon mfba-icon-sm")+@publishedThisMonth</span>
                    </div>
                    <p class="mfba-stat-value">@totalPosts.ToString("N0", CultureInfo.InvariantCulture)</p>
                    <p class="mfba-stat-label">Total Articles</p>
                    <p class="mfba-stat-sub">@publishedThisMonth articles this month</p>
                </div>
                <div class="mfba-stat">
                    <div class="mfba-stat-top">
                        <span class="mfba-stat-chip mfba-c-emerald">@Icon("eye")</span>
                        <span class="mfba-trend up" title="Unique readers">@Icon("trending-up", "mfba-icon mfba-icon-sm")@Compact(uniqueReaders)</span>
                    </div>
                    <p class="mfba-stat-value">@Compact(totalReads)</p>
                    <p class="mfba-stat-label">Total Reads</p>
                    <p class="mfba-stat-sub">@Compact(uniqueReaders) unique readers</p>
                </div>
                <div class="mfba-stat">
                    <div class="mfba-stat-top">
                        <span class="mfba-stat-chip mfba-c-violet">@Icon("message-circle")</span>
                        <span class="mfba-trend @(pendingComments.Count > 0 ? "down" : "up")">
                            @Icon(pendingComments.Count > 0 ? "trending-down" : "trending-up", "mfba-icon mfba-icon-sm")@pendingComments.Count
                        </span>
                    </div>
                    <p class="mfba-stat-value">@totalComments.ToString("N0", CultureInfo.InvariantCulture)</p>
                    <p class="mfba-stat-label">Comments</p>
                    <p class="mfba-stat-sub">awaiting moderation: @pendingComments.Count</p>
                </div>
                <div class="mfba-stat">
                    <div class="mfba-stat-top">
                        <span class="mfba-stat-chip mfba-c-amber">@Icon("users")</span>
                        <span class="mfba-trend @(flaggedComments > 0 ? "down" : "up")">
                            @Icon(flaggedComments > 0 ? "trending-down" : "trending-up", "mfba-icon mfba-icon-sm")@flaggedComments
                        </span>
                    </div>
                    <p class="mfba-stat-value">@authors.Count</p>
                    <p class="mfba-stat-label">Active Authors</p>
                    <p class="mfba-stat-sub">@flaggedComments comment(s) flagged as spam</p>
                </div>
            </section>

            <section class="mfba-quick" aria-label="Quick access">
                <a href="@(adminBaseUrl + "?edit=0")"><span class="mfba-quick-ico mfba-bg-blue">@Icon("plus")</span><strong>New Post</strong><small>Create a new article</small></a>
                <a href="@commentsUrl"><span class="mfba-quick-ico mfba-bg-violet">@Icon("message-circle")</span><strong>Comments</strong><small>@pendingComments.Count pending review</small></a>
                <a href="@editorialUrl"><span class="mfba-quick-ico mfba-bg-amber">@Icon("layout")</span><strong>Editorial</strong><small>Kanban board</small></a>
                @* These three used to be decorative: Analytics opened the public blog, Authors
                   opened the kanban and Settings linked to this same page. They are real screens
                   now (?view=analytics|authors|settings, whitelisted in MegaFormBlogsAdminHost). *@
                <a href="@analyticsUrl"><span class="mfba-quick-ico mfba-bg-emerald">@Icon("bar-chart")</span><strong>Analytics</strong><small>View performance</small></a>
                <a href="@authorsUrl"><span class="mfba-quick-ico mfba-bg-pink">@Icon("users")</span><strong>Authors</strong><small>@authors.Count contributors</small></a>
                <a href="@categoriesUrl"><span class="mfba-quick-ico mfba-bg-amber">@Icon("tag")</span><strong>Categories</strong><small>Categories &amp; tags</small></a>
                <a href="@templatesUrl"><span class="mfba-quick-ico mfba-bg-violet">@Icon("layout")</span><strong>Templates</strong><small>Render templates</small></a>
                <a href="@formatsUrl"><span class="mfba-quick-ico mfba-bg-pink">@Icon("image")</span><strong>Formats</strong><small>Gallery and live</small></a>
                <a href="@settingsUrl"><span class="mfba-quick-ico mfba-bg-slate">@Icon("settings")</span><strong>Settings</strong><small>Blog configuration</small></a>
            </section>

            @if (editing != null || creatingNew)
            {
                <section class="mfba-panel">
                    <div class="mfba-panel-head">
                        <h2>@Icon("save", "mfba-icon mfba-icon-lg") @(editing == null ? "New post" : "Edit typed record #" + editing.SubmissionId)</h2>
                        <a class="mfba-panel-link" href="@adminBaseUrl">Close</a>
                    </div>
                    <div class="mfba-editor">
                        <input type="hidden" name="submission_id" value="@(editing == null ? 0 : editing.SubmissionId)" />
                        <div class="mfba-form-grid">
                            <label>Title<input name="title" value="@(editing == null ? "" : Text(editing, "title", ""))" required /></label>
                            <label>Slug@(editing == null ? " â€” leave blank to derive it from the title" : "")<input name="slug" value="@(editing == null ? "" : Text(editing, "slug", ""))" @(editing == null ? "" : "required") /></label>
                            <label>Category<input name="category" value="@(editing == null ? "" : Text(editing, "category", ""))" /></label>
                            <label>Author<input name="author_name" value="@(editing == null ? "" : Text(editing, "author_name", ""))" /></label>
                            <label class="wide">Excerpt<textarea name="excerpt" rows="3">@(editing == null ? "" : Text(editing, "excerpt", ""))</textarea></label>
                            <div class="wide mfba-rich" id="mfb-body-editor">
                                <label>Article body (trusted editorial HTML)<textarea name="body" rows="14">@(editing == null ? "" : Text(editing, "body", ""))</textarea></label>
                            </div>
                            <div class="wide mfba-media-field">
                                <label>Featured image URL<input name="featured_image_url" value="@(editing == null ? "" : Text(editing, "featured_image_url", ""))" /></label>
                                <button class="mfba-btn-outline" type="button" data-mfb-gallery-open="featured_image_url" data-mfb-gallery-tab="posts">@Icon("image", "mfba-icon mfba-icon-md") Browse gallery</button>
                            </div>
                            <label>Image alt text<input name="image_alt_text" value="@(editing == null ? "" : Text(editing, "image_alt_text", ""))" /></label>
                            <div class="mfba-media-field">
                                <label>Author avatar URL<input name="author_avatar_url" value="@(editing == null ? "" : Text(editing, "author_avatar_url", ""))" /></label>
                                <button class="mfba-btn-outline" type="button" data-mfb-gallery-open="author_avatar_url" data-mfb-gallery-tab="authors">@Icon("users", "mfba-icon mfba-icon-md") Author</button>
                            </div>
                            @* A new post can arrive with the column it was started from
                               (?edit=0&status=ready_to_publish from the kanban's + button).
                               Unknown values fall back to draft â€” the query string never chooses
                               a status the schema does not declare. *@
                            @{
                                var requestedStatus = (Request.QueryString["status"] ?? "").Trim().ToLowerInvariant();
                                if (!PostStatuses.Contains(requestedStatus)) { requestedStatus = "draft"; }
                                var statusValue = editing == null ? requestedStatus : Text(editing, "status", "draft");
                            }
                            <label>Status
                                <select name="status">@SelectOptions(PostStatuses, statusValue)</select>
                            </label>
                            <label>Content type
                                <select name="content_type">@SelectOptions(PostContentTypes,
                                    editing == null ? "Blog Post" : Text(editing, "content_type", "Blog Post"))</select>
                            </label>
                            @* ðŸ”´ The posts form declares allow_comments as a Select("true"/"false")
                               whose DEFAULT IS "false", and until now no console screen wrote it â€”
                               so a post created here came out with its comment thread shut and no
                               editor had any way to open it. That is the "comments are not enabled
                               on my posts" report. The public article page reads this same field. *@
                            @{
                                var allowRawNow = editing == null
                                    ? "true"
                                    : Text(editing, "allow_comments", "true").Trim().ToLowerInvariant();
                                var commentsAllowedNow = allowRawNow != "false" && allowRawNow != "0" && allowRawNow != "no";
                            }
                            <label class="mfba-check">
                                @if (commentsAllowedNow)
                                {
                                    <input type="checkbox" name="allow_comments" value="true" checked="checked" />
                                }
                                else
                                {
                                    <input type="checkbox" name="allow_comments" value="true" />
                                }
                                <span>Allow comments on this post<small>Readers can post from the article; every comment still waits for moderation.</small></span>
                            </label>
                            <label>Tags<input name="tags" value="@(editing == null ? "" : Text(editing, "tags", ""))" /></label>
                        </div>

                        @* ---- publishing schedule -------------------------------------------
                           publish_date / embargo_until / expiry_date have been in the posts schema
                           since day one and no console screen ever showed them, so a post could
                           only ever be dated "today" by the create handler. embargo_until is what
                           MegaForm.Core ScheduledPublishService waits for before flipping a
                           scheduled post to published. *@
                        @{
                            var pubDate = editing == null
                                ? DateTime.UtcNow.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                                : DateInput(editing, "publish_date");
                            var embargoDate = editing == null ? "" : DateInput(editing, "embargo_until");
                            var expiryDate = editing == null ? "" : DateInput(editing, "expiry_date");
                            var isFeatured = editing != null
                                && string.Equals(Text(editing, "is_featured", "false"), "true", StringComparison.OrdinalIgnoreCase);
                            var inNewsletter = editing != null
                                && string.Equals(Text(editing, "newsletter_featured", "false"), "true", StringComparison.OrdinalIgnoreCase);
                            var inRss = editing == null
                                || string.Equals(Text(editing, "rss_enabled", "true"), "true", StringComparison.OrdinalIgnoreCase);
                        }
                        <div class="mfba-subhead">@Icon("calendar", "mfba-icon mfba-icon-md") Publishing</div>
                        <div class="mfba-form-grid">
                            <label>Publish date<input name="publish_date" type="date" value="@pubDate" /></label>
                            <label>Embargo until <small>optional</small><input name="embargo_until" type="date" value="@embargoDate" /></label>
                            <label>Expires on <small>optional</small><input name="expiry_date" type="date" value="@expiryDate" /></label>
                            <label class="mfba-check">
                                @if (isFeatured)
                                {
                                    <input type="checkbox" name="is_featured" value="true" checked="checked" />
                                }
                                else
                                {
                                    <input type="checkbox" name="is_featured" value="true" />
                                }
                                <span>Featured<small>Marks the card with a Featured badge.</small></span>
                            </label>
                            <label class="mfba-check">
                                @if (inNewsletter)
                                {
                                    <input type="checkbox" name="newsletter_featured" value="true" checked="checked" />
                                }
                                else
                                {
                                    <input type="checkbox" name="newsletter_featured" value="true" />
                                }
                                <span>Newsletter pick<small>Stored for a newsletter build; nothing sends mail today.</small></span>
                            </label>
                            <label class="mfba-check">
                                @if (inRss)
                                {
                                    <input type="checkbox" name="rss_enabled" value="true" checked="checked" />
                                }
                                else
                                {
                                    <input type="checkbox" name="rss_enabled" value="true" />
                                }
                                <span>Include in RSS<small>Stored for a feed reader; no feed endpoint yet.</small></span>
                            </label>
                        </div>

                        @* ---- SEO and social ------------------------------------------------- *@
                        @{
                            var seoTitle = editing == null ? "" : Text(editing, "seo_title", "");
                            var seoDescription = editing == null ? "" : Text(editing, "seo_description", "");
                            var metaKeywords = editing == null ? "" : Text(editing, "meta_keywords", "");
                            var canonical = editing == null ? "" : Text(editing, "canonical_url", "");
                            var socialTitle = editing == null ? "" : Text(editing, "social_title", "");
                            var socialDescription = editing == null ? "" : Text(editing, "social_description", "");
                            var socialImage = editing == null ? "" : Text(editing, "og_image_url", "");
                        }
                        <div class="mfba-subhead">@Icon("search", "mfba-icon mfba-icon-md") SEO and social</div>
                        <div class="mfba-serp" id="mfba-serp">
                            <span class="mfba-serp-label">Search result preview</span>
                            <span class="mfba-serp-url" id="mfba-serp-url"></span>
                            <span class="mfba-serp-title" id="mfba-serp-title"></span>
                            <span class="mfba-serp-desc" id="mfba-serp-desc"></span>
                            <span class="mfba-serp-note">
                                Falls back to the post title and excerpt while the SEO fields are empty, which is
                                what a search engine would show.
                            </span>
                        </div>
                        <div class="mfba-form-grid">
                            <label>SEO title <small id="mfba-serp-tc"></small>
                                <input name="seo_title" maxlength="120" data-mfba-serp="title" value="@seoTitle" />
                            </label>
                            <label>Canonical URL <small>optional</small>
                                <input name="canonical_url" maxlength="500" value="@canonical" />
                            </label>
                            <label class="wide">SEO description <small id="mfba-serp-dc"></small>
                                <textarea name="seo_description" rows="2" maxlength="320" data-mfba-serp="desc">@seoDescription</textarea>
                            </label>
                            <label class="wide">Meta keywords <small>comma separated</small>
                                <input name="meta_keywords" maxlength="300" value="@metaKeywords" />
                            </label>
                            <label>Social title <small>og:title</small>
                                <input name="social_title" maxlength="120" value="@socialTitle" />
                            </label>
                            <label>Social image URL <small>og:image</small>
                                <input name="og_image_url" maxlength="500" value="@socialImage" />
                            </label>
                            <label class="wide">Social description <small>og:description</small>
                                <textarea name="social_description" rows="2" maxlength="320">@socialDescription</textarea>
                            </label>
                        </div>
                        <p class="mfba-hint">
                            These are stored on the post and ready for a head renderer; the public page does not
                            emit meta tags yet, so treat them as content you are preparing rather than something
                            live today.
                        </p>
                        <div class="mfba-editor-toolbar">
                            <button class="mfba-btn-outline" type="button" data-mfb-gallery-open="body" data-mfb-gallery-tab="posts">@Icon("image", "mfba-icon mfba-icon-md") Insert gallery image into article</button>
                            <span>Images stay typed values or MegaForm-managed files; the editor saves clean HTML through the Records API.</span>
                        </div>
                        @if (editing == null)
                        {
                            <button class="mfba-btn" type="submit" name="mfb_action" value="create">@Icon("plus", "mfba-icon mfba-icon-md") Create post</button>
                        }
                        else
                        {
                            <button class="mfba-btn" type="submit" name="mfb_action" value="save">@Icon("save", "mfba-icon mfba-icon-md") Save through Records API</button>
                        }
                    </div>
                    @if (editingFiles.Count > 0)
                    {
                        <div class="mfba-files"><strong>Managed by MegaForm Files API:</strong>
                            @foreach (var file in editingFiles)
                            {
                                <a href="/DesktopModules/MegaForm/API/SdkDemo/Download?submissionId=@editing.SubmissionId&amp;fileId=@file.FileId">@file.FileName</a>
                            }
                        </div>
                    }
                    <div id="mfb-gallery-dialog" class="mfba-dialog" role="dialog" aria-modal="true" aria-labelledby="mfb-gallery-title" hidden>
                        <div class="mfba-dialog-backdrop" data-mfb-gallery-close></div>
                        <section class="mfba-sheet">
                            <header>
                                <h2 id="mfb-gallery-title">Choose an image</h2>
                                <button type="button" class="mfba-iconbtn" data-mfb-gallery-close aria-label="Close gallery">&times;</button>
                            </header>
                            <div class="mfba-gallery-controls">
                                <div class="mfba-gallery-tabs" role="tablist" aria-label="Image source">
                                    <button type="button" role="tab" data-mfb-gallery-filter="posts">Post images <span>@postImages.Count</span></button>
                                    <button type="button" role="tab" data-mfb-gallery-filter="authors">Authors <span>@authorImages.Count</span></button>
                                </div>
                                <span class="mfba-field">@Icon("search")<input id="mfb-gallery-search" type="search" placeholder="Search by title, author or caption" aria-label="Search gallery" /></span>
                            </div>
                            <div class="mfba-gallery-grid">
                                @foreach (var image in postImages)
                                {
                                    <button type="button" class="mfba-gcard" data-mfb-gallery-kind="posts"
                                            data-mfb-gallery-title="@image.Title" data-mfb-gallery-alt="@image.AltText"
                                            data-mfb-gallery-search="@((image.Title ?? "") + " " + (image.Caption ?? "") + " " + (image.FileName ?? ""))">
                                        <span class="mfba-gthumb"><img src="@image.Url" alt="@image.AltText" loading="lazy" /></span>
                                        <strong>@(string.IsNullOrWhiteSpace(image.Title) ? "Untitled image" : image.Title)</strong>
                                        <small>@(image.Source == "uploaded-file" ? "MegaForm file" : "Typed image field")</small>
                                    </button>
                                }
                                @foreach (var image in authorImages)
                                {
                                    var authorRecord = posts.FirstOrDefault(r => r.SubmissionId == image.SubmissionId);
                                    var authorName = Text(authorRecord, "author_name", image.Title ?? "Unnamed author");
                                    <button type="button" class="mfba-gcard" data-mfb-gallery-kind="authors"
                                            data-mfb-gallery-title="@authorName" data-mfb-gallery-alt="@authorName"
                                            data-mfb-gallery-search="@(authorName + " " + (image.Caption ?? ""))">
                                        <span class="mfba-gthumb"><img src="@image.Url" alt="@authorName" loading="lazy" /></span>
                                        <strong>@authorName</strong>
                                        <small>Typed author image</small>
                                    </button>
                                }
                                <div class="mfba-gempty" hidden>No matching images.</div>
                            </div>
                            <footer><span id="mfb-gallery-status" aria-live="polite">Select an image to use it.</span></footer>
                        </section>
                    </div>
                </section>
            }

            <div class="mfba-grid">
                <div class="mfba-col">

                    <section class="mfba-panel">
                        <div class="mfba-panel-head">
                            <h2>@Icon("file-text", "mfba-icon mfba-icon-lg") Recent Posts</h2>
                            @* "View all POSTS" is the analytics register â€” every post, sortable â€”
                               not the kanban, which groups by editorial column. *@
                            <a class="mfba-panel-link" href="@(analyticsUrl + "&sort=date")">View All @Icon("chevron-right", "mfba-icon mfba-icon-md")</a>
                        </div>
                        <div class="mfba-thead">
                            <span>Post</span><span class="st">Status</span><span class="vw r">Views</span><span class="ac r">Actions</span>
                        </div>
                        <div class="mfba-rows">
                            @if (recentPosts.Count == 0)
                            {
                                <div class="mfba-empty">No typed blog records yet.</div>
                            }
                            @foreach (var post in recentPosts)
                            {
                                var statusKey = StatusKey(post);
                                var avatar = Text(post, "author_avatar_url", "");
                                var views = Num(post, "view_count");
                                <div class="mfba-trow">
                                    <div class="mfba-post">
                                        @if (!string.IsNullOrWhiteSpace(avatar))
                                        {
                                            <img src="@avatar" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="mfba-avatar">@Initials(Text(post, "author_name", "MegaForm"))</span>
                                        }
                                        <div style="min-width:0">
                                            <p class="mfba-post-title mfba-clamp1">@Text(post, "title", "Untitled story")</p>
                                            <div class="mfba-post-meta">
                                                <span>@Text(post, "author_name", "MegaForm Editorial")</span>
                                                <span class="sep">&middot;</span>
                                                <span>@Icon("tag", "mfba-icon mfba-icon-sm")@Text(post, "category", "Insights")</span>
                                                <span class="sep">&middot;</span>
                                                <span>@Icon("calendar", "mfba-icon mfba-icon-sm")@Text(post, "publish_date", post.SubmittedOnUtc.ToString("MMM d, yyyy", CultureInfo.InvariantCulture))</span>
                                            </div>
                                        </div>
                                    </div>
                                    <span class="mfba-pill mfba-st-@statusKey">@StatusLabel(statusKey)</span>
                                    <span class="mfba-views">@Icon("eye", "mfba-icon mfba-icon-md")@(views > 0 ? Compact(views) : "â€”")</span>
                                    <div class="mfba-actions">
                                        <a class="mfba-iconbtn" href="@adminBaseUrl?edit=@post.SubmissionId" title="Edit">@Icon("pencil", "mfba-icon mfba-icon-md")</a>
                                        <a class="mfba-iconbtn" href="@editorialUrl" title="Move to another editorial column">@Icon("layout", "mfba-icon mfba-icon-md")</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>

                    <section class="mfba-panel">
                        <div class="mfba-panel-head">
                            <h2>@Icon("message-circle", "mfba-icon mfba-icon-lg") Pending Comments <span class="mfba-pill mfba-count">@pendingComments.Count</span></h2>
                            <a class="mfba-panel-link" href="@commentsUrl">Moderate All @Icon("chevron-right", "mfba-icon mfba-icon-md")</a>
                        </div>
                        <div class="mfba-rows">
                            @if (commentsFormId == 0)
                            {
                                <div class="mfba-empty">The Blog Comments form is not bound to this app.</div>
                            }
                            else if (pendingComments.Count == 0)
                            {
                                <div class="mfba-empty">Nothing is waiting for moderation.</div>
                            }
                            @foreach (var pair in pendingComments.Take(3))
                            {
                                var row = pair.Item1;
                                var typed = pair.Item2;
                                var who = Text(typed, "commenter_name", "Anonymous");
                                var slug = Text(typed, "post_slug", "");
                                var parent = posts.FirstOrDefault(p => string.Equals(Text(p, "slug", ""), slug, StringComparison.OrdinalIgnoreCase));
                                <div class="mfba-comment">
                                    <span class="mfba-avatar">@Initials(who)</span>
                                    <div class="mfba-comment-main">
                                        <div class="mfba-comment-top">
                                            <strong>@who</strong>
                                            @if (row.IsSpam) { <span class="mfba-pill-sm mfba-flag">@Icon("flag", "mfba-icon mfba-icon-sm") Flagged</span> }
                                            <time>@Ago(row.SubmittedOnUtc)</time>
                                        </div>
                                        <p class="mfba-comment-body mfba-clamp2">@Text(typed, "comment_body", "")</p>
                                        <p class="mfba-comment-on">On: <strong>@(parent == null ? slug : Text(parent, "title", slug))</strong></p>
                                    </div>
                                    <div class="mfba-comment-act">
                                        <button class="mfba-chip-btn ok" type="submit" name="mfb_action" value="capprove|@row.SubmissionId">@Icon("check-circle", "mfba-icon mfba-icon-md") Approve</button>
                                        <button class="mfba-chip-btn no" type="submit" name="mfb_action" value="chide|@row.SubmissionId">@Icon("trash", "mfba-icon mfba-icon-md") Trash</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>

                    @{
                        var blogSubmissionIds = new HashSet<int>(posts.Select(p => p.SubmissionId));
                        var blogTasks = board == null ? new List<InboxTaskDto>()
                            : board.Incoming.Concat(board.InProgress).Where(t => blogSubmissionIds.Contains(t.SubmissionId)).ToList();
                    }
                    @if (blogTasks.Count > 0)
                    {
                        <section class="mfba-panel">
                            <div class="mfba-panel-head">
                                <h2>@Icon("shield", "mfba-icon mfba-icon-lg") My workflow tasks <span class="mfba-pill mfba-count">@blogTasks.Count</span></h2>
                                <span class="mfba-stat-sub">Claim &middot; approve &middot; request changes</span>
                            </div>
                            <div class="mfba-rows">
                                @foreach (var task in blogTasks.Take(6))
                                {
                                    <div class="mfba-task">
                                        <div class="mfba-task-main">
                                            <strong>@task.NodeLabel</strong>
                                            <small>Post #@task.SubmissionId &middot; @task.Status</small>
                                        </div>
                                        <input class="mfba-task-note" name="comment_@task.TaskId" placeholder="Optional review note" />
                                        <div class="mfba-task-act">
                                            @if (task.AllowClaim) { <button class="mfba-chip-btn ok" type="submit" name="mfb_action" value="claim|@task.TaskId">Claim</button> }
                                            <button class="mfba-chip-btn ok" type="submit" name="mfb_action" value="approve|@task.TaskId">@Icon("check-circle", "mfba-icon mfba-icon-md") Approve</button>
                                            <button class="mfba-chip-btn no" type="submit" name="mfb_action" value="reject|@task.TaskId">Changes</button>
                                        </div>
                                    </div>
                                }
                                @if (blogTasks.Count > 6)
                                {
                                    <div class="mfba-empty">@(blogTasks.Count - 6) more task(s) in the editorial queue.</div>
                                }
                            </div>
                        </section>
                    }
                </div>

                <div class="mfba-col">
                    <section class="mfba-panel">
                        <div class="mfba-panel-head"><h2>@Icon("activity", "mfba-icon mfba-icon-lg") Recent Activity</h2></div>
                        <div class="mfba-panel-body">
                            <div class="mfba-feed">
                                @{
                                    var feed = new List<Tuple<string, string, string, string, DateTime>>();
                                    foreach (var post in posts.OrderByDescending(p => p.SubmittedOnUtc).Take(4))
                                    {
                                        var key = StatusKey(post);
                                        var icon = key == "published" ? "check-circle" : key == "scheduled" ? "calendar" : "book-open";
                                        var tone = key == "published" ? "mfba-i-emerald" : key == "scheduled" ? "mfba-i-violet" : "mfba-i-blue";
                                        var verb = key == "published" ? " published " : key == "scheduled" ? " scheduled " : " saved draft ";
                                        feed.Add(Tuple.Create(icon, tone, Text(post, "author_name", "An editor") + verb, Text(post, "title", "Untitled story"), post.SubmittedOnUtc));
                                    }
                                    foreach (var pair in commentRows.Where(c => c.Item1.IsSpam).Take(1))
                                    {
                                        feed.Add(Tuple.Create("flag", "mfba-i-red", "New comment flagged on ", Text(pair.Item2, "post_slug", "a post"), pair.Item1.SubmittedOnUtc));
                                    }
                                    foreach (var post in posts.OrderByDescending(p => Num(p, "view_count")).Take(1))
                                    {
                                        feed.Add(Tuple.Create("flame", "mfba-i-orange", "Trending post detected ", Text(post, "title", "Untitled story"), post.SubmittedOnUtc));
                                    }
                                }
                                @if (feed.Count == 0)
                                {
                                    <div class="mfba-empty">No recent editorial activity.</div>
                                }
                                @foreach (var item in feed.OrderByDescending(f => f.Item5).Take(6))
                                {
                                    <div class="mfba-feed-item">
                                        <span class="mfba-feed-ico">@Icon(item.Item1, "mfba-icon mfba-icon-md " + item.Item2)</span>
                                        <div style="min-width:0;flex:1">
                                            <p class="mfba-feed-text">@item.Item3<strong>@item.Item4</strong></p>
                                            <p class="mfba-feed-time">@Icon("clock", "mfba-icon mfba-icon-sm")@Ago(item.Item5)</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </section>

                    <section class="mfba-panel">
                        <div class="mfba-panel-head"><h2>@Icon("bar-chart", "mfba-icon mfba-icon-lg") Top Performing</h2></div>
                        <div class="mfba-panel-body">
                            <div class="mfba-top">
                                @if (topPosts.Count == 0)
                                {
                                    <div class="mfba-empty">No reads recorded yet.</div>
                                }
                                @for (var index = 0; index < topPosts.Count; index++)
                                {
                                    var post = topPosts[index];
                                    var views = Num(post, "view_count");
                                    var share = (int)Math.Round(views * 100d / topMax);
                                    var shares = Num(post, "share_count");
                                    <div class="mfba-top-row">
                                        <span class="mfba-top-rank">@(index + 1)</span>
                                        <div class="mfba-top-main">
                                            <p class="mfba-clamp1">@Text(post, "title", "Untitled story")</p>
                                            <div class="mfba-bar-row">
                                                <span class="mfba-bar"><i style="width:@(share)%"></i></span>
                                                <span class="mfba-bar-val">@Compact(views)</span>
                                            </div>
                                        </div>
                                        <span class="mfba-top-delta @(shares > 0 ? "up" : "down")">@(shares > 0 ? "+" : "")@shares</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </section>

                    <section class="mfba-panel">
                        <div class="mfba-panel-head"><h2>@Icon("shield", "mfba-icon mfba-icon-lg") Admin Sections</h2></div>
                        <div class="mfba-links">
                            <a href="@commentsUrl">@Icon("message-circle")<span>Comments Moderation</span>
                                @if (pendingComments.Count > 0) { <span class="mfba-pill mfba-count">@pendingComments.Count pending</span> } else { @Icon("arrow-right", "mfba-icon mfba-icon-md") }
                            </a>
                            <a href="@editorialUrl">@Icon("layout")<span>Editorial Kanban</span>@Icon("arrow-right", "mfba-icon mfba-icon-md")</a>
                            <a href="@analyticsUrl">@Icon("bar-chart")<span>Analytics</span>@Icon("arrow-right", "mfba-icon mfba-icon-md")</a>
                            <a href="@authorsUrl">@Icon("users")<span>Authors</span><span class="mfba-pill mfba-count">@authors.Count</span></a>
                            <a href="@categoriesUrl">@Icon("tag")<span>Categories &amp; Tags</span>@Icon("arrow-right", "mfba-icon mfba-icon-md")</a>
                            <a href="@mediaUrl">@Icon("image")<span>Media Library</span>@Icon("arrow-right", "mfba-icon mfba-icon-md")</a>
                            <a href="@templatesUrl">@Icon("layout")<span>Templates</span>@Icon("arrow-right", "mfba-icon mfba-icon-md")</a>
                            <a href="@formatsUrl">@Icon("image")<span>Gallery and live coverage</span>@Icon("arrow-right", "mfba-icon mfba-icon-md")</a>
                            <a href="@settingsUrl">@Icon("settings")<span>Blog Settings</span>@Icon("arrow-right", "mfba-icon mfba-icon-md")</a>
                            @* "Post Archive" and "Recent Posts" both pointed at pages you were
                               already looking at (the public blog, and this dashboard). *@
                            <a href="@blogUrl">@Icon("rss")<span>Blog Home</span>@Icon("arrow-right", "mfba-icon mfba-icon-md")</a>
                        </div>
                    </section>

                    @if (commentScanTruncated)
                    {
                        <p class="mfba-stat-sub">Comment figures cover the most recent @CommentScanCap comments; open Comments Moderation for the full queue.</p>
                    }
                </div>
            </div>
        </main>
    }
</div>

@if (allowed && editing != null)
{
    <script src="/DesktopModules/MegaForm/Assets/js/megaform-widgets.js?v=20260729a"></script>
    <script src="/DesktopModules/MegaForm/Assets/js/plugins/megaform-widget-rich-text.js?v=20260729c"></script>
    <script>
    (function () {
        "use strict";
        var editorFormId = "blog-@editing.SubmissionId";
        var editorHost = document.getElementById("mfb-body-editor");
        if (editorHost && window.MegaFormWidgets) {
            var fallback = editorHost.querySelector('textarea[name="body"]');
            var initialHtml = fallback ? fallback.value : "";
            try {
                editorHost.innerHTML = window.MegaFormWidgets.renderWidget({
                    type: "RichText", key: "body", label: "Article body",
                    helpText: "Visual editor for trusted editorial HTML. Use the gallery below for managed images.",
                    required: true,
                    widgetProps: { height: 460, toolbar: "full", placeholder: "Write the article...", showWordCount: true, imageUpload: "disabled", platform: "dnn" }
                }, editorFormId, initialHtml);
                window.MegaFormWidgets.bindWidgets(editorHost);
            } catch (editorError) {
                console.error("MegaForm Blogs: visual editor could not start", editorError);
            }
        }

        var dialog = document.getElementById("mfb-gallery-dialog");
        if (!dialog) return;
        var cards = Array.prototype.slice.call(dialog.querySelectorAll(".mfba-gcard"));
        var tabs = Array.prototype.slice.call(dialog.querySelectorAll("[data-mfb-gallery-filter]"));
        var search = document.getElementById("mfb-gallery-search");
        var empty = dialog.querySelector(".mfba-gempty");
        var status = document.getElementById("mfb-gallery-status");
        var activeTarget = "body", activeKind = "posts", lastTrigger = null;

        function refreshGallery() {
            var term = (search.value || "").toLowerCase().trim(), visible = 0;
            cards.forEach(function (card) {
                var kindMatches = card.getAttribute("data-mfb-gallery-kind") === activeKind;
                var textMatches = !term || (card.getAttribute("data-mfb-gallery-search") || "").toLowerCase().indexOf(term) >= 0;
                var show = kindMatches && textMatches;
                card.hidden = !show;
                if (show) visible++;
            });
            tabs.forEach(function (tab) {
                var selected = tab.getAttribute("data-mfb-gallery-filter") === activeKind;
                tab.classList.toggle("active", selected);
                tab.setAttribute("aria-selected", selected ? "true" : "false");
            });
            empty.hidden = visible !== 0;
            status.textContent = visible + (visible === 1 ? " image available." : " images available.");
        }
        function openGallery(target, kind, trigger) {
            activeTarget = target || "body";
            activeKind = kind || (activeTarget === "author_avatar_url" ? "authors" : "posts");
            lastTrigger = trigger || null;
            search.value = "";
            dialog.hidden = false;
            document.body.classList.add("mfba-gallery-open");
            refreshGallery();
            window.setTimeout(function () { search.focus(); }, 0);
        }
        function closeGallery() {
            dialog.hidden = true;
            document.body.classList.remove("mfba-gallery-open");
            if (lastTrigger) lastTrigger.focus();
        }
        document.querySelectorAll("[data-mfb-gallery-open]").forEach(function (button) {
            button.addEventListener("click", function () {
                openGallery(button.getAttribute("data-mfb-gallery-open"), button.getAttribute("data-mfb-gallery-tab"), button);
            });
        });
        dialog.querySelectorAll("[data-mfb-gallery-close]").forEach(function (b) { b.addEventListener("click", closeGallery); });
        tabs.forEach(function (tab) {
            tab.addEventListener("click", function () { activeKind = tab.getAttribute("data-mfb-gallery-filter") || "posts"; refreshGallery(); });
        });
        search.addEventListener("input", refreshGallery);
        cards.forEach(function (card) {
            card.addEventListener("click", function () {
                var image = card.querySelector("img");
                var url = image ? image.getAttribute("src") : "";
                var alt = card.getAttribute("data-mfb-gallery-alt") || card.getAttribute("data-mfb-gallery-title") || "";
                if (!url) return;
                if (activeTarget === "body") {
                    if (!window.MegaRTE || !window.MegaRTE.insertImage(editorFormId, "body", url, alt)) {
                        status.textContent = "The visual editor is still loading. Please try again.";
                        return;
                    }
                } else {
                    var input = document.querySelector('[name="' + activeTarget + '"]');
                    if (!input) return;
                    input.value = url;
                    input.dispatchEvent(new Event("input", { bubbles: true }));
                    input.dispatchEvent(new Event("change", { bubbles: true }));
                    if (activeTarget === "featured_image_url") {
                        var altInput = document.querySelector('[name="image_alt_text"]');
                        if (altInput && !altInput.value) altInput.value = alt;
                    }
                    if (activeTarget === "author_avatar_url") {
                        var authorInput = document.querySelector('[name="author_name"]');
                        var authorName = card.getAttribute("data-mfb-gallery-title") || "";
                        if (authorInput && authorName) authorInput.value = authorName;
                    }
                }
                closeGallery();
            });
        });
        document.addEventListener("keydown", function (e) { if (!dialog.hidden && e.key === "Escape") closeGallery(); });
    })();
    </script>

    <script>
    // Search-result preview. Everything here is client-side and read-only: it shows what a search
    // engine would render from the fields as they are being typed, including the fallbacks the
    // fields have when they are empty (title -> post title, description -> excerpt).
    (function () {
        "use strict";
        var box = document.getElementById("mfba-serp");
        if (!box) { return; }

        var urlOut = document.getElementById("mfba-serp-url");
        var titleOut = document.getElementById("mfba-serp-title");
        var descOut = document.getElementById("mfba-serp-desc");
        var titleCount = document.getElementById("mfba-serp-tc");
        var descCount = document.getElementById("mfba-serp-dc");

        function field(name) { return document.querySelector('[name="' + name + '"]'); }
        function value(name) { var el = field(name); return el ? (el.value || "").trim() : ""; }

        // Google truncates around these; the counters turn amber past them rather than blocking.
        var TITLE_LIMIT = 60;
        var DESC_LIMIT = 160;

        function clip(text, limit) {
            return text.length > limit ? text.slice(0, limit - 1).trimEnd() + "\u2026" : text;
        }

        function paint() {
            var slug = value("slug");
            var canonical = value("canonical_url");
            var origin = window.location.protocol + "//" + window.location.host;
            urlOut.textContent = canonical || (origin + "/Blogs?slug=" + (slug || "your-post"));

            var title = value("seo_title") || value("title") || "Untitled story";
            var desc = value("seo_description") || value("excerpt") || "";
            titleOut.textContent = clip(title, TITLE_LIMIT);
            descOut.textContent = desc ? clip(desc, DESC_LIMIT) : "No description yet â€” search engines will pick their own snippet.";

            var titleLength = value("seo_title").length;
            var descLength = value("seo_description").length;
            titleCount.textContent = titleLength ? titleLength + "/" + TITLE_LIMIT : "falls back to the title";
            descCount.textContent = descLength ? descLength + "/" + DESC_LIMIT : "falls back to the excerpt";
            titleCount.className = titleLength > TITLE_LIMIT ? "mfba-over" : "";
            descCount.className = descLength > DESC_LIMIT ? "mfba-over" : "";
        }

        ["seo_title", "seo_description", "title", "excerpt", "slug", "canonical_url"].forEach(function (name) {
            var el = field(name);
            if (el) { el.addEventListener("input", paint); }
        });
        paint();
    })();
    </script>
}

