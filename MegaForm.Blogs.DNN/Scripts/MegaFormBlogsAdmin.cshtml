@*
    MegaForm Blogs - admin dashboard (screen 1 of 3).
    Sibling screens: MegaFormBlogsAdminEditorial.cshtml, MegaFormBlogsAdminComments.cshtml.
    Data contract: IMegaFormClient only. No DataJson parsing, no SQL, no MegaForm repositories.
    DNN Razor Host compiles each script in isolation, so the small helper block below is
    duplicated across the three admin screens on purpose.
*@
@inherits DotNetNuke.Web.Razor.DotNetNukeWebPage<dynamic>
@using System
@using System.Linq
@using System.Globalization
@using System.Collections.Generic
@using System.Security.Cryptography
@using MegaForm.Sdk

@functions {
    static T Run<T>(System.Func<IMegaFormClient, System.Threading.Tasks.Task<T>> action)
    {
        var initializeMegaForm = MegaForm.DNN.Services.DnnServiceLocator.Instance;
        return System.Threading.Tasks.Task.Run(() => MegaFormSdk.RunAsync(action)).GetAwaiter().GetResult();
    }

    static string Text(AppRecordDto record, string key, string fallback)
    {
        if (record == null || record.Data == null || !record.Data.ContainsKey(key) || record.Data[key] == null)
            return fallback;
        var value = Convert.ToString(record.Data[key]);
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    static int Num(AppRecordDto record, string key)
    {
        int value;
        return int.TryParse(Text(record, key, "0"), NumberStyles.Any, CultureInfo.InvariantCulture, out value) ? value : 0;
    }

    static bool CanManage(DotNetNuke.Entities.Users.UserInfo user)
    {
        if (user == null || user.UserID < 0) return false;
        if (user.IsSuperUser) return true;
        var allowed = new[] { "Administrators", "Blog Authors", "Blog Editors", "SEO Reviewers", "Content Legal Reviewers", "Blog Publishers" };
        return user.Roles != null && user.Roles.Any(role => allowed.Contains(role, StringComparer.OrdinalIgnoreCase));
    }

    // ---- create-a-post helpers ------------------------------------------------------------
    //
    // Ported from MegaForm.Blogs.Oqtane/AdminNewPost.razor. Until now DNN could only EDIT an
    // existing post: the dashboard's "New Post" tile pointed at the comments screen, so a blog
    // could not actually be started from DNN at all.
    //
    // The posts form has 14 REQUIRED fields and the editor below only collects 7 of them, so the
    // rest are seeded here. Without that, SubmitAsync fails validation and the post silently
    // never appears.

    static string Slugify(string value)
    {
        var text = (value ?? "").Trim().ToLowerInvariant();
        if (text.Length == 0) return "";
        var builder = new System.Text.StringBuilder(text.Length);
        var lastDash = false;
        foreach (var ch in text)
        {
            if (char.IsLetterOrDigit(ch) && ch < 128) { builder.Append(ch); lastDash = false; }
            else if (!lastDash && builder.Length > 0) { builder.Append('-'); lastDash = true; }
        }
        var slug = builder.ToString().Trim('-');
        return slug.Length > 120 ? slug.Substring(0, 120).Trim('-') : slug;
    }

    /// Matches the seeded convention: Design -> CAT-DESIGN, AI/ML -> CAT-AIML.
    static string CategoryUid(string category)
    {
        var text = (category ?? "").Trim().ToUpperInvariant();
        if (text.Length == 0) return "";
        var builder = new System.Text.StringBuilder(text.Length + 4);
        foreach (var ch in text) { if (char.IsLetterOrDigit(ch) && ch < 128) builder.Append(ch); }
        return builder.Length == 0 ? "" : "CAT-" + builder.ToString();
    }

    /// A slug no existing post is using, trying -2, -3, ... public-posts is queried BY slug, so a
    /// duplicate makes the reader-facing detail page ambiguous.
    static string ClaimFreeSlug(string desired, MegaFormScope scope)
    {
        var root = Slugify(desired);
        if (root.Length == 0) root = "post";
        for (var attempt = 0; attempt < 25; attempt++)
        {
            var candidate = attempt == 0 ? root : root + "-" + (attempt + 1);
            var request = new AppQueryRequest { Page = 1, PageSize = 1 };
            request.Parameters["slug"] = candidate;
            var existing = Run(c => c.Queries.ExecuteAsync("blog-starter", "all-posts", request, scope));
            if (existing == null || existing.TotalCount == 0) return candidate;
        }
        return null;
    }

    /// ðŸ”´ post_uid is the key reader-events and comments are grouped by, and the server-side
    /// generator hands the SAME value to every post created through a console. Measured on Oqtane:
    /// 28 posts, 24 distinct uids - four console-created posts all collided on POST-01001, which a
    /// seeded post already owned, so one article's read count was reported by five articles.
    /// The "S" prefix matters: seeded uids are numeric (POST-01001..), so a bare POST-<id> would
    /// collide once a site reaches submission 1001.
    static void EnsureUniquePostUid(int submissionId, MegaFormScope scope)
    {
        try
        {
            var record = Run(c => c.Records.GetRecordAsync(submissionId, scope));
            if (record == null) return;
            var current = Text(record, "post_uid", "").Trim();
            if (current.Length > 0)
            {
                var probe = new AppQueryRequest { Page = 1, PageSize = 5 };
                probe.Parameters["post_uid"] = current;
                var others = Run(c => c.Queries.ExecuteAsync("blog-starter", "all-posts", probe, scope));
                var clash = others != null && others.Items != null
                            && others.Items.Any(r => r.SubmissionId != submissionId);
                if (!clash) return;
            }
            Run(c => c.Records.PatchRecordAsync(submissionId,
                new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
                {
                    ["post_uid"] = "POST-S" + submissionId
                }, scope));
        }
        catch (Exception)
        {
            // A post that saved is worth more than a perfect uid.
        }
    }

    /// The nine SEO/social/scheduling fields the posts schema has always declared and the editor
    /// never showed. Kept in one list so create and save cannot drift apart.
    static readonly string[] SeoKeys = new[]
    {
        "seo_title", "seo_description", "meta_keywords", "canonical_url",
        "social_title", "social_description", "og_image_url"
    };

    static readonly string[] ScheduleKeys = new[] { "publish_date", "embargo_until", "expiry_date" };

    /// A URL that ends up in <link rel=canonical> or an <img src> on a public page: site-relative
    /// or absolute http(s) only, never javascript: or data:.
    static bool IsSafeUrl(string url)
    {
        var value = (url ?? "").Trim();
        if (value.Length == 0) return true;
        if (value.Length > 500) return false;
        if (value.StartsWith("/", StringComparison.Ordinal) && !value.StartsWith("//", StringComparison.Ordinal))
            return true;
        return value.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || value.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
    }

    /// yyyy-MM-dd for an <input type="date">, or "" when the stored value is not a date.
    /// Invariant on purpose: the typed date parser is invariant, and a scheduler thread has no
    /// portal locale to fall back on.
    static string DateInput(AppRecordDto record, string key)
    {
        DateTime value;
        return DateTime.TryParse(Text(record, key, ""), CultureInfo.InvariantCulture,
                                 DateTimeStyles.None, out value)
            ? value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
            : "";
    }

    /// Accepts what <input type="date"> posts (yyyy-MM-dd) and hands back the same shape, or ""
    /// when the box was cleared. Anything unparseable is refused rather than stored as text.
    static string NormalizeDate(string posted, string fieldLabel)
    {
        var raw = (posted ?? "").Trim();
        if (raw.Length == 0) return "";
        DateTime value;
        if (!DateTime.TryParse(raw, CultureInfo.InvariantCulture, DateTimeStyles.None, out value))
        {
            throw new InvalidOperationException(fieldLabel + " is not a valid date.");
        }
        return value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    static string EnsureCsrfToken()
    {
        const string key = "MegaFormBlogs.CsrfToken";
        var session = System.Web.HttpContext.Current.Session;
        var token = session[key] as string;
        if (!string.IsNullOrWhiteSpace(token)) return token;
        var bytes = new byte[32];
        using (var random = RandomNumberGenerator.Create()) { random.GetBytes(bytes); }
        token = Convert.ToBase64String(bytes);
        session[key] = token;
        return token;
    }

    static void ValidateCsrfToken(string posted)
    {
        const string key = "MegaFormBlogs.CsrfToken";
        var expected = System.Web.HttpContext.Current.Session[key] as string;
        var valid = !string.IsNullOrWhiteSpace(expected) && !string.IsNullOrWhiteSpace(posted) && expected.Length == posted.Length;
        var difference = valid ? 0 : 1;
        var length = valid ? expected.Length : 0;
        for (var index = 0; index < length; index++) { difference |= expected[index] ^ posted[index]; }
        if (difference != 0)
            throw new InvalidOperationException("The editorial session expired. Reload this page and try again.");
    }

    static string Initials(string name)
    {
        var parts = (name ?? "").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "MF";
        return string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }

    /// The posts form declares eight statuses and six content types; this editor offered four and
    /// two, and marked NONE of them selected â€” so the Status box read "Draft" over a published
    /// post and the Content type box read "Blog Post" over an Opinion piece (measured on
    /// dnndefender.com, record #288). A value the list does not contain is appended rather than
    /// dropped: an unrepresentable value that a save could silently rewrite is the whole danger.
    static readonly string[] PostStatuses = new[]
    {
        "draft", "in_review", "seo_review", "legal_review",
        "ready_to_publish", "scheduled", "published", "archived"
    };

    // 🔴 Gallery, Liveblog and Video are not decoration: the public renderer BRANCHES on them.
    // Gallery reads the Blog Gallery Images form, Liveblog reads Blog Live Updates and turns the
    // article into a feed, Video puts a play badge on the card. Adding a name here without the
    // matching branch would give an editor a format that renders as a plain article.
    static readonly string[] PostContentTypes = new[]
    {
        "Blog Post", "News", "Guide", "Release Notes", "Customer Story", "Opinion",
        "Gallery", "Liveblog", "Video"
    };

    /// Title-cases a stored key for display: "ready_to_publish" -> "Ready To Publish".
    static string Humanize(string value)
    {
        var text = (value ?? "").Replace('_', ' ').Replace('-', ' ').Trim();
        if (text.Length == 0) return "";
        return string.Join(" ", text.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(w => char.ToUpperInvariant(w[0]) + w.Substring(1)));
    }

    /// <option> list with the record's own value selected. Values and labels are HTML-encoded:
    /// they are stored data, not markup (root CLAUDE.md rule 5).
    static System.Web.IHtmlString SelectOptions(IEnumerable<string> choices, string current)
    {
        var builder = new System.Text.StringBuilder();
        var all = (choices ?? new string[0]).ToList();
        if (!string.IsNullOrWhiteSpace(current)
            && !all.Contains(current, StringComparer.OrdinalIgnoreCase))
        {
            all.Add(current);
        }
        foreach (var choice in all)
        {
            var selected = string.Equals(choice, current, StringComparison.OrdinalIgnoreCase)
                ? " selected=\"selected\"" : "";
            builder.Append("<option value=\"")
                   .Append(System.Web.HttpUtility.HtmlAttributeEncode(choice))
                   .Append("\"").Append(selected).Append(">")
                   .Append(System.Web.HttpUtility.HtmlEncode(Humanize(choice)))
                   .Append("</option>");
        }
        return new System.Web.HtmlString(builder.ToString());
    }

    // The persisted app manifest does not carry form bindings on every install (a seeded
    // blog-starter can ship "Forms": []), so fall back to identifying the comment child form
    // by its schema shape rather than by a title string. Cached for the request.
    static int ResolveCommentsFormId(MegaFormScope scope)
    {
        var items = System.Web.HttpContext.Current == null ? null : System.Web.HttpContext.Current.Items;
        const string cacheKey = "MegaFormBlogs.CommentsFormId";
        if (items != null && items.Contains(cacheKey)) { return (int)items[cacheKey]; }

        var resolved = Run(async c =>
        {
            var app = await c.Apps.GetAppAsync("blog-starter", scope);
            if (app != null && app.Forms != null)
            {
                var bound = app.Forms.FirstOrDefault(f =>
                    string.Equals(f.Alias, "comments", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(f.Role, "comments", StringComparison.OrdinalIgnoreCase));
                if (bound != null && bound.FormId > 0) { return bound.FormId; }
            }

            var forms = await c.Forms.ListFormsAsync(new FormQuery { Page = 1, PageSize = 200 }, scope);
            if (forms == null || forms.Items == null) { return 0; }
            var ordered = forms.Items
                .OrderByDescending(f => (f.Title ?? "").IndexOf("comment", StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
            foreach (var form in ordered)
            {
                var candidate = form;
                if (string.IsNullOrWhiteSpace(candidate.SchemaJson))
                {
                    candidate = await c.Forms.GetFormAsync(form.FormId, scope) ?? form;
                }
                if (string.IsNullOrWhiteSpace(candidate.SchemaJson)) { continue; }
                var keys = c.Schema.ParseForm(candidate).Fields.Select(x => x.Key ?? "").ToList();
                if (keys.Contains("comment_body", StringComparer.OrdinalIgnoreCase)
                    && keys.Contains("post_slug", StringComparer.OrdinalIgnoreCase)
                    && keys.Contains("moderation_status", StringComparer.OrdinalIgnoreCase))
                {
                    return candidate.FormId;
                }
            }
            return 0;
        });

        if (items != null) { items[cacheKey] = resolved; }
        return resolved;
    }

    static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return (int)span.TotalMinutes + "m ago";
        if (span.TotalHours < 24) return (int)span.TotalHours + "h ago";
        if (span.TotalDays < 30) return (int)span.TotalDays + "d ago";
        return utc.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
    }

    static string StatusLabel(string status)
    {
        switch ((status ?? "").ToLowerInvariant())
        {
            case "published": return "Published";
            case "in_review": return "Editorial";
            case "seo_review": return "SEO Check";
            case "legal_review": return "Legal";
            case "ready_to_publish": return "Ready";
            case "scheduled": return "Scheduled";
            case "archived": return "Archived";
            default: return "Draft";
        }
    }

    static string StatusKey(AppRecordDto record)
    {
        var value = Text(record, "status", "draft").Trim().ToLowerInvariant().Replace(' ', '_');
        var known = new[] { "draft", "in_review", "seo_review", "legal_review", "ready_to_publish", "scheduled", "published", "archived" };
        return known.Contains(value) ? value : "draft";
    }

    static string Compact(int value)
    {
        if (value >= 1000000) return (value / 1000000d).ToString("0.#", CultureInfo.InvariantCulture) + "M";
        if (value >= 1000) return (value / 1000d).ToString("0.#", CultureInfo.InvariantCulture) + "k";
        return value.ToString(CultureInfo.InvariantCulture);
    }

