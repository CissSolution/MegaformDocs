    static List<string[]> StartersFor(string group)
    {
        return Starters().Where(s => string.Equals(s[0], group, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    /// The body a brand-new template opens with: the first starter of that target.
    static string StarterBody(string group)
    {
        var first = StartersFor(group).FirstOrDefault();
        return first == null ? "" : first[3];
    }

    /// Writes the starter templates this portal does not have yet. `have` is the list of uids
    /// already stored; the first variant of a group is the one seeded active, the rest arrive
    /// switched off so nothing silently changes which template a target would use.
    static int SeedStarters(int formId, List<string> have, MegaFormScope scope)
    {
        var seeded = 0;
        var activeGroups = new List<string>();
        foreach (var starter in Starters())
        {
            var group = starter[0];
            var isFirst = !activeGroups.Contains(group);
            if (isFirst) { activeGroups.Add(group); }
            if (have.Contains(starter[1], StringComparer.OrdinalIgnoreCase)) { continue; }

            var values = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
            {
                ["template_uid"] = starter[1],
                ["template_name"] = starter[2],
                ["template_group"] = group,
                ["template_body"] = starter[3],
                ["is_active"] = isFirst && !have.Any(h => h.StartsWith("TPL-" + group.ToUpperInvariant().Replace("-", ""), StringComparison.OrdinalIgnoreCase))
                    ? "true" : "false",
                ["notes"] = "Created with the templates form. Edit freely; nothing renders from it yet."
            };
            var result = Run(c => c.Submissions.SubmitAsync(formId, values, scope));
            if (result != null && result.Success) { seeded++; }
        }
        return seeded;
    }

    /// The prebuilt gallery. The designs are real files shipped in the package
    /// (Assets/Templates/*.html) and catalog.json is the only list of them: a filename never
    /// comes from the browser, and it still has to match [a-z0-9-]+\.html before anything is read.
    class CatalogEntry
    {
        public string Key; public string File; public string Name;
        public string Group; public string Theme; public string Description;
    }

    static List<CatalogEntry> _catalog;
    static List<CatalogEntry> Catalog()
    {
        if (_catalog != null) { return _catalog; }
        var list = new List<CatalogEntry>();
        try
        {
            var path = System.Web.HttpContext.Current.Server.MapPath(
                "~/DesktopModules/MegaFormBlogs/Assets/Templates/catalog.json");
            if (System.IO.File.Exists(path))
            {
                var parsed = Newtonsoft.Json.Linq.JObject.Parse(System.IO.File.ReadAllText(path));
                var items = parsed["templates"] as Newtonsoft.Json.Linq.JArray;
                if (items != null)
                {
                    foreach (var item in items)
                    {
                        list.Add(new CatalogEntry
                        {
                            Key = (string)item["key"] ?? "",
                            File = (string)item["file"] ?? "",
                            Name = (string)item["name"] ?? "",
                            Group = (string)item["group"] ?? "",
                            Theme = (string)item["theme"] ?? "",
                            Description = (string)item["description"] ?? ""
                        });
                    }
                }
            }
        }
        catch (Exception)
        {
            // A missing or broken catalog means "no prebuilt designs", never a broken screen.
        }
        _catalog = list;
        return list;
    }

    static string CatalogBody(string fileName)
    {
        if (!System.Text.RegularExpressions.Regex.IsMatch(fileName ?? "", "^[a-z0-9-]+\\.html$"))
        {
            throw new InvalidOperationException("That is not a gallery template.");
        }
        var path = System.Web.HttpContext.Current.Server.MapPath(
            "~/DesktopModules/MegaFormBlogs/Assets/Templates/" + fileName);
        if (!System.IO.File.Exists(path))
        {
            throw new InvalidOperationException("That gallery template is not installed on this site.");
        }
        return System.IO.File.ReadAllText(path);
    }

    static System.Web.IHtmlString Icon(string name, string cssClass = "mfba-icon")
    {
        string body;
        switch (name)
        {
            case "chevron-right": body = "<path d='m9 18 6-6-6-6'/>"; break;
            case "layout": body = "<rect width='18' height='18' x='3' y='3' rx='2'/><path d='M3 9h18'/><path d='M9 21V9'/>"; break;
            case "plus": body = "<path d='M5 12h14'/><path d='M12 5v14'/>"; break;
            case "save": body = "<path d='M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z'/><path d='M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7'/><path d='M7 3v4a1 1 0 0 0 1 1h7'/>"; break;
            case "copy": body = "<rect width='14' height='14' x='8' y='8' rx='2'/><path d='M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2'/>"; break;
            case "trash": body = "<path d='M3 6h18'/><path d='M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6'/><path d='M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2'/>"; break;
            case "check": body = "<path d='M20 6 9 17l-5-5'/>"; break;
            case "eye": body = "<path d='M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0'/><circle cx='12' cy='12' r='3'/>"; break;
            case "pencil": body = "<path d='M21.17 6.81a1 1 0 0 0-3.98-3.99L3.84 16.17a2 2 0 0 0-.5.83l-1.32 4.35a.5.5 0 0 0 .62.63l4.35-1.33a2 2 0 0 0 .83-.5z'/>"; break;
            case "code": body = "<polyline points='16 18 22 12 16 6'/><polyline points='8 6 2 12 8 18'/>"; break;
            case "download": body = "<path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'/><polyline points='7 10 12 15 17 10'/><line x1='12' y1='15' x2='12' y2='3'/>"; break;
            default: body = ""; break;
        }
        return new System.Web.HtmlString("<svg class='" + cssClass + "' viewBox='0 0 24 24' aria-hidden='true'>" + body + "</svg>");
    }
}

@{
    var portalId = DotNetNuke.Entities.Portals.PortalSettings.Current == null
        ? 0 : DotNetNuke.Entities.Portals.PortalSettings.Current.PortalId;
    var activeTab = DotNetNuke.Entities.Portals.PortalSettings.Current == null
        ? null : DotNetNuke.Entities.Portals.PortalSettings.Current.ActiveTab;
    var adminBaseUrl = activeTab == null ? Request.RawUrl : DotNetNuke.Common.Globals.NavigateURL(activeTab.TabID);
    var templatesUrl = adminBaseUrl + "?view=templates";
    var user = DotNetNuke.Entities.Users.UserController.Instance.GetCurrentUserInfo();
    var scope = new MegaFormScope
    {
        PortalId = portalId,
        UserId = user == null ? 0 : user.UserID,
        UserName = user == null ? "" : user.Username,
        IsAuthenticated = user != null && user.UserID >= 0,
        IsAdmin = user != null && (user.IsSuperUser || user.IsInRole("Administrators")),
        IsSuperUser = user != null && user.IsSuperUser,
        Roles = user == null || user.Roles == null ? new List<string>() : user.Roles.ToList(),
        IpAddress = Request.UserHostAddress ?? ""
    };
    var allowed = CanManage(user);
    var csrfToken = allowed ? EnsureCsrfToken() : "";
    var message = "";
    var messageError = false;
    var templatesFormId = allowed ? ResolveTemplatesFormId(scope) : 0;
    var templates = new List<AppRecordDto>();

    var editId = 0;
    int.TryParse(Request.QueryString["edit"], out editId);
    var creating = string.Equals((Request.QueryString["edit"] ?? "").Trim(), "0", StringComparison.Ordinal);
    var newGroup = (Request.QueryString["group"] ?? "blog-home").Trim().ToLowerInvariant();
    if (!Groups.Any(g => g.Key == newGroup)) { newGroup = "blog-home"; }

    // ---- writes -------------------------------------------------------------------------
    if (allowed && string.Equals(Request.HttpMethod, "POST", StringComparison.OrdinalIgnoreCase))
    {
        try
        {
            var action = (Request.Form["mfb_tpl_action"] ?? "").Trim().ToLowerInvariant();
            if (action.Length > 0)
            {
                ValidateCsrfToken(Request.Form["mfb_csrf"]);
            }

            if (action == "install")
            {
                if (templatesFormId > 0)
                {
                    throw new InvalidOperationException("The templates form already exists.");
                }
                var created = Run(c => c.Forms.CreateFormAsync(new CreateFormRequest
                {
                    Title = TemplatesFormTitle,
                    Description = "Handlebars-like templates managed by the MegaForm Blogs console.",
                    SchemaJson = TemplatesSchemaJson,
                    Status = "published",
                    RequireAuth = true
                }, scope));
                if (created == null || created.FormId <= 0)
                {
                    throw new InvalidOperationException("The templates form could not be created.");
                }
                templatesFormId = created.FormId;
                if (System.Web.HttpContext.Current != null)
                {
                    System.Web.HttpContext.Current.Items["MegaFormBlogs.TemplatesFormId"] = templatesFormId;
                }

                var seeded = SeedStarters(templatesFormId, new List<string>(), scope);
                message = "Templates form created (#" + templatesFormId + ") with " + seeded + " starter template(s).";
            }
            else if (action == "seed" && templatesFormId > 0)
            {
                // Idempotent by template_uid: only the starters this portal is missing are written,
                // so pressing it twice costs two reads and no duplicate cards.
                var have = new List<string>();
                var known = Run(c => c.SubmissionDashboard.SearchAsync(
                    new SubmissionSearchQuery { FormId = templatesFormId, Page = 1, PageSize = 200 }, scope));
                if (known != null && known.Items != null)
                {
                    foreach (var row in known.Items)
                    {
                        var typed = Run(c => c.Records.GetRecordAsync(row.SubmissionId, scope));
                        if (typed != null) { have.Add(Text(typed, "template_uid", "")); }
                    }
                }
                var added = SeedStarters(templatesFormId, have, scope);
                message = added == 0
                    ? "Every starter template is already installed."
                    : added + " starter template(s) added.";
            }
            else if (action == "gallery-install" && templatesFormId > 0)
            {
                var key = (Request.Form["catalog_key"] ?? "").Trim();
                var entry = Catalog().FirstOrDefault(c => string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
                if (entry == null)
                {
                    throw new InvalidOperationException("That gallery template no longer exists.");
                }
                var uid = "TPL-GAL-" + entry.Key.ToUpperInvariant();
                var body = CatalogBody(entry.File);
                var notes = entry.Theme + " \u2014 from the gallery. " + entry.Description;

                // Already here? Refresh it in place. The packaged design moves on with the module,
                // and an admin who changed theirs should have pressed Duplicate - that copy has a
                // different uid and is never touched.
                var existingId = 0;
                var known = Run(c => c.SubmissionDashboard.SearchAsync(
                    new SubmissionSearchQuery { FormId = templatesFormId, Page = 1, PageSize = 200 }, scope));
                if (known != null && known.Items != null)
                {
                    foreach (var row in known.Items)
                    {
                        var typed = Run(c => c.Records.GetRecordAsync(row.SubmissionId, scope));
                        if (typed == null) { continue; }
                        if (!string.Equals(Text(typed, "template_uid", ""), uid, StringComparison.OrdinalIgnoreCase)) { continue; }
                        existingId = row.SubmissionId;
                        break;
                    }
                }

                if (existingId > 0)
                {
                    var refreshId = existingId;
                    Run(c => c.Records.PatchRecordAsync(refreshId, new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
                    {
                        ["template_name"] = entry.Name,
                        ["template_group"] = entry.Group,
                        ["template_body"] = body,
                        ["notes"] = notes
                    }, scope));
                    message = entry.Name + " updated from the gallery.";
                }
                else
                {
                    var values = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
                    {
                        ["template_uid"] = uid,
                        ["template_name"] = entry.Name,
                        ["template_group"] = entry.Group,
                        ["template_body"] = body,
                        ["is_active"] = "false",
                        ["notes"] = notes
                    };
                    var created = Run(c => c.Submissions.SubmitAsync(templatesFormId, values, scope));
                    if (created == null || !created.Success)
                    {
                        throw new InvalidOperationException("That template could not be installed.");
                    }
                    message = entry.Name + " installed. Use Set active to make it render this target.";
                }
            }
            else if (action == "import" && templatesFormId > 0)
            {
                // The browser read the file and posted its text; the server validates it like any
                // other string. .json carries name/group/body, anything else is treated as a body.
                var fileName = (Request.Form["import_name"] ?? "").Trim();
                var payload = Request.Form["import_body"] ?? "";
                if (payload.Trim().Length == 0)
                {
                    throw new InvalidOperationException("Choose a template file first.");
                }
                if (payload.Length > 200000)
                {
                    throw new InvalidOperationException("That file is larger than 200,000 characters.");
                }

                var importedName = fileName.Length > 0 ? fileName : "Imported template";
                var importedGroup = (Request.Form["import_group"] ?? "blog-home").Trim().ToLowerInvariant();
                var importedNotes = "Imported on " + DateTime.UtcNow.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) + ".";
                var importedBody = payload;

                var trimmed = payload.TrimStart();
                if (trimmed.StartsWith("{", StringComparison.Ordinal))
                {
                    var parsed = Newtonsoft.Json.Linq.JObject.Parse(payload);
                    var bodyValue = (string)parsed["template_body"] ?? (string)parsed["body"];
                    if (string.IsNullOrWhiteSpace(bodyValue))
                    {
                        throw new InvalidOperationException("That JSON has no template_body.");
                    }
                    importedBody = bodyValue;
                    var nameValue = (string)parsed["template_name"] ?? (string)parsed["name"];
                    if (!string.IsNullOrWhiteSpace(nameValue)) { importedName = nameValue; }
                    var groupValue = (string)parsed["template_group"] ?? (string)parsed["group"];
                    if (!string.IsNullOrWhiteSpace(groupValue)) { importedGroup = groupValue.Trim().ToLowerInvariant(); }
                    var noteValue = (string)parsed["notes"];
                    if (!string.IsNullOrWhiteSpace(noteValue)) { importedNotes = noteValue; }
                }

                if (!Groups.Any(g => g.Key == importedGroup)) { importedGroup = "blog-home"; }
                if (importedName.Length > 120) { importedName = importedName.Substring(0, 120); }
                if (importedBody.Length > 60000)
                {
                    throw new InvalidOperationException("That template body is too large (60,000 characters maximum).");
                }
                if (importedNotes.Length > 500) { importedNotes = importedNotes.Substring(0, 500); }

                var values = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
                {
                    ["template_uid"] = "TPL-" + DateTime.UtcNow.Ticks.ToString(CultureInfo.InvariantCulture),
                    ["template_name"] = importedName,
                    ["template_group"] = importedGroup,
                    ["template_body"] = importedBody,
                    ["is_active"] = "false",
                    ["notes"] = importedNotes
                };
                var saved = Run(c => c.Submissions.SubmitAsync(templatesFormId, values, scope));
                if (saved == null || !saved.Success)
                {
                    throw new InvalidOperationException("That template could not be imported.");
                }
                message = "\"" + importedName + "\" imported into " + GroupLabel(importedGroup) + ". It is not active yet.";
            }
            else if (action == "save" && templatesFormId > 0)
            {
                var targetId = 0;
                int.TryParse(Request.Form["tpl_id"], out targetId);
                var name = (Request.Form["template_name"] ?? "").Trim();
                var group = (Request.Form["template_group"] ?? "").Trim().ToLowerInvariant();
                var bodyText = Request.Form["template_body"] ?? "";
                var notes = (Request.Form["notes"] ?? "").Trim();

                if (name.Length == 0 || name.Length > 120)
                {
                    throw new InvalidOperationException("The template name is required and must be 120 characters or fewer.");
                }
                if (!Groups.Any(g => g.Key == group))
                {
                    throw new InvalidOperationException("Pick one of the five render targets.");
                }
                if (bodyText.Length > 60000)
                {
                    throw new InvalidOperationException("That template body is too large (60,000 characters maximum).");
                }
                if (notes.Length > 500) { notes = notes.Substring(0, 500); }

                var values = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
                {
                    ["template_name"] = name,
                    ["template_group"] = group,
                    ["template_body"] = bodyText,
                    ["notes"] = notes
                };

                if (targetId > 0)
                {
                    var updated = Run(c => c.Records.PatchRecordAsync(targetId, values, scope));
                    message = updated == null ? "That template no longer exists." : "Template saved.";
                    messageError = updated == null;
                }
                else
                {
                    values["template_uid"] = "TPL-" + DateTime.UtcNow.Ticks.ToString(CultureInfo.InvariantCulture);
                    values["is_active"] = "false";
                    var created = Run(c => c.Submissions.SubmitAsync(templatesFormId, values, scope));
                    if (created == null || !created.Success)
                    {
                        throw new InvalidOperationException(created == null || string.IsNullOrWhiteSpace(created.ErrorMessage)
                            ? "The template could not be created." : created.ErrorMessage);
                    }
                    message = "Template created. It is not active yet — use Set active when you want it to be the one.";
                }
            }
            else if ((action == "duplicate" || action == "activate" || action == "delete") && templatesFormId > 0)
            {
                var targetId = 0;
                int.TryParse(Request.Form["tpl_id"], out targetId);
                var target = targetId > 0 ? Run(c => c.Records.GetRecordAsync(targetId, scope)) : null;
                // Ownership: never touch a record that is not a template of this app.
                if (target == null || target.FormId != templatesFormId)
                {
                    throw new InvalidOperationException("That record does not belong to the Blog Templates form.");
                }

                if (action == "duplicate")
                {
                    var values = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
                    {
                        ["template_uid"] = "TPL-" + DateTime.UtcNow.Ticks.ToString(CultureInfo.InvariantCulture),
                        ["template_name"] = Text(target, "template_name", "Template") + " (copy)",
                        ["template_group"] = Text(target, "template_group", "blog-home"),
                        ["template_body"] = Text(target, "template_body", ""),
                        ["is_active"] = "false",
                        ["notes"] = Text(target, "notes", "")
                    };
                    var copy = Run(c => c.Submissions.SubmitAsync(templatesFormId, values, scope));
                    message = copy != null && copy.Success ? "Template duplicated." : "The copy could not be created.";
                    messageError = copy == null || !copy.Success;
                }
                else if (action == "activate")
                {
                    // One active template per group: activating this one stands the others down.
                    var group = Text(target, "template_group", "");
                    var scan = Run(c => c.SubmissionDashboard.SearchAsync(
                        new SubmissionSearchQuery { FormId = templatesFormId, Page = 1, PageSize = 100 }, scope));
                    var switched = 0;
                    if (scan != null && scan.Items != null)
                    {
                        foreach (var row in scan.Items)
                        {
                            var typed = Run(c => c.Records.GetRecordAsync(row.SubmissionId, scope));
                            if (typed == null) { continue; }
                            if (!string.Equals(Text(typed, "template_group", ""), group, StringComparison.OrdinalIgnoreCase)) { continue; }
                            var wanted = row.SubmissionId == targetId ? "true" : "false";
                            if (string.Equals(Text(typed, "is_active", "false"), wanted, StringComparison.OrdinalIgnoreCase)) { continue; }
                            var id = row.SubmissionId;
                            Run(c => c.Records.PatchRecordAsync(id, new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
                            {
                                ["is_active"] = wanted
                            }, scope));
                            switched++;
                        }
                    }
                    message = "Active template for " + GroupLabel(group) + " set (" + switched + " record(s) changed).";
                }
                else
                {
                    Run(async c => { await c.Submissions.DeleteAsync(targetId, scope); return true; });
                    message = "Template deleted.";
                }
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageError = true;
        }
    }

    // ---- reads --------------------------------------------------------------------------
    if (allowed && templatesFormId > 0)
    {
        try
        {
            var scan = Run(c => c.SubmissionDashboard.SearchAsync(
                new SubmissionSearchQuery { FormId = templatesFormId, Page = 1, PageSize = 100 }, scope));
            if (scan != null && scan.Items != null)
            {
                var reads = scan.Items.Select(row => System.Threading.Tasks.Task.Run(() =>
                    MegaFormSdk.RunAsync(c => c.Records.GetRecordAsync(row.SubmissionId, scope)))).ToArray();
                System.Threading.Tasks.Task.WaitAll(reads);
                foreach (var read in reads)
                {
                    if (read.Result != null) { templates.Add(read.Result); }
                }
            }
        }
        catch (Exception ex)
        {
            message = string.IsNullOrWhiteSpace(message) ? ex.Message : message;
            messageError = true;
        }
    }

    templates = templates.OrderBy(t => Text(t, "template_name", ""), StringComparer.OrdinalIgnoreCase).ToList();
    var editing = editId > 0 ? templates.FirstOrDefault(t => t.SubmissionId == editId) : null;
    var activeCount = templates.Count(IsActive);
    var groupsCovered = templates.Select(t => Text(t, "template_group", "")).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    var storedUids = templates.Select(t => Text(t, "template_uid", "")).ToList();
    var missingStarters = templatesFormId == 0 ? 0
        : Starters().Count(st => !storedUids.Contains(st[1], StringComparer.OrdinalIgnoreCase));
}

<link rel="stylesheet" href="/DesktopModules/MegaFormBlogs/Assets/megaform-blogs-admin.css?v=20260809j" />

<div class="mfba">
    @if (!allowed)
    {
        <header class="mfba-head">
            <div class="mfba-head-row"><div><h1>Administrator access required</h1><p>Template management is limited to Administrators and Blog Publishers.</p></div></div>
        </header>
    }
    else
    {
        <header class="mfba-head">
            <nav class="mfba-crumb" aria-label="Breadcrumb">
                <a href="/Blogs">Blog</a>@Icon("chevron-right", "mfba-icon mfba-icon-md")
                <a href="@adminBaseUrl">Admin</a>@Icon("chevron-right", "mfba-icon mfba-icon-md")
                <strong>Templates</strong>
            </nav>
            <div class="mfba-head-row">
                <div>
                    <h1>Templates</h1>
                    <p>Handlebars-like templates per render target, with a live preview</p>
                </div>
                @if (templatesFormId > 0 && editing == null && !creating)
                {
                    <div class="mfba-head-actions">
                        @if (missingStarters > 0)
                        {
                            <button class="mfba-btn ghost" type="submit" name="mfb_tpl_action" value="seed"
                                    title="Adds the starter templates this portal does not have yet">
                                @Icon("copy", "mfba-icon mfba-icon-md") Add @missingStarters starter@(missingStarters == 1 ? "" : "s")
                            </button>
                        }
                        <a class="mfba-btn" href="@(templatesUrl + "&edit=0")">@Icon("plus") New template</a>
                    </div>
                }
            </div>
        </header>

        <input type="hidden" name="mfb_csrf" value="@csrfToken" />
        <input type="hidden" name="tpl_id" value="@(editing == null ? 0 : editing.SubmissionId)" />

        if (!string.IsNullOrWhiteSpace(message))
        {
            <div style="padding:16px 24px 0"><div class="mfba-notice @(messageError ? "err" : "ok")">@message</div></div>
        }

        // Code context already: no `@{`, the fourth time that rule has cost a deploy.
        var renderingOn = TemplatesRenderOn(portalId);
            var liveHome = templates.FirstOrDefault(t => IsActive(t)
                && string.Equals(Text(t, "template_group", ""), "blog-home", StringComparison.OrdinalIgnoreCase));
            var livePost = templates.FirstOrDefault(t => IsActive(t)
                && string.Equals(Text(t, "template_group", ""), "blog-post", StringComparison.OrdinalIgnoreCase));
            var settingsUrl = adminBaseUrl + "?view=settings";
        <div style="padding:16px 24px 0">
            @if (renderingOn)
            {
                <div class="mfba-notice ok">
                    <strong>Templates are rendering the blog.</strong>
                    /Blogs uses @(liveHome == null ? "the built-in design (nothing active for Blog Home)" : "“" + Text(liveHome, "template_name", "") + "”")
                    and an article uses @(livePost == null ? "the built-in design (nothing active for Blog Post)" : "“" + Text(livePost, "template_name", "") + "”").
                    A change here reaches readers within a minute; a template that errors hands the page
                    back to the built-in design. <a href="@settingsUrl">Turn it off in Settings</a>.
                </div>
            }
            else
            {
                <div class="mfba-notice ok" style="background:#eef2ff;color:#3730a3">
                    <strong>Templates are not rendering the blog right now.</strong>
                    /Blogs and the article page use the built-in design. Mark a template
                    <em>Active</em> for its target, then switch on <em>Let the active template render the
                    blog</em> in <a href="@settingsUrl">Settings</a> — two clicks, and reversible with one.
                </div>
            }
        </div>

        if (templatesFormId == 0)
        {
            <section class="mfba-panel">
                <div class="mfba-panel-head"><h2>@Icon("layout", "mfba-icon mfba-icon-lg") Set up template storage</h2></div>
                <div class="mfba-editor">
                    <p class="mfba-hint">
                        Templates are stored as records of a <strong>Blog Templates</strong> form, created
                        once, here. A DNN portal setting was the obvious alternative and is the wrong one:
                        it holds 2,000 characters, which a single template body would exceed.
                        Creating it also seeds the starter set — two or three per render target.
                    </p>
                    <button class="mfba-btn" type="submit" name="mfb_tpl_action" value="install">
                        @Icon("plus", "mfba-icon mfba-icon-md") Create the templates form
                    </button>
                </div>
            </section>
        }
        else if (editing != null || creating)
        {
            var currentName = editing == null ? "" : Text(editing, "template_name", "");
            var currentGroup = editing == null ? newGroup : Text(editing, "template_group", "blog-home");
            var currentBody = editing == null ? StarterBody(newGroup) : Text(editing, "template_body", "");
            var currentNotes = editing == null ? "" : Text(editing, "notes", "");
            <section class="mfba-panel">
                <div class="mfba-panel-head">
                    <h2>@Icon("code", "mfba-icon mfba-icon-lg") @(editing == null ? "New template" : currentName)</h2>
                    <a class="mfba-panel-link" href="@templatesUrl">All templates</a>
                </div>
                <div class="mfba-editor">
                    <div class="mfba-form-grid">
                        <label>Name<input name="template_name" maxlength="120" required value="@currentName" /></label>
                        <label>Render target
                            <select name="template_group" id="mfba-tpl-group">
                                @foreach (var group in Groups)
                                {
                                    if (string.Equals(group.Key, currentGroup, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="@group.Key" selected="selected">@group.Value</option>
                                    }
                                    else
                                    {
                                        <option value="@group.Key">@group.Value</option>
                                    }
                                }
                            </select>
                        </label>
                        <label class="wide">Notes<input name="notes" maxlength="500" value="@currentNotes" /></label>
                    </div>

                    <div class="mfba-split">
                        <div class="mfba-split-code">
                            <div class="mfba-subhead">@Icon("code", "mfba-icon mfba-icon-md") Template</div>
                            @* The highlighter is a <pre> mirror sitting behind a transparent textarea:
                               the textarea keeps every native editing behaviour (undo, spellcheck,
                               selection) and the colours are painted underneath in exact lockstep. *@
                            <div class="mfba-code-wrap">
                                <pre class="mfba-code-hl" id="mfba-code-hl" aria-hidden="true"></pre>
                                <textarea id="mfba-code" name="template_body" spellcheck="false" wrap="off">@currentBody</textarea>
                            </div>
                            <details class="mfba-cheat">
                                <summary>Variable reference</summary>
                                <div id="mfba-cheat-body"></div>
                            </details>
                        </div>
                        <div class="mfba-split-preview">
                            <div class="mfba-subhead">@Icon("eye", "mfba-icon mfba-icon-md") Live preview <small id="mfba-preview-note"></small></div>
                            <div class="mfba-preview" id="mfba-preview"></div>
                        </div>
                    </div>

                    <div class="mfba-actions">
                        <button class="mfba-btn" type="submit" name="mfb_tpl_action" value="save">
                            @Icon("save", "mfba-icon mfba-icon-md") @(editing == null ? "Create template" : "Save template")
                        </button>
                        <button class="mfba-btn ghost" type="button" id="mfba-download"
                                title="Saves a .json this screen can import back">
                            @Icon("download", "mfba-icon mfba-icon-md") Download
                        </button>
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="mfba-stats" aria-label="Template figures">
                <div class="mfba-stat">
                    <div class="mfba-stat-top"><span class="mfba-stat-chip mfba-c-blue">@Icon("layout")</span></div>
                    <p class="mfba-stat-value">@templates.Count</p>
                    <p class="mfba-stat-label">Templates</p>
                    <p class="mfba-stat-sub">across @groupsCovered of @Groups.Count render targets</p>
                </div>
                <div class="mfba-stat">
                    <div class="mfba-stat-top"><span class="mfba-stat-chip mfba-c-emerald">@Icon("check")</span></div>
                    <p class="mfba-stat-value">@activeCount</p>
                    <p class="mfba-stat-label">Marked active</p>
                    <p class="mfba-stat-sub">one per target at most</p>
                </div>
                <div class="mfba-stat">
                    <div class="mfba-stat-top"><span class="mfba-stat-chip mfba-c-violet">@Icon("code")</span></div>
                    <p class="mfba-stat-value">{{ }}</p>
                    <p class="mfba-stat-label">Syntax</p>
                    <p class="mfba-stat-sub">{{var}}, {{#each}}, {{#if}}</p>
                </div>
                <div class="mfba-stat">
                    <div class="mfba-stat-top"><span class="mfba-stat-chip mfba-c-amber">@Icon("eye")</span></div>
                    <p class="mfba-stat-value">form #@templatesFormId</p>
                    <p class="mfba-stat-label">Storage</p>
                    <p class="mfba-stat-sub">records of the Blog Templates form</p>
                </div>
            </section>

            var installedUids = templates.Select(t => Text(t, "template_uid", "")).ToList();
            var catalog = Catalog();
            if (catalog.Count > 0)
            {
                <section class="mfba-panel">
                    <div class="mfba-panel-head">
                        <h2>@Icon("layout", "mfba-icon mfba-icon-lg") Prebuilt designs</h2>
                        <span class="mfba-panel-link">@catalog.Count in the gallery</span>
                    </div>
                    <div class="mfba-panel-body">
                        <div class="mfba-gal-grid">
                            @foreach (var item in catalog)
                            {
                                var installed = installedUids.Contains("TPL-GAL-" + item.Key.ToUpperInvariant(),
                                                                       StringComparer.OrdinalIgnoreCase);
                                var previewId = "gal-" + item.Key;
                                <article class="mfba-gal-card">
                                    <div class="mfba-gal-shot" id="@previewId" data-file="@item.File"></div>
                                    <div class="mfba-gal-copy">
                                        <span class="mfba-pill mfba-st-draft">@item.Theme</span>
                                        <strong>@item.Name</strong>
                                        <small>@GroupLabel(item.Group)</small>
                                        <p>@item.Description</p>
                                    </div>
                                    <div class="mfba-gal-acts">
                                        @if (installed)
                                        {
                                            <span class="mfba-pill mfba-st-published">Installed</span>
                                            <button class="mfba-btn ghost" type="submit" name="mfb_tpl_action" value="gallery-install"
                                                    title="Replaces this portal's copy with the version shipped in the module"
                                                    onclick="document.getElementById('mfba-catalog-key').value='@item.Key';">
                                                @Icon("download", "mfba-icon mfba-icon-md") Update
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="mfba-btn" type="submit" name="mfb_tpl_action" value="gallery-install"
                                                    onclick="document.getElementById('mfba-catalog-key').value='@item.Key';">
                                                @Icon("plus", "mfba-icon mfba-icon-md") Install
                                            </button>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                        <input type="hidden" name="catalog_key" id="mfba-catalog-key" value="" />
                        <p class="mfba-hint">
                            These are complete designs, shipped as files with the module. Installing copies one into
                            this portal as a normal template you can edit; it renders the blog only once you press
                            <strong>Set active</strong> and the switch in Settings is on.
                        </p>
                    </div>
                </section>

                <section class="mfba-panel">
                    <div class="mfba-panel-head">
                        <h2>@Icon("copy", "mfba-icon mfba-icon-lg") Import a template file</h2>
                    </div>
                    <div class="mfba-panel-body">
                        <div class="mfba-form-grid mfba-grid-even">
                            <label>Template file
                                <input type="file" id="mfba-import-file" accept=".html,.htm,.hbs,.txt,.json" />
                            </label>
                            <label>Render target
                                <select id="mfba-import-group">
                                    @foreach (var group in Groups)
                                    {
                                        <option value="@group.Key">@group.Value</option>
                                    }
                                </select>
                            </label>
                        </div>
                        <input type="hidden" name="import_name" id="mfba-import-name" value="" />
                        <input type="hidden" name="import_group" id="mfba-import-group-value" value="blog-home" />
                        <textarea name="import_body" id="mfba-import-body" hidden></textarea>
                        <div class="mfba-actions">
                            <button class="mfba-btn" type="submit" name="mfb_tpl_action" value="import" id="mfba-import-go" disabled>
                                @Icon("save", "mfba-icon mfba-icon-md") Import
                            </button>
                            <span class="mfba-hint" id="mfba-import-note">No file chosen.</span>
                        </div>
                        <p class="mfba-hint">
                            A <strong>.json</strong> exported from this screen keeps its name, target and notes; any
                            other file is taken as the template body. The browser reads the file and posts its text,
                            so nothing is uploaded to the server as a file.
                        </p>
                    </div>
                </section>
            }

            foreach (var group in Groups)
            {
                var inGroup = templates.Where(t => string.Equals(Text(t, "template_group", ""), group.Key,
                                                                 StringComparison.OrdinalIgnoreCase)).ToList();
                <section class="mfba-panel">
                    <div class="mfba-panel-head">
                        <h2>@group.Value <span class="mfba-pill mfba-st-draft">@inGroup.Count</span></h2>
                        <a class="mfba-panel-link" href="@(templatesUrl + "&edit=0&group=" + group.Key)">New for this target @Icon("chevron-right", "mfba-icon mfba-icon-md")</a>
                    </div>
                    <div class="mfba-panel-body">
                        @if (inGroup.Count == 0)
                        {
                            <div class="mfba-empty">No template for this target yet.</div>
                        }
                        else
                        {
                            <div class="mfba-tpl-grid">
                                @foreach (var template in inGroup)
                                {
                                    var body = Text(template, "template_body", "");
                                    var snippet = body.Length > 220 ? body.Substring(0, 220) + "…" : body;
                                    var editUrl = templatesUrl + "&edit=" + template.SubmissionId;
                                    <article class="mfba-tpl-card">
                                        <header>
                                            <strong class="mfba-clamp1">@Text(template, "template_name", "Untitled")</strong>
                                            @if (IsActive(template))
                                            {
                                                <span class="mfba-pill mfba-st-published">Active</span>
                                            }
                                        </header>
                                        <pre class="mfba-tpl-snippet">@snippet</pre>
                                        <small>@Text(template, "notes", "No notes") · updated @template.SubmittedOnUtc.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</small>
                                        <div class="mfba-tpl-acts">
                                            <a class="mfba-iconbtn" title="Edit" href="@editUrl">@Icon("pencil", "mfba-icon mfba-icon-md")</a>
                                            <a class="mfba-iconbtn" title="Preview" href="@(editUrl + "#mfba-preview")">@Icon("eye", "mfba-icon mfba-icon-md")</a>
                                            <a class="mfba-iconbtn" title="Download as .json" href="@(editUrl + "&download=1")">@Icon("download", "mfba-icon mfba-icon-md")</a>
                                            <button class="mfba-iconbtn" type="submit" name="mfb_tpl_action" value="duplicate" title="Duplicate"
                                                    onclick="document.getElementsByName('tpl_id')[0].value='@template.SubmissionId';">@Icon("copy", "mfba-icon mfba-icon-md")</button>
                                            @if (!IsActive(template))
                                            {
                                                <button class="mfba-iconbtn ok" type="submit" name="mfb_tpl_action" value="activate" title="Set active"
                                                        onclick="document.getElementsByName('tpl_id')[0].value='@template.SubmissionId';">@Icon("check", "mfba-icon mfba-icon-md")</button>
                                            }
                                            <button class="mfba-iconbtn stop" type="submit" name="mfb_tpl_action" value="delete" title="Delete"
                                                    onclick="document.getElementsByName('tpl_id')[0].value='@template.SubmissionId';">@Icon("trash", "mfba-icon mfba-icon-md")</button>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </section>
            }
        }
    }
</div>

@if (allowed && templatesFormId > 0)
{
    <script>
    // ---------------------------------------------------------------------------------------
    // Template editor: a Handlebars-LIKE interpreter, a mirror highlighter and a live preview.
    //
    // "Like", not "compatible": it understands {{var}}, {{a.b}}, {{#each list}}…{{/each}} and
    // {{#if value}}…{{else}}…{{/if}}, and nothing else. That is exactly the subset the templates
    // are written in, and a small honest parser beats pulling a 20 KB library into a DNN page.
    // Values are HTML-escaped when substituted; the TEMPLATE's own markup is not, because
    // producing markup is the whole point of a template.
    // ---------------------------------------------------------------------------------------
    (function () {
        "use strict";
        var code = document.getElementById("mfba-code");
        var mirror = document.getElementById("mfba-code-hl");
        var preview = document.getElementById("mfba-preview");
        var note = document.getElementById("mfba-preview-note");
        var cheat = document.getElementById("mfba-cheat-body");
        var groupBox = document.getElementById("mfba-tpl-group");

        // ---- the RENDER CONTRACT ------------------------------------------------------------
        // These are the exact keys the server hands a template (MegaFormBlogs.cshtml, TplPost and
        // the context builder). This mock exists so the preview is truthful; if the server gains a
        // key, it belongs here the same day, and catalog.json documents the contract in one line.
        var POSTS = [
            { title: "The Future of Design Systems", excerpt: "Why tokens outlive components.", category: "Design",
              author: "Sarah Chen", authorAvatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=80&h=80&fit=crop",
              authorRole: "Design lead", authorBio: "Writes about systems that survive their authors.",
              date: "Jul 29, 2026", readingTime: 6, reads: 1420, comments: 12, format: "Blog Post",
              readsLabel: "1420 reads", commentsLabel: "12 comments",
              url: "/Blogs?slug=future-of-design-systems", slug: "future-of-design-systems",
              image: "https://images.unsplash.com/photo-1561070791-2526d30994b5?w=900&h=600&fit=crop" },
            { title: "DNN and Oqtane", excerpt: "A practical comparison of the two platforms.", category: "Development",
              author: "DNN Defender Team", authorAvatar: "", authorRole: "Editorial", authorBio: "The team behind the module.",
              date: "Jul 29, 2026", readingTime: 5, reads: 980, comments: 3, format: "Blog Post",
              readsLabel: "980 reads", commentsLabel: "3 comments",
              url: "/Blogs?slug=dnn-and-oqtane", slug: "dnn-and-oqtane",
              image: "https://images.unsplash.com/photo-1518770660439-4636190af475?w=900&h=600&fit=crop" },
            { title: "Why Bots Target Forms", excerpt: "What a form endpoint looks like to a crawler.", category: "Security",
              author: "SuperUser Account", authorAvatar: "", authorRole: "Contributor", authorBio: "Security notes.",
              date: "Feb 12, 2026", readingTime: 4, reads: 640, comments: 0, format: "Blog Post",
              readsLabel: "640 reads", commentsLabel: "no comments",
              url: "/Blogs?slug=why-bots-target-forms", slug: "why-bots-target-forms",
              image: "https://images.unsplash.com/photo-1510511459019-5dda7724fd87?w=900&h=600&fit=crop" }
        ];
        var SITE = { title: "Insights and Ideas", tagline: "Design, development and product thinking.", url: "/Blogs" };
        var CATEGORIES = [
            { name: "Design", url: "/Blogs?category=Design" },
            { name: "Development", url: "/Blogs?category=Development" },
            { name: "Security", url: "/Blogs?category=Security" }
        ];
        var HOME = {
            site: SITE, heading: "Popular this week", search: "", total: 24,
            breaking: { text: "Reader analytics ship this week", url: "/Blogs?slug=dnn-and-oqtane" },
            featured: POSTS[0], posts: POSTS, categories: CATEGORIES,
            pager: { page: 1, pages: 3, hasPrev: false, hasNext: true, prevUrl: "/Blogs", nextUrl: "/Blogs?page=2" }
        };
        var ARTICLE = {
            site: SITE,
            post: Object.assign({}, POSTS[1], {
                body: "<p>Two platforms, one team, and a migration that does not have to be a rewrite.</p>" +
                      "<h2 id=\"s1\">Where DNN still wins</h2><p>Modules, skins and fifteen years of content.</p>" +
                      "<h2 id=\"s2\">Where Oqtane wins</h2><p>A modern runtime and a much smaller install.</p>"
            }),
            toc: [ { id: "s1", text: "Where DNN still wins" }, { id: "s2", text: "Where Oqtane wins" } ],
            related: [ POSTS[0], POSTS[2] ],
            tags: [ { name: "DNN", url: "/Blogs?tag=DNN" }, { name: "Oqtane", url: "/Blogs?tag=Oqtane" } ],
            comments: [
                { name: "Priya Nair", date: "2 hours ago", body: "The migration section matches what we saw." },
                { name: "Amy Zhang", date: "yesterday", body: "Would like a follow-up on theming." }
            ]
        };
        var MOCK = {
            "blog-home": HOME,
            "blog-archive": { site: SITE, heading: "Archive", total: 24, posts: POSTS, categories: CATEGORIES,
                              pager: HOME.pager },
            "blog-post": ARTICLE,
            "news-home": HOME,
            "news-article": ARTICLE
        };

        function currentData() {
            var group = groupBox ? groupBox.value : "blog-home";
            return { group: group, data: MOCK[group] || {} };
        }

        // ---- interpreter --------------------------------------------------------------------
        function esc(value) {
            return String(value === null || value === undefined ? "" : value)
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        // Resolve "a.b.c" against the current scope, then the root — so a field inside {{#each}}
        // wins, and anything outside the loop is still reachable.
        function resolve(path, scope, root) {
            path = String(path || "").trim();
            if (path === "." || path === "this") { return scope; }
            var from = [scope, root], i, j, value, parts;
            for (i = 0; i < from.length; i++) {
                value = from[i];
                if (value === null || value === undefined) { continue; }
                parts = path.split(".");
                for (j = 0; j < parts.length; j++) {
                    if (value === null || value === undefined) { break; }
                    value = value[parts[j]];
                }
                if (value !== undefined) { return value; }
            }
            return undefined;
        }

        function truthy(value) {
            if (Array.isArray(value)) { return value.length > 0; }
            return !!value;
        }

        // Finds the {{/name}} that closes the block opened at `from`, counting nested opens.
        function findClose(tokens, from, name) {
            var depth = 1, i;
            for (i = from + 1; i < tokens.length; i++) {
                var t = tokens[i];
                if (t.type === "open" && t.name === name) { depth++; }
                else if (t.type === "close" && t.name === name) { depth--; if (depth === 0) { return i; } }
            }
            return -1;
        }

        function tokenize(source) {
            // {{{raw}}} first, or the double-stache pattern would eat its braces.
            var tokens = [], re = /\{\{\{\s*([^}]+?)\s*\}\}\}|\{\{\s*([#\/]?)([^}]+?)\s*\}\}/g, last = 0, m;
            while ((m = re.exec(source)) !== null) {
                if (m.index > last) { tokens.push({ type: "text", value: source.slice(last, m.index) }); }
                if (m[1] !== undefined) {
                    tokens.push({ type: "raw", name: m[1].trim() });
                    last = re.lastIndex;
                    continue;
                }
                var marker = m[2], body = m[3].trim();
                if (marker === "#") {
                    var space = body.indexOf(" ");
                    tokens.push({ type: "open", name: space < 0 ? body : body.slice(0, space),
                                  arg: space < 0 ? "" : body.slice(space + 1).trim() });
                } else if (marker === "/") {
                    tokens.push({ type: "close", name: body });
                } else if (body === "else") {
                    tokens.push({ type: "else" });
                } else {
                    tokens.push({ type: "var", name: body });
                }
                last = re.lastIndex;
            }
            if (last < source.length) { tokens.push({ type: "text", value: source.slice(last) }); }
            return tokens;
        }

        function render(tokens, scope, root, errors) {
            var out = "", i = 0;
            while (i < tokens.length) {
                var t = tokens[i];
                if (t.type === "text") { out += t.value; i++; continue; }
                if (t.type === "var") {
                    var value = resolve(t.name, scope, root);
                    if (value === undefined) { errors.push(t.name); }
                    out += esc(value);
                    i++; continue;
                }
                if (t.type === "raw") {
                    var rawValue = resolve(t.name, scope, root);
                    if (rawValue === undefined) { errors.push(t.name); }
                    out += (rawValue === null || rawValue === undefined) ? "" : String(rawValue);
                    i++; continue;
                }
                if (t.type === "open") {
                    var end = findClose(tokens, i, t.name);
                    if (end < 0) { errors.push("unclosed {{#" + t.name + "}}"); return out; }
                    var inner = tokens.slice(i + 1, end);
                    var target = resolve(t.arg, scope, root);
                    // {{else}} splits BOTH helpers: an empty list renders the else branch, the
                    // way Handlebars does it, so a template never has to guard a loop with an if.
                    var elseAt = -1, d = 0, x;
                    for (x = 0; x < inner.length; x++) {
                        if (inner[x].type === "open") { d++; }
                        else if (inner[x].type === "close") { d--; }
                        else if (inner[x].type === "else" && d === 0) { elseAt = x; break; }
                    }
                    var yes = elseAt < 0 ? inner : inner.slice(0, elseAt);
                    var no = elseAt < 0 ? [] : inner.slice(elseAt + 1);

                    if (t.name === "each") {
                        if (Array.isArray(target) && target.length) {
                            for (var k = 0; k < target.length; k++) { out += render(yes, target[k], root, errors); }
                        } else if (!Array.isArray(target) && target !== undefined && target !== null) {
                            out += render(yes, target, root, errors);
                        } else {
                            out += render(no, scope, root, errors);
                        }
                    } else if (t.name === "if") {
                        out += render(truthy(target) ? yes : no, scope, root, errors);
                    } else {
                        errors.push("unknown helper {{#" + t.name + "}}");
                    }
                    i = end + 1; continue;
                }
                i++;   // stray {{else}} or {{/x}}
            }
            return out;
        }

        // ---- highlighter ---------------------------------------------------------------------
        function highlight(source) {
            var html = esc(source);
            html = html.replace(/\{\{\{?[^}]*\}?\}\}/g, function (token) {
                var kind = /\{\{\s*[#\/]/.test(token) ? "blk" : "var";
                return '<span class="tpl-' + kind + '">' + token + "</span>";
            });
            html = html.replace(/(&lt;\/?[a-zA-Z][^&]*?&gt;)/g, '<span class="tpl-tag">$1</span>');
            return html + "\n";
        }

        // The thumbnails on the list page render with this very interpreter - one implementation,
        // so a gallery card cannot look different from what the editor and the server produce.
        window.mfbaRenderTemplate = function (source, group) {
            var data = MOCK[group] || MOCK["blog-home"];
            try { return render(tokenize(source), data, data, []); }
            catch (e) { return ""; }
        };

        function paint() {
            var source = code.value;
            if (mirror) { mirror.innerHTML = highlight(source); }
            var context = currentData();
            var errors = [];
            var html;
            try { html = render(tokenize(source), context.data, context.data, errors); }
            catch (e) { html = ""; errors.push(String(e.message || e)); }
            preview.innerHTML = html;
            if (note) {
                var unique = errors.filter(function (v, i, a) { return a.indexOf(v) === i; });
                note.textContent = unique.length
                    ? "mock data has no " + unique.slice(0, 3).join(", ")
                    : "rendered against " + context.group + " mock data";
                note.className = unique.length ? "mfba-over" : "";
            }
            if (cheat) { cheat.innerHTML = cheatFor(context.data); }
        }

        // Reads the mock object and lists what a template can actually say — no hand-kept list to
        // drift out of date.
        function cheatFor(data) {
            var rows = [];
            function walk(prefix, value) {
                if (Array.isArray(value)) {
                    rows.push("{{#each " + prefix + "}}…{{/each}}");
                    if (value.length && typeof value[0] === "object") {
                        Object.keys(value[0]).forEach(function (k) { rows.push("&nbsp;&nbsp;{{" + k + "}} <em>inside each</em>"); });
                    }
                    return;
                }
                if (value && typeof value === "object") {
                    Object.keys(value).forEach(function (k) { walk(prefix ? prefix + "." + k : k, value[k]); });
                    return;
                }
                rows.push("{{" + prefix + "}}");
            }
            Object.keys(data).forEach(function (k) { walk(k, data[k]); });
            return "<code>" + rows.join("</code><code>") + "</code>";
        }

        if (!code || !preview) { return; }   // list page: the interpreter is exposed, the editor is not here

        code.addEventListener("input", paint);
        // Download the open template as the .json this screen can import back.
        var download = document.getElementById("mfba-download");
        if (download) {
            download.addEventListener("click", function (e) {
                e.preventDefault();
                mfbaSaveFile(
                    (document.getElementsByName("template_name")[0] || {}).value || "template",
                    (groupBox || {}).value || "blog-home",
                    code.value,
                    (document.getElementsByName("notes")[0] || {}).value || "");
            });
        }
        if (/[?&]download=1/.test(window.location.search)) {
            window.setTimeout(function () {
                mfbaSaveFile(
                    (document.getElementsByName("template_name")[0] || {}).value || "template",
                    (groupBox || {}).value || "blog-home",
                    code.value,
                    (document.getElementsByName("notes")[0] || {}).value || "");
            }, 400);
        }
        code.addEventListener("scroll", function () {
            if (!mirror) { return; }
            mirror.scrollTop = code.scrollTop;
            mirror.scrollLeft = code.scrollLeft;
        });
        if (groupBox) { groupBox.addEventListener("change", paint); }
        // Tab should indent, not jump out of the editor.
        code.addEventListener("keydown", function (e) {
            if (e.key !== "Tab") { return; }
            e.preventDefault();
            var start = code.selectionStart, end = code.selectionEnd;
            code.value = code.value.slice(0, start) + "  " + code.value.slice(end);
            code.selectionStart = code.selectionEnd = start + 2;
            paint();
        });
        paint();
    })();

    // ---- download: a Blob, not a server round trip -----------------------------------------
    function mfbaSaveFile(name, group, body, notes) {
        var payload = JSON.stringify({
            megaformBlogsTemplate: 1,
            template_name: name,
            template_group: group,
            notes: notes,
            template_body: body
        }, null, 2);
        var slug = String(name).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "template";
        var url = URL.createObjectURL(new Blob([payload], { type: "application/json" }));
        var link = document.createElement("a");
        link.href = url;
        link.download = slug + ".json";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        window.setTimeout(function () { URL.revokeObjectURL(url); }, 2000);
    }

    // ---- import: the browser reads the file, the server only sees a string --------------------
    (function () {
        "use strict";
        var picker = document.getElementById("mfba-import-file");
        if (!picker) { return; }
        var body = document.getElementById("mfba-import-body");
        var nameField = document.getElementById("mfba-import-name");
        var groupField = document.getElementById("mfba-import-group-value");
        var groupBox = document.getElementById("mfba-import-group");
        var button = document.getElementById("mfba-import-go");
        var note = document.getElementById("mfba-import-note");

        if (groupBox) {
            groupBox.addEventListener("change", function () { groupField.value = groupBox.value; });
        }
        picker.addEventListener("change", function () {
            var file = picker.files && picker.files[0];
            if (!file) { return; }
            if (file.size > 200000) {
                note.textContent = "That file is larger than 200 KB.";
                button.disabled = true;
                return;
            }
            var reader = new FileReader();
            reader.onload = function () {
                body.value = String(reader.result || "");
                nameField.value = file.name.replace(/\.[a-z0-9]+$/i, "");
                groupField.value = groupBox ? groupBox.value : "blog-home";
                button.disabled = body.value.trim().length === 0;
                note.textContent = file.name + " \u2014 " + Math.round(file.size / 102.4) / 10 + " KB read. Press Import.";
            };
            reader.onerror = function () { note.textContent = "That file could not be read."; };
            reader.readAsText(file);
        });
    })();

    // ---- gallery thumbnails: the same interpreter, scaled down --------------------------------
    (function () {
        "use strict";
        var shots = document.querySelectorAll(".mfba-gal-shot");
        if (!shots.length || typeof mfbaRenderTemplate !== "function") { return; }
        for (var i = 0; i < shots.length; i++) {
            (function (shot) {
                var file = shot.getAttribute("data-file");
                fetch("/DesktopModules/MegaFormBlogs/Assets/Templates/" + file, { credentials: "same-origin" })
                    .then(function (r) { return r.ok ? r.text() : null; })
                    .then(function (text) {
                        if (!text) { shot.classList.add("empty"); return; }
                        var group = /post\.html$/.test(file) || /article/.test(file) ? "blog-post" : "blog-home";
                        var inner = document.createElement("div");
                        inner.className = "mfba-gal-page";
                        inner.innerHTML = mfbaRenderTemplate(text, group);
                        shot.appendChild(inner);
                    })
                    .catch(function () { shot.classList.add("empty"); });
            })(shots[i]);
        }
    })();
    </script>
}
