                                            }
                                            <button class="mfba-iconbtn stop" type="submit" name="mfb_tpl_action" value="delete" title="Delete"
                                                    onclick="document.getElementsByName('tpl_id')[0].value='@template.SubmissionId';">@Icon("trash", "mfba-icon mfba-icon-md")</button>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </section>
            }
        }
    }
</div>

@if (allowed && templatesFormId > 0 && (editing != null || creating))
{
    <script>
    // ---------------------------------------------------------------------------------------
    // Template editor: a Handlebars-LIKE interpreter, a mirror highlighter and a live preview.
    //
    // "Like", not "compatible": it understands {{var}}, {{a.b}}, {{#each list}}…{{/each}} and
    // {{#if value}}…{{else}}…{{/if}}, and nothing else. That is exactly the subset the templates
    // are written in, and a small honest parser beats pulling a 20 KB library into a DNN page.
    // Values are HTML-escaped when substituted; the TEMPLATE's own markup is not, because
    // producing markup is the whole point of a template.
    // ---------------------------------------------------------------------------------------
    (function () {
        "use strict";
        var code = document.getElementById("mfba-code");
        var mirror = document.getElementById("mfba-code-hl");
        var preview = document.getElementById("mfba-preview");
        var note = document.getElementById("mfba-preview-note");
        var cheat = document.getElementById("mfba-cheat-body");
        var groupBox = document.getElementById("mfba-tpl-group");
        if (!code || !preview) { return; }

        // ---- mock data per render target ---------------------------------------------------
        var POSTS = [
            { title: "The Future of Design Systems", excerpt: "Why tokens outlive components.", category: "Design",
              author: "Sarah Chen", date: "Jul 29, 2026", reads: 1420, url: "/Blogs?slug=future-of-design-systems",
              image: "https://images.unsplash.com/photo-1561070791-2526d30994b5?w=600&h=400&fit=crop" },
            { title: "DNN and Oqtane", excerpt: "A practical comparison of the two platforms.", category: "Development",
              author: "DNN Defender Team", date: "Jul 29, 2026", reads: 980, url: "/Blogs?slug=dnn-and-oqtane",
              image: "https://images.unsplash.com/photo-1518770660439-4636190af475?w=600&h=400&fit=crop" },
            { title: "Why Bots Target Forms", excerpt: "What a form endpoint looks like to a crawler.", category: "Security",
              author: "SuperUser Account", date: "Feb 12, 2026", reads: 640, url: "/Blogs?slug=why-bots-target-forms",
              image: "https://images.unsplash.com/photo-1510511459019-5dda7724fd87?w=600&h=400&fit=crop" }
        ];
        var MOCK = {
            "blog-home": {
                site: { title: "Insights and Ideas", tagline: "Design, development and product thinking." },
                featured: POSTS[0], posts: POSTS
            },
            "blog-archive": { total: POSTS.length, posts: POSTS },
            "blog-post": {
                post: {
                    title: POSTS[1].title, excerpt: POSTS[1].excerpt, category: POSTS[1].category,
                    author: POSTS[1].author, authorAvatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=80&h=80&fit=crop",
                    date: POSTS[1].date, readingTime: 5, image: POSTS[1].image,
                    body: "Two platforms, one team, and a migration that does not have to be a rewrite."
                },
                toc: [ { id: "s1", text: "Where DNN still wins" }, { id: "s2", text: "Where Oqtane wins" } ],
                related: [ POSTS[0], POSTS[2] ]
            },
            "news-home": {
                breaking: { title: "Platform update ships ahead of schedule" },
                topStories: [
                    { section: "Technology", title: "Reader analytics land in the blog module", author: "Priya Nair", time: "12 minutes ago", url: "#" },
                    { section: "Product", title: "Comment moderation gets bulk actions", author: "Amy Zhang", time: "1 hour ago", url: "#" }
                ]
            },
            "news-article": {
                article: { section: "Technology", title: "Reader analytics land in the blog module",
                           author: "Priya Nair", time: "12 minutes ago", isLive: true, updated: "just now",
                           body: "Counters are written by a scheduled rollup every five minutes." },
                stats: [ { label: "Reads", value: 1420 }, { label: "Comments", value: 12 } ]
            }
        };

        function currentData() {
            var group = groupBox ? groupBox.value : "blog-home";
            return { group: group, data: MOCK[group] || {} };
        }

        // ---- interpreter --------------------------------------------------------------------
        function esc(value) {
            return String(value === null || value === undefined ? "" : value)
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        // Resolve "a.b.c" against the current scope, then the root — so a field inside {{#each}}
        // wins, and anything outside the loop is still reachable.
        function resolve(path, scope, root) {
            path = String(path || "").trim();
            if (path === "." || path === "this") { return scope; }
            var from = [scope, root], i, j, value, parts;
            for (i = 0; i < from.length; i++) {
                value = from[i];
                if (value === null || value === undefined) { continue; }
                parts = path.split(".");
                for (j = 0; j < parts.length; j++) {
                    if (value === null || value === undefined) { break; }
                    value = value[parts[j]];
                }
                if (value !== undefined) { return value; }
            }
            return undefined;
        }

        function truthy(value) {
            if (Array.isArray(value)) { return value.length > 0; }
            return !!value;
        }

        // Finds the {{/name}} that closes the block opened at `from`, counting nested opens.
        function findClose(tokens, from, name) {
            var depth = 1, i;
            for (i = from + 1; i < tokens.length; i++) {
                var t = tokens[i];
                if (t.type === "open" && t.name === name) { depth++; }
                else if (t.type === "close" && t.name === name) { depth--; if (depth === 0) { return i; } }
            }
            return -1;
        }

        function tokenize(source) {
            var tokens = [], re = /\{\{\s*([#\/]?)([^}]+?)\s*\}\}/g, last = 0, m;
            while ((m = re.exec(source)) !== null) {
                if (m.index > last) { tokens.push({ type: "text", value: source.slice(last, m.index) }); }
                var marker = m[1], body = m[2].trim();
                if (marker === "#") {
                    var space = body.indexOf(" ");
                    tokens.push({ type: "open", name: space < 0 ? body : body.slice(0, space),
                                  arg: space < 0 ? "" : body.slice(space + 1).trim() });
                } else if (marker === "/") {
                    tokens.push({ type: "close", name: body });
                } else if (body === "else") {
                    tokens.push({ type: "else" });
                } else {
                    tokens.push({ type: "var", name: body });
                }
                last = re.lastIndex;
            }
            if (last < source.length) { tokens.push({ type: "text", value: source.slice(last) }); }
            return tokens;
        }

        function render(tokens, scope, root, errors) {
            var out = "", i = 0;
            while (i < tokens.length) {
                var t = tokens[i];
                if (t.type === "text") { out += t.value; i++; continue; }
                if (t.type === "var") {
                    var value = resolve(t.name, scope, root);
                    if (value === undefined) { errors.push(t.name); }
                    out += esc(value);
                    i++; continue;
                }
                if (t.type === "open") {
                    var end = findClose(tokens, i, t.name);
                    if (end < 0) { errors.push("unclosed {{#" + t.name + "}}"); return out; }
                    var inner = tokens.slice(i + 1, end);
                    var target = resolve(t.arg, scope, root);
                    if (t.name === "each") {
                        if (Array.isArray(target)) {
                            for (var k = 0; k < target.length; k++) { out += render(inner, target[k], root, errors); }
                        } else if (target !== undefined && target !== null) {
                            out += render(inner, target, root, errors);
                        }
                    } else if (t.name === "if") {
                        var elseAt = -1, d = 0, x;
                        for (x = 0; x < inner.length; x++) {
                            if (inner[x].type === "open") { d++; }
                            else if (inner[x].type === "close") { d--; }
                            else if (inner[x].type === "else" && d === 0) { elseAt = x; break; }
                        }
                        var yes = elseAt < 0 ? inner : inner.slice(0, elseAt);
                        var no = elseAt < 0 ? [] : inner.slice(elseAt + 1);
                        out += render(truthy(target) ? yes : no, scope, root, errors);
                    } else {
                        errors.push("unknown helper {{#" + t.name + "}}");
                    }
                    i = end + 1; continue;
                }
                i++;   // stray {{else}} or {{/x}}
            }
            return out;
        }

        // ---- highlighter ---------------------------------------------------------------------
        function highlight(source) {
            var html = esc(source);
            html = html.replace(/\{\{[^}]*\}\}/g, function (token) {
                var kind = /\{\{\s*[#\/]/.test(token) ? "blk" : "var";
                return '<span class="tpl-' + kind + '">' + token + "</span>";
            });
            html = html.replace(/(&lt;\/?[a-zA-Z][^&]*?&gt;)/g, '<span class="tpl-tag">$1</span>');
            return html + "\n";
        }

        function paint() {
            var source = code.value;
            if (mirror) { mirror.innerHTML = highlight(source); }
            var context = currentData();
            var errors = [];
            var html;
            try { html = render(tokenize(source), context.data, context.data, errors); }
            catch (e) { html = ""; errors.push(String(e.message || e)); }
            preview.innerHTML = html;
            if (note) {
                var unique = errors.filter(function (v, i, a) { return a.indexOf(v) === i; });
                note.textContent = unique.length
                    ? "mock data has no " + unique.slice(0, 3).join(", ")
                    : "rendered against " + context.group + " mock data";
                note.className = unique.length ? "mfba-over" : "";
            }
            if (cheat) { cheat.innerHTML = cheatFor(context.data); }
        }

        // Reads the mock object and lists what a template can actually say — no hand-kept list to
        // drift out of date.
        function cheatFor(data) {
            var rows = [];
            function walk(prefix, value) {
                if (Array.isArray(value)) {
                    rows.push("{{#each " + prefix + "}}…{{/each}}");
                    if (value.length && typeof value[0] === "object") {
                        Object.keys(value[0]).forEach(function (k) { rows.push("&nbsp;&nbsp;{{" + k + "}} <em>inside each</em>"); });
                    }
                    return;
                }
                if (value && typeof value === "object") {
                    Object.keys(value).forEach(function (k) { walk(prefix ? prefix + "." + k : k, value[k]); });
                    return;
                }
                rows.push("{{" + prefix + "}}");
            }
            Object.keys(data).forEach(function (k) { walk(k, data[k]); });
            return "<code>" + rows.join("</code><code>") + "</code>";
        }

        code.addEventListener("input", paint);
        code.addEventListener("scroll", function () {
            if (!mirror) { return; }
            mirror.scrollTop = code.scrollTop;
            mirror.scrollLeft = code.scrollLeft;
        });
        if (groupBox) { groupBox.addEventListener("change", paint); }
        // Tab should indent, not jump out of the editor.
        code.addEventListener("keydown", function (e) {
            if (e.key !== "Tab") { return; }
            e.preventDefault();
            var start = code.selectionStart, end = code.selectionEnd;
            code.value = code.value.slice(0, start) + "  " + code.value.slice(end);
            code.selectionStart = code.selectionEnd = start + 2;
            paint();
        });
        paint();
    })();
    </script>
}
