@*
    MegaForm Blogs - template manager (screen 9).

    WHAT THIS IS, AND WHAT IT IS NOT. This is the workflow UI for authoring Handlebars-like
    templates: list them by render target, edit one with a live preview, mark one active. It does
    NOT change how the blog renders. /Blogs, the article page and every lens keep the fixed design
    they have today; a template becomes the renderer only when a future release wires one in, and
    the screen says so rather than implying the blog already obeys these files.

    STORAGE. Templates are records of a "Blog Templates" form, created on demand by the button on
    this screen. A DNN portal setting was the obvious alternative and is the wrong one: that column
    holds 2000 characters, which one template body would blow through immediately.

    CSHTML rules obeyed here (each cost a deploy on 2026-08-09): braces on every control-flow
    statement in the page block; `if` not `@if` in code context; no attribute mixing literal text
    with a quoted-argument expression; no local called `layout` (that is a Razor directive);
    no multi-line C# inside a markup-context loop.
*@
@inherits DotNetNuke.Web.Razor.DotNetNukeWebPage<dynamic>
@using System
@using System.Linq
@using System.Globalization
@using System.Collections.Generic
@using System.Security.Cryptography
@using System.Text.RegularExpressions
@using MegaForm.Sdk

@functions {
    /// The five render targets the owner asked for. The key is stored; the label is shown.
    static readonly List<KeyValuePair<string, string>> Groups = new List<KeyValuePair<string, string>>
    {
        new KeyValuePair<string, string>("blog-home", "Blog Home"),
        new KeyValuePair<string, string>("blog-archive", "Blog Archive"),
        new KeyValuePair<string, string>("blog-post", "Blog Post"),
        new KeyValuePair<string, string>("news-home", "News Home"),
        new KeyValuePair<string, string>("news-article", "News Article")
    };

    const string TemplatesFormTitle = "Blog Templates";

    /// Minimal schema: six typed fields, no layout, no validation beyond what the console does.
    /// Written as JSON because that is what IFormApi.CreateFormAsync takes.
    const string TemplatesSchemaJson = "{\"version\":1,\"fields\":[" +
        "{\"key\":\"template_uid\",\"type\":\"Text\",\"label\":\"Template UID\"}," +
        "{\"key\":\"template_name\",\"type\":\"Text\",\"label\":\"Name\",\"required\":true}," +
        "{\"key\":\"template_group\",\"type\":\"Text\",\"label\":\"Render target\"}," +
        "{\"key\":\"template_body\",\"type\":\"Textarea\",\"label\":\"Template body\"}," +
        "{\"key\":\"is_active\",\"type\":\"Text\",\"label\":\"Active\"}," +
        "{\"key\":\"notes\",\"type\":\"Textarea\",\"label\":\"Notes\"}]}";

    static T Run<T>(System.Func<IMegaFormClient, System.Threading.Tasks.Task<T>> action)
    {
        var initializeMegaForm = MegaForm.DNN.Services.DnnServiceLocator.Instance;
        return System.Threading.Tasks.Task.Run(() => MegaFormSdk.RunAsync(action)).GetAwaiter().GetResult();
    }

    static string Text(AppRecordDto record, string key, string fallback)
    {
        if (record == null || record.Data == null || !record.Data.ContainsKey(key) || record.Data[key] == null)
            return fallback;
        var value = Convert.ToString(record.Data[key]);
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    static bool IsActive(AppRecordDto record)
    {
        return string.Equals(Text(record, "is_active", "false"), "true", StringComparison.OrdinalIgnoreCase);
    }

    static string GroupLabel(string key)
    {
        var hit = Groups.FirstOrDefault(g => string.Equals(g.Key, key, StringComparison.OrdinalIgnoreCase));
        return string.IsNullOrWhiteSpace(hit.Value) ? "Unassigned" : hit.Value;
    }

    /// The switch that decides whether an active template actually renders the blog. It lives in
    /// Settings; this screen only reports it, because a screen that lies about what is live is
    /// worse than one that says nothing.
    static bool TemplatesRenderOn(int portalId)
    {
        var value = DotNetNuke.Entities.Portals.PortalController.GetPortalSetting(
            "MegaFormBlogs_TemplatesRender", portalId, "false");
        return string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);
    }

    static bool CanManage(DotNetNuke.Entities.Users.UserInfo user)
    {
        if (user == null || user.UserID < 0) return false;
        if (user.IsSuperUser) return true;
        var allowed = new[] { "Administrators", "Blog Publishers" };
        return user.Roles != null && user.Roles.Any(role => allowed.Contains(role, StringComparer.OrdinalIgnoreCase));
    }

    static string EnsureCsrfToken()
    {
        const string key = "MegaFormBlogs.CsrfToken";
        var session = System.Web.HttpContext.Current.Session;
        var token = session[key] as string;
        if (!string.IsNullOrWhiteSpace(token)) return token;
        var bytes = new byte[32];
        using (var random = RandomNumberGenerator.Create()) { random.GetBytes(bytes); }
        token = Convert.ToBase64String(bytes);
        session[key] = token;
        return token;
    }

    static void ValidateCsrfToken(string posted)
    {
        const string key = "MegaFormBlogs.CsrfToken";
        var expected = System.Web.HttpContext.Current.Session[key] as string;
        var valid = !string.IsNullOrWhiteSpace(expected) && !string.IsNullOrWhiteSpace(posted) && expected.Length == posted.Length;
        var difference = valid ? 0 : 1;
        var length = valid ? expected.Length : 0;
        for (var index = 0; index < length; index++) { difference |= expected[index] ^ posted[index]; }
        if (difference != 0)
        {
            throw new InvalidOperationException("The session expired. Reload this page and try again.");
        }
    }

    /// Finds the templates form by its schema fingerprint, the same way every other child form in
    /// this module is resolved. Returns 0 when it has not been created yet.
    static int ResolveTemplatesFormId(MegaFormScope scope)
    {
        var items = System.Web.HttpContext.Current == null ? null : System.Web.HttpContext.Current.Items;
        const string cacheKey = "MegaFormBlogs.TemplatesFormId";
        if (items != null && items.Contains(cacheKey)) { return (int)items[cacheKey]; }

        var resolved = Run(async c =>
        {
            var forms = await c.Forms.ListFormsAsync(new FormQuery { Page = 1, PageSize = 200 }, scope);
            if (forms == null || forms.Items == null) { return 0; }
            var ordered = forms.Items
                .OrderByDescending(f => (f.Title ?? "").IndexOf("template", StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
            foreach (var form in ordered)
            {
                var candidate = form;
                if (string.IsNullOrWhiteSpace(candidate.SchemaJson))
                {
                    candidate = await c.Forms.GetFormAsync(form.FormId, scope) ?? form;
                }
                if (string.IsNullOrWhiteSpace(candidate.SchemaJson)) { continue; }
                var keys = c.Schema.ParseForm(candidate).Fields.Select(x => x.Key ?? "").ToList();
                if (keys.Contains("template_body", StringComparer.OrdinalIgnoreCase)
                    && keys.Contains("template_group", StringComparer.OrdinalIgnoreCase))
                {
                    return candidate.FormId;
                }
            }
            return 0;
        });

        if (items != null) { items[cacheKey] = resolved; }
        return resolved;
    }

