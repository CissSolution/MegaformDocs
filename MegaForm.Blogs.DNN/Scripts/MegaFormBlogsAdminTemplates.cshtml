                            <div class="mfba-tpl-grid">
                                @foreach (var template in inGroup)
                                {
                                    var body = Text(template, "template_body", "");
                                    var snippet = body.Length > 220 ? body.Substring(0, 220) + "…" : body;
                                    var editUrl = templatesUrl + "&edit=" + template.SubmissionId;
                                    <article class="mfba-tpl-card">
                                        <header>
                                            <strong class="mfba-clamp1">@Text(template, "template_name", "Untitled")</strong>
                                            @if (IsActive(template))
                                            {
                                                <span class="mfba-pill mfba-st-published">Active</span>
                                            }
                                        </header>
                                        <pre class="mfba-tpl-snippet">@snippet</pre>
                                        <small>@Text(template, "notes", "No notes") · updated @template.SubmittedOnUtc.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</small>
                                        <div class="mfba-tpl-acts">
                                            <a class="mfba-iconbtn" title="Edit" href="@editUrl">@Icon("pencil", "mfba-icon mfba-icon-md")</a>
                                            <a class="mfba-iconbtn" title="Preview" href="@(editUrl + "#mfba-preview")">@Icon("eye", "mfba-icon mfba-icon-md")</a>
