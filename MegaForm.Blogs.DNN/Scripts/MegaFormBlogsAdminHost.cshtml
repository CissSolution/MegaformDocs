@*
    MegaForm Blogs - Host-only wrapper and screen router.
    The SuperUser check is deliberately independent of DNN page permissions: DNN keeps a
    built-in Administrator grant on admin pages, and a non-Host Administrator must not be
    able to run the editorial console. Do not remove it.
    `view` is matched against a fixed whitelist so the query string can never choose an
    arbitrary script path.
*@
@inherits DotNetNuke.Web.Razor.DotNetNukeWebPage<dynamic>
@using DotNetNuke.Entities.Users
@{
    var currentUser = UserController.Instance.GetCurrentUserInfo();
    var hostAllowed = currentUser != null && currentUser.IsSuperUser;
    if (!hostAllowed) {
        Response.StatusCode = 403;
    }

    var requestedView = (Request.QueryString["view"] ?? "").Trim().ToLowerInvariant();
    var screen = "MegaFormBlogsAdmin.cshtml";
    if (requestedView == "editorial") { screen = "MegaFormBlogsAdminEditorial.cshtml"; }
    else if (requestedView == "comments") { screen = "MegaFormBlogsAdminComments.cshtml"; }
}
@if (!hostAllowed)
{
    <section class="mfb-shell">
        <div class="mfb-notice">
            <h1>Host access required</h1>
            <p>This Blog administration page is restricted to DNN SuperUsers.</p>
        </div>
    </section>
}
else
{
    @RenderPage("~/DesktopModules/RazorModules/RazorHost/Scripts/" + screen)
}
