<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>MegaForm.Web</RootNamespace>
    <AssemblyName>MegaForm.Web</AssemblyName>
    <Version>1.7.3</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>MegaForm.Web</PackageId>
    <Authors>MegaForm Team</Authors>
    <Company>MegaForm</Company>
    <Copyright>© 2026 MegaForm. All rights reserved.</Copyright>
    <Description>ASP.NET Core web host implementation for MegaForm: REST API, admin UI shell, database layer, and public form rendering.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://megaform.github.io/MegaFormSolution</PackageProjectUrl>
    <RepositoryUrl>https://github.com/megaform/MegaFormSolution.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>megaform;forms;aspnetcore;mvc;workflow;admin;submissions</PackageTags>
    <PackageReleaseNotes>MegaForm.Web 1.7.3: REST API surface, admin/dashboard UI shell, public form host, EF Core data layer, and schema migration runner.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Expose wwwroot as static web assets and serve them at the site root
         so consumers see /megaform/css/* instead of /_content/MegaForm.Web/* -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\MegaForm.Core\MegaForm.Core.csproj" />
    <ProjectReference Include="..\MegaForm.Sdk\MegaForm.Sdk.csproj" />
    <!-- [CloudStorage v20260723-01] AmazonS3/AzureBlob IStorageProvider implementations
         (parameterless ctors, namespace MegaForm.Integrations.CloudStorage). -->
    <ProjectReference Include="..\MegaForm.Integrations.CloudStorage\MegaForm.Integrations.CloudStorage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- EF Core — net8.0 compatible -->
    <PackageReference Include="Microsoft.EntityFrameworkCore"                    Version="9.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer"          Version="9.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"             Version="9.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"            Version="9.0.3" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql"               Version="9.0.0" />
    <!-- ADO.NET providers for DatabaseNodeExecutor -->
    <PackageReference Include="Microsoft.Data.SqlClient"                         Version="5.2.2" />
    <PackageReference Include="Microsoft.Data.Sqlite"                            Version="9.0.3" />
    <PackageReference Include="Npgsql"                                           Version="9.0.3" />
    <PackageReference Include="MySql.Data"                                        Version="9.1.0" />
    <!-- JWT Auth — net8.0 compatible -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"   Version="9.0.3" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens"                  Version="8.4.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens"           Version="8.4.0" />
    <!-- Razor widget runtime compilation -->
    <PackageReference Include="Microsoft.AspNetCore.Razor.Language"             Version="6.0.36" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"                   Version="4.10.0" />
    <!-- JSON + Swagger — net8.0 compatible -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson"         Version="9.0.3" />
    <PackageReference Include="Newtonsoft.Json"                                  Version="13.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore"                           Version="7.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Program.cs" />
    <EmbeddedResource Include="..\MegaForm.Core\Seed\ai-knowledge-seed.json" LogicalName="MegaForm.Web.Seed.ai-knowledge-seed.json" />
    <Content Include="license.lic" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- [CloudReady A4 v20260807] Versioned schema scripts for SchemaMigrationRunner.
         EmbeddedResource is what makes them reach NuGet consumers: as Content alone they
         pack into contentFiles WITHOUT copyToOutput (NuGet does not translate
         CopyToOutputDirectory into it), so MegaForm.Web.Host never received a single .sql
         and the runner silently logged "no scripts folder, skipped". Content is kept as
         well so an operator can still drop a hotfix script on disk — the runner reads both
         and disk wins per version. -->
    <EmbeddedResource Include="Data\Schema\Scripts\**\*.sql" />
    <Content Include="Data\Schema\Scripts\**\*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
